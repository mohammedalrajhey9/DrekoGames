  const resetGameForm = () => {
    setEditingGameId(null)
    setNewGame({
      title: '',
      image: '',
      genre: 'Action',
      price: 'FREE',
      description: '',
      status: 'New',
      downloadUrl: '',
      fileName: 'game.zip',
      size: '0 MB',
