  const pageTitles: Record<PageKey, string> = localeText.pageTitles
  const [newGame, setNewGame] = useState({
    title: '',
    image: '',
    genre: 'Action',
    price: 'FREE',
    description: '',
    status: 'New' as Game['status'],
    downloadUrl: '',
