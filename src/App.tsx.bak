const toDisplayName = (email: string) => email.split('@')[0].replace(/[._-]/g, ' ')

const resolveAvatarUrl = (...values: Array<string | null | undefined>) => values.find((value) => typeof value === 'string' && value.trim().length > 0) || ''

const FRIEND_CODE_ALPHABET = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'

const generateFriendCode = () => Array.from({ length: 10 }, () => FRIEND_CODE_ALPHABET[Math.floor(Math.random() * FRIEND_CODE_ALPHABET.length)]).join('')

const findUserByFriendCode = async (friendCode: string) => {
  const cleaned = friendCode.trim().toUpperCase()
  if (!cleaned || !/^[A-Z0-9]{10}$/.test(cleaned)) {
    return null
  }

  const usersSnap = await getDocs(collection(db, 'users'))
  const match = usersSnap.docs.find((docSnap) => (docSnap.data()?.friendCode || '').toString().toUpperCase() === cleaned)

  if (!match) {
    return null
  }

  const data = match.data() as any
  return { uid: match.id, ...data }
}

const ensureUniqueFriendCode = async (uid: string) => {
  let nextCode = generateFriendCode()
  const usersSnap = await getDocs(collection(db, 'users'))

  while (usersSnap.docs.some((docSnap) => docSnap.id !== uid && (docSnap.data()?.friendCode || '').toString().toUpperCase() === nextCode)) {
    nextCode = generateFriendCode()
  }

  return nextCode
}

const readFileAsDataUrl = async (file: File, maxWidth = 1400, maxHeight = 1400) => {
  if (!file.type.startsWith('image/')) {
    throw new Error('Only image files are allowed.')
  }

  const dataUrl = await new Promise<string>((resolve, reject) => {
    const reader = new FileReader()
    reader.onload = () => resolve(String(reader.result ?? ''))
    reader.onerror = () => reject(new Error('Unable to read file.'))
    reader.readAsDataURL(file)
  })

  if (dataUrl.length < 200000) {
    return dataUrl
  }

  return await new Promise<string>((resolve, reject) => {
    const image = new Image()
    image.onload = () => {
      const canvas = document.createElement('canvas')
      const scale = Math.min(1, maxWidth / image.width, maxHeight / image.height)
      canvas.width = Math.max(1, Math.round(image.width * scale))
      canvas.height = Math.max(1, Math.round(image.height * scale))

      const context = canvas.getContext('2d')
      if (!context) {
        resolve(dataUrl)
        return
      }

      context.drawImage(image, 0, 0, canvas.width, canvas.height)
      resolve(canvas.toDataURL('image/jpeg', 0.72))
    }
    image.onerror = () => reject(new Error('Unable to process image.'))
    image.src = dataUrl
  })
}

const readImageDimensions = async (dataUrl: string) => {
  if (!dataUrl) {
    return { width: 1920, height: 1080 }
  }

  return await new Promise<{ width: number; height: number }>((resolve, reject) => {
    const image = new Image()
    image.onload = () => resolve({ width: image.naturalWidth || image.width || 1920, height: image.naturalHeight || image.height || 1080 })
    image.onerror = () => reject(new Error('Unable to read image dimensions.'))
    image.src = dataUrl
  })
}

const formatBytes = (bytes: number) => {
  if (!Number.isFinite(bytes) || bytes <= 0) {
    return '0 MB'
  }

  const units = ['B', 'KB', 'MB', 'GB']
  let value = bytes
  let unitIndex = 0

  while (value >= 1024 && unitIndex < units.length - 1) {
    value /= 1024
    unitIndex += 1
  }

  return `${value.toFixed(value >= 10 || unitIndex === 0 ? 0 : 1)} ${units[unitIndex]}`
}

const formatDuration = (seconds: number) => {
  if (!Number.isFinite(seconds) || seconds <= 0) {
    return 'Calculating...'
  }

  const totalSeconds = Math.max(0, Math.round(seconds))
  const minutes = Math.floor(totalSeconds / 60)
  const hours = Math.floor(minutes / 60)
  const remainingMinutes = minutes % 60
  const remainingSeconds = totalSeconds % 60

  if (hours > 0) {
    return `${hours}h ${remainingMinutes}m`
  }

  if (minutes > 0) {
    return `${minutes}m ${remainingSeconds}s`
  }

  return `${remainingSeconds}s`
}

const getLocalizedPresenceLabel = (status: string | null | undefined, language: 'en' | 'ar') => {
  const normalized = String(status || '').toLowerCase()
  if (normalized === 'online' || normalized === 'متصل') {
    return language === 'ar' ? 'متصل' : 'Online'
  }
  return language === 'ar' ? 'غير متصل' : 'Offline'
}

const normalizeHiddenFlag = (value: unknown) => {
  if (typeof value === 'boolean') {
    return value
  }

  if (typeof value === 'string') {
    return value.toLowerCase() === 'true' || value === '1'
  }

  return value === 1 || value === '1'
}

const normalizeGameRecord = (game: Partial<Game> & Record<string, any>): Game => ({
  ...(game as Partial<Game>),
  id: String(game.id ?? ''),
  title: String(game.title ?? ''),
  image: String(game.image ?? ''),
  genre: String(game.genre ?? 'Action'),
  price: String(game.price ?? 'FREE'),
  description: String(game.description ?? 'New game added from the admin panel.'),
  status: (game.status as Game['status']) ?? 'New',
  downloadUrl: String(game.downloadUrl ?? ''),
  fileName: String(game.fileName ?? 'game.zip'),
  size: String(game.size ?? '0 MB'),
  version: String(game.version ?? '1.0.0'),
  platform: String(game.platform ?? 'Windows'),
  screenshots: Array.isArray(game.screenshots) ? game.screenshots.map((item) => String(item ?? '')) : [String(game.image ?? '')],
  trailerUrl: String(game.trailerUrl ?? ''),
  developer: String(game.developer ?? 'Dreko Games'),
  publisher: String(game.publisher ?? 'Dreko Games'),
  releaseDate: String(game.releaseDate ?? new Date().toISOString().slice(0, 10)),
  requirements: {
    minimum: game.requirements?.minimum ?? '',
    recommended: game.requirements?.recommended ?? '',
  },
  hidden: normalizeHiddenFlag(game.hidden),
})

const getDownloadStatusLabel = (status: DownloadItem['status'], language: 'en' | 'ar' = 'en') => {
  switch (status) {
    case 'queued':
      return language === 'ar' ? 'في قائمة الانتظار' : 'Queued'
    case 'downloading':
      return language === 'ar' ? 'جارٍ التنزيل' : 'Downloading'
    case 'paused':
      return language === 'ar' ? 'موقوف مؤقتًا' : 'Paused'
    case 'completed':
      return language === 'ar' ? 'مكتمل' : 'Completed'
    case 'cancelled':
      return language === 'ar' ? 'ملغي' : 'Cancelled'
    case 'failed':
      return language === 'ar' ? 'فشل' : 'Failed'
    default:
      return language === 'ar' ? 'بانتظار' : 'Waiting'
  }
}

