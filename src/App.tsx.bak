  const [isElectron, setIsElectron] = useState(false)
  const [installFolder, setInstallFolder] = useState('C:\\DrekoGames')
  const [createShortcut, setCreateShortcut] = useState(true)
  const [launcherLanguage, setLauncherLanguage] = useState<'en' | 'ar'>('en')
  const [minimizeToTray, setMinimizeToTray] = useState(true)
  const [runOnStartup, setRunOnStartup] = useState(false)
  const [installModalGame, setInstallModalGame] = useState<Game | null>(null)

  // Submit Google OAuth client details collected from in-app modal
  const submitGoogleClientDetails = async (clientId: string, clientSecret: string, remember = true) => {
    try {
      setShowGoogleClientModal(false)
      setLoading(true)

      // Persist to Firestore so the app can reuse the credentials later
      try {
        await setDoc(doc(db, 'app_config', 'google_oauth'), {
          clientId,
          clientSecret,
          updatedAt: serverTimestamp(),
        })
      } catch (e) {
        // ignore Firestore write errors — still proceed to local storage fallback
      }

      if (remember) {
        try { window.localStorage.setItem('google-oauth-client-id', clientId) } catch {}
        try { window.localStorage.setItem('google-oauth-client-secret', clientSecret) } catch {}
      }

      if (isElectron && (window as any).electronAPI?.startGoogleOAuth) {
        try {
          const result = await (window as any).electronAPI.startGoogleOAuth({ clientId, clientSecret })
          if (!result || (!result.id_token && !result.access_token)) {
            setError('OAuth failed to return tokens.')
            setLoading(false)
            return
          }

          // Sign in to Firebase using the received tokens
          try {
            const credential = GoogleAuthProvider.credential(result.id_token || null, result.access_token || null)
            await signInWithCredential(auth, credential)
            setError('')
          } catch (err) {
            setError('Firebase sign-in failed after OAuth.')
          }
        } catch (err: any) {
          setError(String(err?.message || err))
        }
      } else {
        setError('Desktop Google OAuth is not available in this environment.')
      }
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    try {
      const storedLanguage = window.localStorage.getItem('launcher-language')
      if (storedLanguage === 'en' || storedLanguage === 'ar') {
        setLauncherLanguage(storedLanguage)
      }

      const storedMinimizeToTray = window.localStorage.getItem('launcher-minimize-to-tray')
      if (storedMinimizeToTray !== null) {
        setMinimizeToTray(storedMinimizeToTray === 'true')
      }

      const storedRunOnStartup = window.localStorage.getItem('launcher-run-on-startup')
      if (storedRunOnStartup !== null) {
        setRunOnStartup(storedRunOnStartup === 'true')
      }
    } catch {
      // ignore storage access issues in non-browser contexts
    }

    try {
      if (window.electronAPI?.getAppSettings) {
        void window.electronAPI.getAppSettings().then((settings) => {
          if (typeof settings?.minimizeToTray === 'boolean') {
            setMinimizeToTray(settings.minimizeToTray)
          }
          if (typeof settings?.runOnStartup === 'boolean') {
            setRunOnStartup(settings.runOnStartup)
          }
        }).catch(() => {
          // ignore main-process read errors; localStorage remains as fallback
        })
      }
    } catch {
      // ignore bridge access issues
    }
  }, [])

  useEffect(() => {
    try {
      window.localStorage.setItem('launcher-language', launcherLanguage)
    } catch {
      // ignore storage access issues in non-browser contexts
    }
  }, [launcherLanguage])

  useEffect(() => {
    try {
      window.localStorage.setItem('launcher-minimize-to-tray', String(minimizeToTray))
    } catch {
      // ignore storage access issues in non-browser contexts
    }

    if (!isElectron || !window.electronAPI?.setMinimizeToTray) {
      return
    }

    void window.electronAPI.setMinimizeToTray(minimizeToTray)
  }, [isElectron, minimizeToTray])

  useEffect(() => {
    try {
      window.localStorage.setItem('launcher-run-on-startup', String(runOnStartup))
    } catch {
      // ignore storage access issues in non-browser contexts
    }

    if (!isElectron || !window.electronAPI?.setRunOnStartup) {
      return
    }

    void window.electronAPI.setRunOnStartup(runOnStartup)
  }, [isElectron, runOnStartup])
