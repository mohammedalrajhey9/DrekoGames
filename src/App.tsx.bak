      releaseDate: '2026-09-13',
      minimumRequirements: '',
      recommendedRequirements: '',
      sendNotify: false,
    })
  }

  // Social handlers
  const handleSendFriendRequest = async (targetInput: string) => {
    if (!user) {
      setToastMessage('You must be signed in to send friend requests.')
      return
    }

    const trimmed = targetInput.trim()
    if (!trimmed || trimmed === user.uid) {
      return
    }

    try {
      let targetUid = trimmed
      if (/^[A-Z0-9]{10}$/i.test(trimmed)) {
        const match = await findUserByFriendCode(trimmed)
        if (!match) {
          setToastMessage('This friend code does not exist.')
          return
        }
        targetUid = match.uid
      }

      if (targetUid === user.uid) {
        setToastMessage('You cannot add yourself as a friend.')
        return
      }

      const targetProfile = await getUserProfile(targetUid)
      const existingOutgoing = pendingRequests.find((request) => request.from === user.uid && request.to === targetUid)
      if (existingOutgoing) {
        setToastMessage('Friend request already sent.')
        return
      }

      const result = await sendFriendRequest(user.uid, targetUid)
      if (!result) {
        setToastMessage('This friend request already exists or the user is not valid.')
        return
      }

      setPendingRequests((current) => [{
        id: result,
        from: user.uid,
        to: targetUid,
        fromName: profile?.displayName || user.email || 'You',
        toName: targetProfile?.displayName || 'User',
        avatarUrl: profile?.avatarUrl || '',
      }, ...current.filter((request) => !(request.from === user.uid && request.to === targetUid))])

      const notificationPayload = {
        id: result,
        type: 'friend_request' as const,
        title: 'Friend request',
        message: `${profile?.displayName || user.email || 'Someone'} wants to add you as a friend.`,
        read: false,
        friendUid: user.uid,
        friendName: profile?.displayName || user.email || 'You',
        avatarUrl: profile?.avatarUrl || '',
        imageUrl: '',
        createdAt: Date.now(),
        targetUid: targetUid,
      }

      try {
        console.log('[notifications] writing friend request notification', { recipient: targetUid, requestId: result })
        await setDoc(doc(db, `users/${targetUid}/notifications`, result), notificationPayload)
      } catch (notificationError) {
        console.warn('[notifications] direct friend-request write failed', notificationError)
        void pushNotification({
          type: 'friend_request',
          title: 'Friend request',
          message: `${profile?.displayName || user.email || 'Someone'} wants to add you as a friend.`,
          friendUid: user.uid,
          friendName: profile?.displayName || user.email || 'You',
          avatarUrl: profile?.avatarUrl || '',
          targetUid: targetUid,
        })
      }
      setCommunityTab('pending')
      setToastMessage('Friend request sent.')
    } catch (err) {
      console.error('sendFriendRequest failed', err)
      setToastMessage(err instanceof Error ? err.message : 'Failed to send friend request.')
    }
  }

  const cancelPendingFriendRequest = async (targetUid: string) => {
    if (!user) return

    try {
      const requestsSnap = await getDocs(collection(db, 'friendRequests'))
      const matching = requestsSnap.docs.filter((docSnap) => {
        const data = docSnap.data() as any
        return (data?.from === user.uid && data?.to === targetUid) || (data?.from === targetUid && data?.to === user.uid)
      })

      if (matching.length === 0) {
        setPendingRequests((current) => current.filter((request) => !(request.from === user.uid && request.to === targetUid)))
        return
      }

      await Promise.all(matching.map((docSnap) => deleteDoc(doc(db, 'friendRequests', docSnap.id))))
      setPendingRequests((current) => current.filter((request) => !(request.from === user.uid && request.to === targetUid)))
      setToastMessage('Friend request removed.')
    } catch (err) {
      console.error('cancel pending request error', err)
      setToastMessage('Unable to cancel request.')
    }
  }

  const handleAcceptRequest = async (requestId: string) => {
    try {
      const accepted = await acceptFriendRequest(requestId)
      if (!accepted) {
        setToastMessage('This request is no longer available.')
        return
      }
      setPendingRequests((current) => current.filter((request) => request.id !== requestId))
      setCommunityTab('friends')
      setToastMessage('Friend request accepted.')
    } catch (err) {
      console.error('accept request failed', err)
      setToastMessage('Unable to accept request.')
    }
  }

  const handleRejectRequest = async (requestId: string) => {
    try {
      const rejected = await rejectFriendRequest(requestId)
      if (!rejected) {
        setToastMessage('This request could not be rejected.')
        return
      }
      setPendingRequests((current) => current.filter((request) => request.id !== requestId))
      setCommunityTab('pending')
      setToastMessage('Friend request rejected.')
    } catch (err) {
      console.error('reject request failed', err)
      setToastMessage('Unable to reject request.')
    }
  }

  const isUserBlocked = (targetUid: string) => blockedUsers.some((entry) => entry.uid === targetUid)

  const clearFriendRequestsBetweenUsers = async (a: string, b: string) => {
    try {
      const requestsSnap = await getDocs(collection(db, 'friendRequests'))
      const targets = requestsSnap.docs.filter((docSnap) => {
        const data = docSnap.data() as any
        return data?.status === 'pending' && ((data?.from === a && data?.to === b) || (data?.from === b && data?.to === a))
      })
      await Promise.all(targets.map((docSnap) => deleteDoc(doc(db, 'friendRequests', docSnap.id))))
    } catch {
      // ignore cleanup failures; friend list removal is the critical action
    }
  }

  const handleBlockUser = async (targetUid: string) => {
    if (!user) return
    try {
      const targetProfile = await getUserProfile(targetUid)
      const ok = await blockUser(user.uid, targetUid)
      if (!ok) {
        setToastMessage('Unable to block user.')
        return
      }

      await Promise.all([
        removeFriend(user.uid, targetUid),
        removeFriend(targetUid, user.uid),
        clearFriendRequestsBetweenUsers(user.uid, targetUid),
      ])

      const resolvedName = targetProfile?.displayName || targetProfile?.email?.split('@')[0] || targetUid
      setBlockedUsers((current) => {
        const match = current.find((item) => item.uid === targetUid)
        if (match) return current
        return [...current, { id: targetUid, uid: targetUid, name: resolvedName, avatarUrl: targetProfile?.avatarUrl || '' }]
      })
      setFriends((current) => current.filter((friend) => friend.id !== targetUid))
      setPendingRequests((current) => current.filter((request) => request.from !== targetUid && request.to !== targetUid))
      setCommunityTab('blocked')
      setToastMessage('User blocked.')
    } catch (err) {
      console.error('block user error', err)
      setToastMessage('Unable to block user.')
    }
  }

  const handleToggleBlockUser = async (targetUid: string) => {
    if (!user) return
    if (isUserBlocked(targetUid)) {
      const ok = await unblockUser(user.uid, targetUid)
      if (!ok) {
        setToastMessage('Unable to unblock user.')
        return
      }
      setBlockedUsers((current) => current.filter((entry) => entry.uid !== targetUid))
      setToastMessage('User unblocked.')
      return
    }
    await handleBlockUser(targetUid)
  }

  const handleUnfriendUser = async (targetUid: string) => {
    if (!user || !targetUid || targetUid === user.uid) {
      return
    }

    try {
      const ok = await Promise.all([
        removeFriend(user.uid, targetUid),
        removeFriend(targetUid, user.uid),
        clearFriendRequestsBetweenUsers(user.uid, targetUid),
      ])

      if (ok.some((value) => value === false)) {
        setToastMessage('Unable to unfriend this user.')
        return
      }

      setFriends((current) => current.filter((friend) => friend.id !== targetUid))
      setPendingRequests((current) => current.filter((request) => request.from !== targetUid && request.to !== targetUid))
      setToastMessage('Friend removed.')
    } catch (err) {
      console.error('unfriend failed', err)
      setToastMessage('Unable to unfriend this user.')
    }
  }

  const handleSearchUsers = async (q: string) => {
    setSearchQuery(q)
    if (!q || q.trim().length === 0) {
      setSearchResults([])
      return
    }
    try {
      const results = await searchUsersByName(q.trim())
      setSearchResults(results.map((r: any) => ({
        uid: r.uid || r.uid || r.uid,
        displayName: r.displayName || '',
        email: r.email || '',
        avatarUrl: resolveAvatarUrl(r.avatarUrl, r.photoURL),
      })))
    } catch (err) {
      setSearchResults([])
    }
  }

  const handleViewProfile = async (uid: string) => {
    if (!user) {
      setToastMessage('Sign in to view profiles.')
      return
    }

    try {
      const p = await getUserProfile(uid)
      if (!p) {
        setToastMessage('Profile not found for this account.')
        return
      }
      const friends = await getFriendsOnce(uid)
      setFullProfileUid(uid)
      setPage('profile')
      setViewProfileUid(uid)
      setViewProfileData(p)
      setViewProfileFriends(friends)
    } catch (err) {
      console.error('view profile error uid=', uid, err)
      setToastMessage(err instanceof Error ? err.message : 'Unable to load profile. Check console for details.')
    }
  }

  const handleSendChatMessage = async (chatId: string, text: string) => {
    if (!user) return
    try {
      await sendMessage(chatId, user.uid, text)
    } catch (err) {
      setToastMessage('Failed to send message.')
    }
  }

  useEffect(() => {
    return () => {
      try { chatUnsubRef.current && chatUnsubRef.current() } catch {}
    }
  }, [])

  useEffect(() => {
    const unsubscribe = onAuthStateChanged(auth, async (firebaseUser) => {
      if (!firebaseUser) {
        resetPageScopedState()
        setUser(null)
        setProfile(null)
        setFriends([])
        setBlockedUsers([])
        setPendingRequests([])
        setNotifications([])
        setPurchasedGameIds([])
        setFavoriteGameIds([])
        setWishlistGameIds([])
        setCartGameIds([])
        setPage('home')
        return
      }

      resetPageScopedState()
      setUser(firebaseUser)

      try {
        const profileRef = doc(db, 'users', firebaseUser.uid)
        const profileDoc = await getDoc(profileRef)
        const fallbackName = firebaseUser.displayName || toDisplayName(firebaseUser.email || 'Player')

        const existingData = profileDoc.exists() ? (profileDoc.data() as any) : null
        const nextFriendCode = existingData?.friendCode || await ensureUniqueFriendCode(firebaseUser.uid)

        if (!profileDoc.exists()) {
          await setDoc(profileRef, {
            uid: firebaseUser.uid,
            displayName: fallbackName,
            displayNameLower: fallbackName.toLowerCase(),
            email: firebaseUser.email || '',
            emailLower: (firebaseUser.email || '').toLowerCase(),
            role: 'user',
            status: 'Online',
            ownedGames: [],
            bio: 'No bio yet.',
            country: 'United States',
            city: '',
            avatarUrl: '',
            coverUrl: '',
            screenshots: [],
            friendCode: nextFriendCode,
          }, { merge: true })
        } else if (!existingData?.friendCode) {
          await setDoc(profileRef, { friendCode: nextFriendCode }, { merge: true })
        }

        const finalProfileDoc = await getDoc(profileRef)
        const finalData = finalProfileDoc.exists() ? (finalProfileDoc.data() as any) : null
        const nextProfile: Profile = finalProfileDoc.exists()
          ? ({
              uid: firebaseUser.uid,
              ...(finalData as Omit<Profile, 'uid'>),
              avatarUrl: resolveAvatarUrl(finalData?.avatarUrl, finalData?.photoURL, firebaseUser.photoURL),
              coverUrl: finalData?.coverUrl || '',
              screenshots: finalData?.screenshots || [],
              friendCode: finalData?.friendCode || nextFriendCode,
            })
          : {
              uid: firebaseUser.uid,
              displayName: fallbackName,
              email: firebaseUser.email || '',
            role: 'user',
              bio: 'No bio yet.',
              country: 'United States',
              city: '',
              avatarUrl: resolveAvatarUrl(firebaseUser.photoURL),
              coverUrl: '',
              screenshots: [],
              friendCode: nextFriendCode,
            }

        setProfile(nextProfile)
        setProfileDraft({
          displayName: nextProfile.displayName,
          bio: nextProfile.bio || 'No bio yet.',
          country: nextProfile.country || 'United States',
          city: nextProfile.city || '',
          avatarUrl: nextProfile.avatarUrl || '',
          coverUrl: nextProfile.coverUrl || '',
          screenshots: nextProfile.screenshots || [],
        })
        setPage('home')

        // setup presence in RTDB and listen for friends updates
        try {
          const cleanupPresence = setupPresence(firebaseUser.uid)
          const unsubFriends = listenToFriends(firebaseUser.uid, async (list) => {
            const visible = list.filter((friend) => !blockedUsers.some((entry) => entry.uid === friend.id))
            const nextFriends = await Promise.all(visible.map(async (f) => {
              const profile = await getUserProfile(f.id)
              const statusText = launcherLanguage === 'ar'
                ? (f.status === 'online' ? 'متصل' : 'غير متصل')
                : (f.status === 'online' ? 'Online' : 'Offline')
              return {
                id: f.id,
                name: f.name || profile?.displayName || f.id,
                status: statusText,
                color: f.status === 'online' ? 'bg-[#22c55e]' : 'bg-[#9aa5b5]',
                avatarUrl: resolveAvatarUrl(profile?.avatarUrl, f.avatarUrl),
              }
            }))
            setFriends(nextFriends)
          })
          const unsubRequests = listenIncomingFriendRequests(firebaseUser.uid, async (items: Array<{ id: string; from: string; to: string }>) => {
            const resolved = await Promise.all(items.map(async (it) => {
              const senderProfile = await getUserProfile(it.from)
              return {
                id: it.id,
                from: it.from,
                to: it.to,
                fromName: senderProfile?.displayName || 'Unknown User',
                avatarUrl: resolveAvatarUrl(senderProfile?.avatarUrl),
              }            }))
            setPendingRequests((current) => {
              const next = resolved.map((request) => ({
                id: request.id,
                from: request.from,
                to: request.to,
                fromName: request.fromName || 'Unknown User',
                toName: firebaseUser.displayName || firebaseUser.email || 'You',
                avatarUrl: resolveAvatarUrl(request.avatarUrl),
              }))
              return next.length > 0 ? next : current.filter((item) => !items.some((incoming) => incoming.id === item.id))
            })

            await Promise.all(resolved.map((request) => ensureFriendRequestNotification(firebaseUser.uid, {
              id: request.id,
              from: request.from,
              to: request.to,
              fromName: request.fromName,
            })))
          })

          ;(window as any).__dreko_cleanup_presence = () => {
            try { cleanupPresence && cleanupPresence() } catch {}
            try { unsubFriends && unsubFriends() } catch {}
            try { unsubRequests && unsubRequests() } catch {}
          }
        } catch (err) {
          // ignore
        }

        const loadCommunityMeta = async () => {
          try {
            const [blockedSnap, requestsSnap] = await Promise.all([
              getDocs(collection(db, `users/${firebaseUser.uid}/blocks`)),
              getDocs(collection(db, 'friendRequests')),
            ])

            const nextBlocked = await Promise.all(blockedSnap.docs.map(async (docSnap) => {
              const targetUid = docSnap.id
              const profile = await getUserProfile(targetUid)
              return {
                id: targetUid,
                uid: targetUid,
                name: profile?.displayName || profile?.email?.split('@')[0] || targetUid,
                avatarUrl: resolveAvatarUrl(profile?.avatarUrl),
              }
            }))

            const nextPending = await Promise.all(
              requestsSnap.docs
                .filter((docSnap) => {
                  const data = docSnap.data() as any
                  return data?.status === 'pending' && (data?.from === firebaseUser.uid || data?.to === firebaseUser.uid)
                })
                .map(async (docSnap) => {
                  const data = docSnap.data() as any
                  const fromProfile = await getUserProfile(data.from)
                  const toProfile = await getUserProfile(data.to)
                  return {
                    id: docSnap.id,
                    from: data.from,
                    to: data.to,
                    fromName: fromProfile?.displayName || data.from,
                    toName: toProfile?.displayName || data.to,
                    avatarUrl: resolveAvatarUrl(fromProfile?.avatarUrl),
                  }
                })
            )

            await Promise.all(nextPending
              .filter((request) => request.to === firebaseUser.uid)
              .map((request) => ensureFriendRequestNotification(firebaseUser.uid, request)))

            setBlockedUsers(nextBlocked)
            setPendingRequests(nextPending)
          } catch {
            setBlockedUsers([])
            setPendingRequests([])
          }
        }

        void loadCommunityMeta()
      } catch {
        const fallbackProfile: Profile = {
          uid: firebaseUser.uid,
          displayName: firebaseUser.displayName || toDisplayName(firebaseUser.email || 'Player'),
          email: firebaseUser.email || '',
          role: 'user',
          bio: 'No bio yet.',
          country: 'United States',
          city: '',
          avatarUrl: '',
          coverUrl: '',
          screenshots: [],
        }
        setProfile(fallbackProfile)
        setProfileDraft({
          displayName: fallbackProfile.displayName,
          bio: fallbackProfile.bio || 'No bio yet.',
          country: fallbackProfile.country || 'United States',
          city: fallbackProfile.city || '',
          avatarUrl: fallbackProfile.avatarUrl || '',
          coverUrl: fallbackProfile.coverUrl || '',
          screenshots: fallbackProfile.screenshots || [],
        })
      }
    })

    return unsubscribe
  }, [])

  useEffect(() => {
    return () => {
      try { (window as any).__dreko_cleanup_presence && (window as any).__dreko_cleanup_presence() } catch {}
    }
  }, [])

  useEffect(() => {
    // detect whether the preload bridge injected the electron API
    try {
      setIsElectron(!!window.electronAPI && typeof window.electronAPI.downloadGame === 'function')
    } catch {
      setIsElectron(false)
    }
  }, [])

  useEffect(() => {
    const loadData = async () => {
      try {
        const gamesSnap = await getDocs(collection(db, 'games'))

        const firestoreGames = gamesSnap.docs.map((docSnap) => normalizeGameRecord({
          id: docSnap.id,
          ...(docSnap.data() as Record<string, any>),
        }))
        setGames(firestoreGames)

        if (user) {
          const profileDoc = await getDoc(doc(db, 'users', user.uid))
          const ownedGames = ((profileDoc.data()?.ownedGames as string[] | undefined) ?? [])
          setPurchasedGameIds(ownedGames)

          const friendList = await getFriendsOnce(user.uid)
          const nextFriends: Friend[] = await Promise.all(friendList.map(async (friend) => {
            const profile = await getUserProfile(friend.id)
            const statusText = getLocalizedPresenceLabel(String(friend.status || 'offline'), launcherLanguage)
            return {
              id: friend.id,
              name: friend.name || profile?.displayName || friend.id,
              status: statusText,
              color: 'bg-[#9aa5b5]',
              avatarUrl: profile?.avatarUrl || friend.avatarUrl || '',
            }
          }))

          setFriends(nextFriends)
        }
      } catch {
        setGames([])
        setFriends([])
      }
    }

    if (user) {
      void loadData()
    }
  }, [user])

  const ensureUserProfile = async (uid: string, profileName: string, email: string, role: 'admin' | 'user', country: string) => {
    const userDoc = doc(db, 'users', uid)
    const existing = await getDoc(userDoc)
    const existingData = existing.exists() ? (existing.data() as any) : null
    const nextFriendCode = existingData?.friendCode || await ensureUniqueFriendCode(uid)
    const payload = {
      uid,
      displayName: profileName,
      displayNameLower: profileName.toLowerCase(),
      email,
      emailLower: email.toLowerCase(),
      role,
      status: 'Online',
      ownedGames: existing.exists() ? existingData?.ownedGames ?? [] : [],
      bio: existing.exists() ? existingData?.bio ?? 'No bio yet.' : 'No bio yet.',
      country,
      city: existing.exists() ? existingData?.city ?? '' : '',
      avatarUrl: existing.exists() ? existingData?.avatarUrl ?? '' : '',
      coverUrl: existing.exists() ? existingData?.coverUrl ?? '' : '',
      screenshots: existing.exists() ? existingData?.screenshots ?? [] : [],
      friendCode: nextFriendCode,
    }

    await setDoc(userDoc, payload, { merge: true })
    return payload
  }

  const handleGoogleSignIn = async () => {
    // Try to load clientId/clientSecret from Firestore first, then localStorage, then fallback to modal
    let clientId = ''
    let clientSecret = ''

    try {
      const secretDoc = await getDoc(doc(db, 'app_config', 'google_oauth'))
      if (secretDoc.exists()) {
        const data = secretDoc.data() as any
        clientId = String(data.clientId || data.client_id || '')
        clientSecret = String(data.clientSecret || data.client_secret || '')
      }
    } catch (e) {
      // ignore firestore read errors — continue to localStorage fallback
    }

    if (!clientId) {
      try { clientId = window.localStorage.getItem('google-oauth-client-id') || '' } catch {}
    }
    if (!clientSecret) {
      try { clientSecret = window.localStorage.getItem('google-oauth-client-secret') || '' } catch {}
    }

    if (!clientId) {
      setGoogleClientIdInput('')
      setGoogleClientSecretInput('')
      setShowGoogleClientModal(true)
      return
    }

    setLoading(true)
    try {
      if (isElectron && (window as any).electronAPI?.startGoogleOAuth) {
        const result = await (window as any).electronAPI.startGoogleOAuth({ clientId, clientSecret })
        if (!result || (!result.id_token && !result.access_token)) {
          setError('OAuth failed to return tokens.')
          setLoading(false)
          return
        }

        // Sign in to Firebase using the received tokens
        try {
          const credential = GoogleAuthProvider.credential(result.id_token || null, result.access_token || null)
          await signInWithCredential(auth, credential)
          setError('')
        } catch (err) {
          setError('Firebase sign-in failed after OAuth.')
        }
      } else {
        setError('Desktop Google OAuth is not available in this environment.')
      }
    } catch (err: any) {
      setError(String(err?.message || err))
    } finally {
      setLoading(false)
    }
  }


    // Fallback for browser environments: try the normal popup/redirect flow
    const provider = new GoogleAuthProvider()

    try {
      const result = await signInWithPopup(auth, provider)
      const finalName = result.user.displayName || toDisplayName(result.user.email || 'Player')
      const selectedCountry = authCountry || 'Libya'
      const profilePayload = await ensureUserProfile(result.user.uid, finalName, result.user.email || '', 'user', selectedCountry)

      setProfile({
        uid: result.user.uid,
        displayName: profilePayload.displayName,
        email: profilePayload.email,
        role: profilePayload.role,
        country: profilePayload.country,
        city: profilePayload.city,
        bio: profilePayload.bio,
        avatarUrl: resolveAvatarUrl(profilePayload.avatarUrl, result.user.photoURL),
        coverUrl: profilePayload.coverUrl || '',
        screenshots: profilePayload.screenshots || [],
        friendCode: profilePayload.friendCode,
      })
      setPage('home')
      return
    } catch (authError) {
      const message = authError instanceof Error ? authError.message : 'Google sign-in failed.'
      setError(message)
    } finally {
      setLoading(false)
    }
  }

  const handleAuth = async (mode: 'login' | 'register') => {
    if (!authEmail || !authPassword) {
      setError('Email and password are required.')
      return
    }

    setLoading(true)
    setError('')

    try {
      const result = mode === 'register'
        ? await createUserWithEmailAndPassword(auth, authEmail, authPassword)
        : await signInWithEmailAndPassword(auth, authEmail, authPassword)

      const finalName = displayName || toDisplayName(authEmail)
      const selectedCountry = authCountry || 'Libya'

      const profilePayload = await ensureUserProfile(result.user.uid, finalName, authEmail, 'user', selectedCountry)

      setProfile({
        uid: result.user.uid,
        displayName: profilePayload.displayName,
        email: profilePayload.email,
        role: profilePayload.role,
        country: profilePayload.country,
        city: profilePayload.city,
        bio: profilePayload.bio,
        avatarUrl: resolveAvatarUrl(profilePayload.avatarUrl, result.user.photoURL),
        coverUrl: profilePayload.coverUrl || '',
        screenshots: profilePayload.screenshots || [],
        friendCode: profilePayload.friendCode,
      })
      setPage('home')
    } catch (authError) {
      const message = authError instanceof Error ? authError.message : 'Authentication failed.'
      setError(message)
    } finally {
      setLoading(false)
    }
  }

  const handleLogout = async () => {
    await signOut(auth)
    setPage('home')
    setDisplayName('')
  }

  const getNotificationClearTimestamp = async (uid: string) => {
    if (!uid) {
      return 0
    }

    try {
      const userDoc = await getDoc(doc(db, 'users', uid))
      const value = Number(userDoc.data()?.notificationClearedAt ?? 0)
      return Number.isFinite(value) ? value : 0
    } catch {
      return 0
    }
  }

  const ensureFriendRequestNotification = async (recipientUid: string, request: { id: string; from: string; to: string; fromName?: string; toName?: string }) => {
    if (!recipientUid || !request?.to || request.to !== recipientUid) return

    try {
      const clearedAt = await getNotificationClearTimestamp(recipientUid)
      const notificationsSnap = await getDocs(collection(db, `users/${recipientUid}/notifications`))
      const alreadyExists = notificationsSnap.docs.some((docSnap) => {
        const data = docSnap.data() as Record<string, any>
        return data?.type === 'friend_request' && (data?.friendUid === request.from || data?.id === request.id)
      })

      if (alreadyExists) {
        return
      }

      const senderProfile = await getUserProfile(request.from)
      const payload = {
        id: request.id,
        type: 'friend_request' as const,
        title: 'Friend request',
        message: `${senderProfile?.displayName || request.fromName || 'Someone'} wants to add you as a friend.`,
        read: false,
        friendUid: request.from,
        friendName: senderProfile?.displayName || request.fromName || 'Someone',
        avatarUrl: resolveAvatarUrl(senderProfile?.avatarUrl),
        imageUrl: '',
        createdAt: Date.now(),
        targetUid: recipientUid,
      }

      if (clearedAt > 0 && payload.createdAt <= clearedAt) {
        return
      }

      await setDoc(doc(db, `users/${recipientUid}/notifications`, payload.id), payload)
    } catch {
      // ignore backfill notification errors
    }
  }

  const sanitizeNotificationPayload = <T extends Record<string, any>>(payload: T) => Object.fromEntries(
    Object.entries(payload).filter(([, value]) => value !== undefined),
  ) as T

  const pushNotification = async (notification: { type: 'friend_request' | 'game_added' | 'system'; title: string; message: string; friendUid?: string; friendName?: string; avatarUrl?: string; imageUrl?: string; targetUid?: string }) => {
    if (!user) return

    const payload = sanitizeNotificationPayload({
      id: `${Date.now()}-${Math.random().toString(16).slice(2)}`,
      type: notification.type,
      title: notification.title,
      message: notification.message,
      read: false,
      friendUid: notification.friendUid,
      friendName: notification.friendName,
      avatarUrl: notification.avatarUrl,
      imageUrl: notification.imageUrl,
      createdAt: Date.now(),
      targetUid: notification.targetUid,
    })

    if (!notification.targetUid || notification.targetUid === user.uid) {
      return
    }

    try {
      await setDoc(doc(db, `users/${notification.targetUid}/notifications`, payload.id), sanitizeNotificationPayload({
        ...payload,
        createdAt: Date.now(),
      }))
    } catch {
      // ignore notification persistence errors for optional feature
    }
  }

  const broadcastNotification = async (notification: { type: 'friend_request' | 'game_added' | 'system'; title: string; message: string; friendUid?: string; friendName?: string; avatarUrl?: string; imageUrl?: string }) => {
    try {
      const usersSnap = await getDocs(collection(db, 'users'))
      const notificationId = `${Date.now()}-${Math.random().toString(16).slice(2)}`
      const createdAt = Date.now()
      const payload = sanitizeNotificationPayload({
        id: notificationId,
        type: notification.type,
        title: notification.title,
        message: notification.message,
        read: false,
        friendUid: notification.friendUid,
        friendName: notification.friendName,
        avatarUrl: notification.avatarUrl,
        imageUrl: notification.imageUrl,
        createdAt,
      })

      const targetUids = Array.from(new Set([
        ...usersSnap.docs.map((userDoc) => userDoc.id),
        ...(user ? [user.uid] : []),
      ]))

      await Promise.all(targetUids.map(async (targetUid) => {
        const targetPayload = sanitizeNotificationPayload({ ...payload, targetUid, avatarUrl: notification.avatarUrl || notification.imageUrl || payload.avatarUrl })
        await setDoc(doc(db, `users/${targetUid}/notifications`, `${payload.id}-${targetUid}`), targetPayload)
      }))
    } catch (error) {
      console.warn('[notifications] broadcast failed', error)
    }
  }

  const markNotificationRead = async (notificationId: string) => {
    const normalizedId = String(notificationId || '').trim()
    if (!normalizedId) return

    setNotifications((current) => current.filter((notification) => notification.id !== normalizedId))
    if (!user) return

    try {
      const notificationDoc = doc(db, `users/${user.uid}/notifications`, normalizedId)
      await deleteDoc(notificationDoc)
      await setDoc(doc(db, 'users', user.uid), { notificationClearedAt: Date.now() }, { merge: true })
    } catch {
      try {
        await setDoc(doc(db, `users/${user.uid}/notifications`, normalizedId), { read: true }, { merge: true })
      } catch {
        // ignore read-state persistence failures
      }
    }
  }

  const clearNotifications = async () => {
    if (!user) {
      setNotifications([])
      return
    }

    const clearedAt = Date.now()
    try {
      const snap = await getDocs(collection(db, `users/${user.uid}/notifications`))
      await Promise.all([
        ...snap.docs.map((notificationDoc) => deleteDoc(doc(db, `users/${user.uid}/notifications`, notificationDoc.id))),
        setDoc(doc(db, 'users', user.uid), { notificationClearedAt: clearedAt }, { merge: true }),
      ])
    } catch {
      try {
        await setDoc(doc(db, 'users', user.uid), { notificationClearedAt: clearedAt }, { merge: true })
      } catch {
        // ignore cleanup errors
      }
    }
    setNotifications([])
  }

  const handleAddGame = async () => {
    if (!newGame.title || !newGame.image || !newGame.downloadUrl) {
      setError('Please add title, cover image, and download URL.')
      return
    }

    const screenshots = [
      newGame.screenshots1,
      newGame.screenshots2,
      newGame.screenshots3,
      newGame.screenshots4,
    ]
      .map((item) => item.trim())
      .filter(Boolean)
      .slice(0, 4)

    const payload = {
      title: newGame.title,
      image: newGame.image,
      genre: newGame.genre,
      price: newGame.price,
      description: newGame.description || 'New game added from the admin panel.',
      status: newGame.status,
      downloadUrl: newGame.downloadUrl,
      fileName: newGame.fileName,
      size: newGame.size,
      version: newGame.version,
      platform: newGame.platform,
      screenshots: screenshots.length > 0 ? screenshots : [newGame.image],
      trailerUrl: newGame.trailerUrl || '',
      developer: newGame.developer,
      publisher: newGame.publisher,
      releaseDate: newGame.releaseDate,
      hidden: false,
      requirements: {
        minimum: newGame.minimumRequirements,
        recommended: newGame.recommendedRequirements,
      },
    }

    try {
      if (editingGameId) {
        const currentHidden = games.find((game) => game.id === editingGameId)?.hidden ?? false
        const nextPayload = { ...payload, hidden: currentHidden }
        await updateDoc(doc(db, 'games', editingGameId), nextPayload)
        setGames((current) => current.map((game) => game.id === editingGameId ? normalizeGameRecord({ ...game, ...nextPayload, id: editingGameId }) : game))
        setError('')
        resetGameForm()
        setAdminMode('list')
        return
      }

      const docRef = await addDoc(collection(db, 'games'), payload)
      setGames((current) => [normalizeGameRecord({
        id: docRef.id,
        ...payload,
      }), ...current])

      if (user && newGame.sendNotify) {
        await broadcastNotification({
          type: 'game_added',
          title: 'New game added',
          message: `${newGame.title} was added to the store.`,
          imageUrl: newGame.image,
          avatarUrl: newGame.image,
        })
      }

      resetGameForm()
      setError('')
      setPage('store')
    } catch (saveError) {
      const message = saveError instanceof Error ? saveError.message : 'Could not save the game.'
      setError(message)
    }
  }

  const showNotification = (message: string) => {
    setToastMessage(message)

    if ('Notification' in window && Notification.permission === 'granted') {
      new Notification('Dreko Games', { body: message })
    } else if ('Notification' in window && Notification.permission === 'default') {
      Notification.requestPermission().then((permission) => {
        if (permission === 'granted') {
          new Notification('Dreko Games', { body: message })
        }
      })
    }
  }

  useEffect(() => {
    if (!user) {
      setNotifications([])
      return
    }

    const notificationsRef = collection(db, `users/${user.uid}/notifications`)
    const unsubscribe = onSnapshot(notificationsRef, async (snapshot) => {
      const clearedAt = await getNotificationClearTimestamp(user.uid)
      const nextNotifications: Array<{ id: string; type: 'friend_request' | 'game_added' | 'system'; title: string; message: string; read: boolean; friendUid?: string; friendName?: string; avatarUrl?: string; imageUrl?: string; createdAt?: number; targetUid?: string }> = snapshot.docs
        .map((docSnap) => {
          const data = docSnap.data() as Record<string, any>
        const createdAt = Number(data.createdAt ?? Date.now())
        return {
          id: docSnap.id,
          type: data.type ?? 'system',
          title: data.title ?? 'Notification',
          message: data.message ?? '',
          read: Boolean(data.read),
          friendUid: data.friendUid,
          friendName: data.friendName,
          avatarUrl: data.avatarUrl,
          imageUrl: data.imageUrl,
          createdAt,
          targetUid: data.targetUid,
        }
      })
      .filter((item) => !clearedAt || Number(item.createdAt ?? 0) > clearedAt)
      .sort((a, b) => Number(b.createdAt ?? 0) - Number(a.createdAt ?? 0))

    setNotifications(nextNotifications)
    }, () => {
    setNotifications([])
    })

    return () => unsubscribe()
  }, [user])

  useEffect(() => {
    if (!toastMessage) {
      return
    }

    const timer = window.setTimeout(() => setToastMessage(null), 3200)
    return () => window.clearTimeout(timer)
  }, [toastMessage])

  const normalizeDownloadUrl = (url: string) => {
    const trimmedUrl = url.trim()

    try {
      const parsed = new URL(trimmedUrl)
      const encodedPath = parsed.pathname
        .split('/')
        .map((segment) => encodeURIComponent(decodeURIComponent(segment)))
        .join('/')
      parsed.pathname = encodedPath
      return parsed.toString()
    } catch {
      return trimmedUrl.replace(/\[/g, '%5B').replace(/\]/g, '%5D')
    }
  }

  const isValidDownloadUrl = (url: string) => {
    const normalized = normalizeDownloadUrl(url)
    if (!normalized) {
      return false
    }

    try {
      const parsed = new URL(normalized)
      const allowedProtocols = ['http:', 'https:']
      if (!allowedProtocols.includes(parsed.protocol)) {
        return false
      }

      const googleDrivePatterns = [
        'drive.google.com',
        'drive.usercontent.google.com',
        'googleusercontent.com',
        'googleapis.com',
      ]

      const hasDirectFileExtension = /\.(zip|rar|exe|msi|dmg|tar\.gz|gz|7z|apk|iso|appimage|deb|rpm|tar|xz|bz2)(?:[?&].*)?$/i.test(normalized)
      const hasGoogleDriveDownload = googleDrivePatterns.some((pattern) => normalized.includes(pattern))
      const hasDirectDownloadPattern = /(?:download|export=download|uc\?|content-disposition|file\/d\/|\/o\/|releases\/latest\/download|release-assets)/i.test(normalized)
      const hasDirectFileName = /(?:\/|%2F)[^/?#]+\.(zip|rar|exe|msi|dmg|tar|gz|7z|apk|iso|appimage|deb|rpm)(?:[?&].*)?$/i.test(normalized)

      return hasDirectFileExtension || hasDirectFileName || hasGoogleDriveDownload && hasDirectDownloadPattern || normalized.includes('firebasestorage.googleapis.com') || normalized.includes('blob.core.windows.net') || normalized.includes('dropbox.com/s/') || normalized.includes('mega.nz') || normalized.includes('github.com') || normalized.includes('release-assets.githubusercontent.com')
    } catch {
      return false
    }
  }

  const convertGoogleDriveShareUrl = (url: string) => {
    const trimmed = url.trim()
    const match = trimmed.match(/[?&]id=([^&]+)/)

    if (match?.[1]) {
      return `https://drive.google.com/uc?export=download&id=${match[1]}`
    }

    if (trimmed.includes('drive.google.com/file/d/')) {
      const fileId = trimmed.split('/d/')[1]?.split('/')[0]
      if (fileId) {
        return `https://drive.google.com/uc?export=download&id=${fileId}`
      }
    }

    return trimmed
  }

  const testDownloadUrl = async (rawUrl: string) => {
    const url = normalizeDownloadUrl(convertGoogleDriveShareUrl(rawUrl))

    if (!url || !isValidDownloadUrl(url)) {
      return { ok: false, message: 'هذا الرابط غير صالح أو لا يشير إلى ملف قابل للتنزيل.' }
    }

    const controller = new AbortController()
    const timeoutId = window.setTimeout(() => controller.abort(), 15000)

    try {
      const headResponse = await fetch(url, {
        method: 'HEAD',
        cache: 'no-store',
        signal: controller.signal,
      })

      if (headResponse.ok || headResponse.type === 'opaque') {
        return { ok: true, message: 'رابط التنزيل يعمل بشكل صحيح.' }
      }

      const getResponse = await fetch(url, {
        method: 'GET',
        cache: 'no-store',
        signal: controller.signal,
      })

      if (getResponse.ok || getResponse.type === 'opaque') {
        return { ok: true, message: 'رابط التنزيل يعمل بشكل صحيح.' }
      }

      return { ok: false, message: 'الخادم رفض الطلب أو الرابط لا يفتح كملف قابل للتنزيل.' }
    } catch (error) {
      const message = error instanceof Error && error.name === 'AbortError'
        ? 'انتهت مهلة اختبار الرابط. تأكد أن الخادم يستجيب بسرعة.'
        : 'الرابط لا يستجيب بشكل صحيح أو تم حظره بواسطة الخادم.'

      return { ok: false, message }
    } finally {
      window.clearTimeout(timeoutId)
    }
  }

  const handleChooseInstallFolder = async () => {
    try {
      if (window.electronAPI?.selectDownloadFolder) {
        const folder = await window.electronAPI.selectDownloadFolder()
        if (folder) {
          setInstallFolder(folder)
          setError('')
        }
        return
      }

      const input = document.createElement('input')
      input.type = 'file'
      input.setAttribute('webkitdirectory', 'true')
      input.setAttribute('directory', 'true')
      input.setAttribute('multiple', 'false')
      input.style.display = 'none'

      const chosenFolder = await new Promise<string>((resolve) => {
        input.addEventListener('change', () => {
          const file = input.files?.[0]
          const folderLabel = file?.webkitRelativePath?.split('/')[0] || 'Selected Folder'
          resolve(folderLabel)
        }, { once: true })

        document.body.appendChild(input)
        input.click()
        setTimeout(() => {
          document.body.removeChild(input)
        }, 100)
      })

      if (chosenFolder) {
        setInstallFolder(chosenFolder)
        setError('')
      }
    } catch {
      showNotification('No folder selected.')
    }
  }

  const isGameDownloadLocked = (gameId: string) => {
    if (installedGameIds.includes(gameId)) {
      return true
    }

    if (downloadingId === gameId) {
      return true
    }

    return downloadHistory.some((item) => item.id === gameId && ['queued', 'downloading'].includes(item.status))
  }

  const handleCancelDownload = async (gameIdOverride?: string) => {
    const targetId = gameIdOverride ?? downloadingId
    if (!targetId) {
      return
    }

    try {
      if (window.electronAPI?.cancelDownload) {
        await window.electronAPI.cancelDownload({ gameId: targetId })
      }
    } catch {
      // ignored: local state reset continues below
    }

    setDownloadHistory((current) => current.filter((item) => item.id !== targetId))
    setDownloadProgress({
      gameId: targetId,
      percent: 0,
      downloaded: 0,
      total: 0,
      speed: 0,
      eta: 0,
      active: false,
    })

    if (targetId === downloadingId) {
      setDownloadingId(null)
    }
  }

  const isUserDownloadAbort = (error: unknown) => {
    const text = error instanceof Error ? `${error.name}: ${error.message}` : String(error ?? '')
    return /(cancelled|aborted|terminated|signal)/i.test(text)
  }

  const handlePauseDownload = async (gameId: string) => {
    try {
      if (window.electronAPI?.pauseDownload) {
        await window.electronAPI.pauseDownload({ gameId })
      }
    } catch {
      // ignore
    }

    setDownloadHistory((current) => current.map((item) => item.id === gameId ? { ...item, status: 'paused' } : item))
  }

  const handleResumeDownload = async (gameId: string) => {
    try {
      if (window.electronAPI?.resumeDownload) {
        await window.electronAPI.resumeDownload({ gameId })
      }
    } catch {
      // ignore
    }

    setDownloadHistory((current) => current.map((item) => item.id === gameId ? { ...item, status: 'downloading' } : item))
  }

  const removeDownloadFromList = (gameId: string) => {
    setDownloadHistory((current) => current.filter((item) => item.id !== gameId))
    if (downloadProgress.gameId === gameId) {
      setDownloadProgress({ gameId: '', percent: 0, downloaded: 0, total: 0, speed: 0, eta: 0, active: false })
    }
    if (downloadingId === gameId) {
      setDownloadingId(null)
    }
  }

  const syncInstalledState = async () => {
    if (!Object.keys(installedGamePaths).length || !window.electronAPI?.checkPathExists) {
      return
    }

    const nextInstalledIds: string[] = []
    const nextInstalledPaths: Record<string, string> = {}

    for (const [gameId, targetPath] of Object.entries(installedGamePaths)) {
      if (!targetPath) {
        continue
      }

      const exists = await window.electronAPI.checkPathExists({ path: targetPath })
      if (exists) {
        nextInstalledIds.push(gameId)
        nextInstalledPaths[gameId] = targetPath
      }
    }

    setInstalledGameIds(nextInstalledIds)
    setInstalledGamePaths(nextInstalledPaths)
  }

  const handleDownloadGame = async (game: Game) => {
    if (isGameDownloadLocked(game.id)) {
      showNotification('This game is already downloading or queued. Please wait for it to finish.')
      return
    }

    if (installedGameIds.includes(game.id)) {
      showNotification('This game is already installed.')
      return
    }

    const cleanupQueued = () => {
      setDownloadHistory((current) => current.filter((item) => item.id !== game.id))
      setDownloadProgress({ gameId: '', percent: 0, downloaded: 0, total: 0, speed: 0, eta: 0, active: false })
      setDownloadingId((current) => (current === game.id ? null : current))
    }

    try {
      const entry: DownloadItem = {
        id: game.id,
        title: game.title,
        fileName: game.fileName || `${game.title}.zip`,
        status: 'queued',
        progress: 0,
        downloaded: 0,
        total: 0,
        speed: 0,
        eta: 0,
        installDir: installFolder,
      }

      setPage('downloads')
      setSelectedGame(null)
      setDownloadHistory((current) => [entry, ...current.filter((item) => item.id !== game.id)])
      setDownloadingId(game.id)
      setDownloadProgress({
        gameId: game.id,
        percent: 0,
        downloaded: 0,
        total: 0,
        speed: 0,
        eta: 0,
        active: true,
      })

      const originalUrl = game.downloadUrl?.trim()
      if (!originalUrl) {
        showNotification('هذه اللعبة غير متوفرة الآن')
        cleanupQueued()
        return
      }

      const normalizedUrl = normalizeDownloadUrl(originalUrl)
      const isDirectLink = isValidDownloadUrl(normalizedUrl)
      if (!isDirectLink) {
        showNotification('رابط التحميل غير صالح. استخدم رابط مباشر للملف فقط.')
        cleanupQueued()
        return
      }

      const isGoogleDriveUrl = /drive\.google\.com|drive\.usercontent\.google\.com|googleusercontent\.com|googleapis\.com/i.test(normalizedUrl)

      if (!window.electronAPI?.downloadGame || isGoogleDriveUrl) {
        setInstallModalGame(null)
        setError('')
        setDownloadHistory((current) => current.map((item) => item.id === game.id ? {
          ...item,
          status: 'failed',
          progress: 0,
          downloaded: 0,
          total: 0,
          speed: 0,
          eta: 0,
          installDir: installFolder || 'C:\\DrekoGames',
        } : item))
        setDownloadProgress({
          gameId: game.id,
          percent: 0,
          downloaded: 0,
          total: 0,
          speed: 0,
          eta: 0,
          active: false,
        })
        showNotification('This download must run inside the Electron app. Please launch the desktop app, not the browser version.')
        return
      }

      let targetFolder = installFolder
      if (!targetFolder) {
        targetFolder = await window.electronAPI.selectDownloadFolder()
      }

      if (!targetFolder) {
        showNotification('يجب اختيار مكان تنزيل اللعبة أولاً')
        cleanupQueued()
        return
      }

      setInstallFolder(targetFolder)

      const unsubscribeProgress = window.electronAPI.onDownloadProgress((payload) => {
        if (payload.gameId !== game.id) {
          return
        }

        setDownloadProgress(payload)
        setDownloadHistory((current) => current.map((item) => {
          if (item.id !== game.id) {
            return item
          }

          const safePercent = Number.isFinite(payload.percent) ? Math.min(100, Math.max(0, payload.percent)) : item.progress

          const nextStatus: DownloadItem['status'] = payload.paused ? 'paused' : payload.active ? 'downloading' : item.status

          return {
            ...item,
            status: nextStatus,
            progress: nextStatus === 'downloading' ? safePercent : item.progress,
            downloaded: payload.downloaded,
            total: payload.total,
            speed: payload.speed,
            eta: payload.eta,
            installDir: targetFolder,
          }
        }))
      })

      try {
        setInstallModalGame(null)
        const savedPath = await window.electronAPI.downloadGame({
          url: normalizedUrl,
          fileName: game.fileName || `${game.title}.zip`,
          installDir: targetFolder,
          createShortcut,
          shortcutName: game.title,
          gameId: game.id,
        })

        if (savedPath === '') {
          setDownloadHistory((current) => current.map((item) => item.id === game.id ? {
            ...item,
            status: 'cancelled',
            progress: 0,
            downloaded: 0,
            total: 0,
            speed: 0,
            eta: 0,
            installDir: targetFolder,
          } : item))
          setDownloadProgress({
            gameId: game.id,
            percent: 0,
            downloaded: 0,
            total: 0,
            speed: 0,
            eta: 0,
            active: false,
          })
          setDownloadingId(null)
          return
        }

        if (!savedPath) {
          throw new Error('Download did not create a valid file.')
        }

        setError('')
        const finalTotal = Number(downloadProgress.total) > 0 ? Number(downloadProgress.total) : Number(downloadProgress.downloaded) > 0 ? Number(downloadProgress.downloaded) : 0
        const verifiedTotal = finalTotal > 0 ? finalTotal : 1

        setDownloadProgress({
          gameId: game.id,
          percent: 100,
          downloaded: verifiedTotal,
          total: verifiedTotal,
          speed: 0,
          eta: 0,
          active: false,
        })
        setInstalledGameIds((current) => Array.from(new Set([...current, game.id])))
        setInstalledGamePaths((current) => ({ ...current, [game.id]: savedPath }))
        setDownloadHistory((current) => current.map((item) => item.id === game.id ? {
          ...item,
          status: 'completed',
          progress: 100,
          downloaded: verifiedTotal,
          total: verifiedTotal,
          speed: 0,
          eta: 0,
          installDir: targetFolder,
        } : item))
        showNotification(`${game.title} is now installed and ready to play.`)
      } catch (electronDownloadError) {
        const userAbort = isUserDownloadAbort(electronDownloadError)

        if (userAbort) {
          setDownloadHistory((current) => current.map((item) => item.id === game.id ? {
            ...item,
            status: 'cancelled',
            progress: 0,
            downloaded: 0,
            total: 0,
            speed: 0,
            eta: 0,
            installDir: targetFolder,
          } : item))
          setDownloadProgress({
            gameId: game.id,
            percent: 0,
            downloaded: 0,
            total: 0,
            speed: 0,
            eta: 0,
            active: false,
          })
          setDownloadingId(null)
          return
        }

        console.warn('Electron download failed, falling back to browser download:', electronDownloadError)
        setError('')
        cleanupQueued()
        return
      } finally {
        unsubscribeProgress()
      }
    } catch (downloadingError) {
      const message = downloadingError instanceof Error ? downloadingError.message : 'Download failed.'
      setDownloadHistory((current) => current.map((item) => item.id === game.id ? { ...item, status: 'failed', progress: 0 } : item))
      showNotification(message || 'Game not available')
    } finally {
      setDownloadingId(null)
    }
  }

  const handlePurchaseGame = async (game: Game) => {
    if (!user) return

    if (purchasedGameIds.includes(game.id)) {
      setSelectedGame(null)
      setPage('library')
      setError('')
      return
    }

    const nextOwnedGames = Array.from(new Set([...purchasedGameIds, game.id]))
    setPurchasedGameIds(nextOwnedGames)

    try {
      await setDoc(doc(db, 'users', user.uid), { ownedGames: nextOwnedGames }, { merge: true })
      setSelectedGame(null)
      setPage('library')
      setError('')
    } catch {
      setError('Could not add game to your library.')
    }
  }

  const handleOpenGame = async (gameId: string) => {
    const rawTarget = installedGamePaths[gameId] || downloadHistory.find((d) => d.id === gameId)?.installDir
    if (!rawTarget) {
      showNotification('Could not find installed path for this game.')
      return
    }

    try {
      if (window.electronAPI?.checkPathExists) {
        const exists = await window.electronAPI.checkPathExists({ path: rawTarget })
        if (!exists) {
          setInstalledGameIds((current) => current.filter((id) => id !== gameId))
          setInstalledGamePaths((current) => {
            const next = { ...current }
            delete next[gameId]
            return next
          })
          showNotification('This game file no longer exists; it can be downloaded again.')
          return
        }
      }

      if (window.electronAPI?.openPath) {
        await window.electronAPI.openPath({ path: rawTarget })
      } else {
        showNotification('Open not supported in this environment.')
      }
    } catch {
      showNotification('Unable to open the game folder.')
    }
  }

  const triggerSpeedTest = async () => {
    if (!window.electronAPI?.measureDownloadSpeed) {
      showNotification('Speed test is only available in the desktop app.')
      return
    }

    try {
      const result = await window.electronAPI.measureDownloadSpeed({
        url: 'https://www.7-zip.org/a/7z2409-x64.exe',
      })

      setNetworkSpeed({ value: result.mbps, label: result.label })
      showNotification(`Test Speed: ${result.label}`)
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Speed test could not complete.'
      setNetworkSpeed(null)
      showNotification(message)
    }
  }

  const handleUninstallGame = async (gameId: string) => {
    const targetPath = installedGamePaths[gameId]
    if (!targetPath && !installedGameIds.includes(gameId)) {
      setInstalledGameIds((current) => current.filter((id) => id !== gameId))
      setInstalledGamePaths((current) => {
        const next = { ...current }
        delete next[gameId]
        return next
      })
      return
    }

    try {
      if (window.electronAPI?.uninstallGame) {
        const removed = await window.electronAPI.uninstallGame({ path: targetPath })
        if (!removed) {
          throw new Error('Unable to uninstall this game.')
        }
      }

      setInstalledGameIds((current) => current.filter((id) => id !== gameId))
      setInstalledGamePaths((current) => {
        const next = { ...current }
        delete next[gameId]
        return next
      })
      showNotification('Game uninstalled successfully.')
    } catch {
      showNotification('Unable to uninstall this game.')
    }
  }

  const toggleFavoriteGame = (gameId: string) => {
    setFavoriteGameIds((current) => current.includes(gameId)
      ? current.filter((id) => id !== gameId)
      : [...current, gameId])
  }

  const toggleWishlistGame = (gameId: string) => {
    setWishlistGameIds((current) => current.includes(gameId)
      ? current.filter((id) => id !== gameId)
      : [...current, gameId])
  }

  const toggleCartGame = (gameId: string) => {
    setCartGameIds((current) => current.includes(gameId)
      ? current.filter((id) => id !== gameId)
      : [...current, gameId])
  }

  const handleProfileFileUpload = async (event: React.ChangeEvent<HTMLInputElement>, kind: 'avatar' | 'cover') => {
    const file = event.target.files?.[0]
    if (!file) {
      return
    }

    try {
      const dataUrl = await readFileAsDataUrl(file)
      setProfileDraft((current) => ({
        ...current,
        ...(kind === 'avatar' ? { avatarUrl: dataUrl } : { coverUrl: dataUrl }),
      }))
      setPendingProfileImageEdits((current) => ({
        ...(current ?? {}),
        ...(kind === 'avatar' ? { avatarUrl: dataUrl } : { coverUrl: dataUrl }),
      }))
    } catch {
      showNotification('Unable to upload image.')
    } finally {
      event.target.value = ''
    }
  }

  const handleSaveProfileImageChanges = async () => {
    if (!user || !profile || !pendingProfileImageEdits) {
      return
    }

    try {
      const nextProfile: Profile = {
        ...profile,
        avatarUrl: pendingProfileImageEdits.avatarUrl ?? profile.avatarUrl ?? '',
        coverUrl: pendingProfileImageEdits.coverUrl ?? profile.coverUrl ?? '',
      }

      await updateDoc(doc(db, 'users', user.uid), {
        avatarUrl: nextProfile.avatarUrl,
        coverUrl: nextProfile.coverUrl,
      })

      setProfile(nextProfile)
      setProfileDraft((current) => ({
        ...current,
        avatarUrl: nextProfile.avatarUrl || '',
        coverUrl: nextProfile.coverUrl || '',
      }))
      setPendingProfileImageEdits(null)
      showNotification('Profile image updated.')
    } catch {
      showNotification('Unable to save profile image.')
    }
  }

  const handleResetProfileImageChanges = () => {
    setPendingProfileImageEdits(null)
    setProfileDraft((current) => ({
      ...current,
      avatarUrl: profile?.avatarUrl || '',
      coverUrl: profile?.coverUrl || '',
    }))
  }

  const resetPageScopedState = () => {
    setSelectedGame(null)
    setMediaViewer(null)
    setInstallModalGame(null)
    setShowCartPanel(false)
    setShowWishlistPanel(false)
    setShowNotificationsPanel(false)
    setShowFiltersPanel(false)
    setShowStoreFiltersPanel(false)
    setShowAccountMenu(false)
    setSearchQuery('')
    setSearchResults([])
    setFriendsSearchQuery('')
    setCommunityTab('friends')
    setViewProfileUid(null)
    setViewProfileData(null)
    setViewProfileFriends([])
    setFullProfileUid(null)
    setActiveChatId(null)
    setChatMessages([])
    setChatInput('')
    setActiveProfileTab('profile')
    setShowEditProfile(false)
    setPendingScreenshotUploads([])
    setPendingProfileImageEdits(null)
    setAdminMode('list')
    setEditingGameId(null)
    setError('')
  }

  const navigateWithProfileGuard = (nextPage: PageKey) => {
    if (pendingProfileImageEdits && page === 'profile' && nextPage !== 'profile') {
      setToastMessage('Please save or reset your profile image changes before leaving this page.')
      return
    }

    resetPageScopedState()
    setPageRefreshKey((current) => current + 1)
    setPage(nextPage)
  }

  const handleProfileScreenshotUpload = async (event: React.ChangeEvent<HTMLInputElement>) => {
    const files = Array.from(event.target.files ?? [])
    if (files.length === 0) {
      return
    }

    try {
      const urls = (await Promise.all(files.map((file) => readFileAsDataUrl(file, 1920, 1080))))
        .filter((url) => typeof url === 'string' && url.trim().length > 0)

      const withMeta = await Promise.all(urls.map(async (url) => ({
        url,
        meta: await readImageDimensions(url),
      })))

      const nextPending = Array.from(new Set([...pendingScreenshotUploads, ...withMeta.map((item) => item.url)]))
        .filter((image) => typeof image === 'string' && image.trim().length > 0)
        .slice(0, 12)

      setPendingScreenshotUploads(nextPending)
    } catch {
      showNotification('Unable to upload screenshots.')
    } finally {
      event.target.value = ''
    }
  }

  const publishPendingProfileScreenshots = async () => {
    if (!user) {
      return
    }

    const nextScreenshots = Array.from(new Set([...(profileDraft.screenshots || []), ...pendingScreenshotUploads]))
      .filter((image) => typeof image === 'string' && image.trim().length > 0)
      .slice(0, 12)

    try {
      await updateDoc(doc(db, 'users', user.uid), { screenshots: nextScreenshots })
      setProfileDraft((current) => ({ ...current, screenshots: nextScreenshots }))
      setProfile((current) => current ? { ...current, screenshots: nextScreenshots } : current)
      setPendingScreenshotUploads([])
      showNotification('Screenshots published.')
    } catch {
      showNotification('Unable to publish screenshots.')
    }
  }

  const discardPendingProfileScreenshots = () => {
    setPendingScreenshotUploads([])
  }

  const removeProfileScreenshot = (targetUrl: string) => {
    setPendingScreenshotUploads((current) => current.filter((image) => image !== targetUrl))
    setProfileDraft((current) => ({
      ...current,
      screenshots: current.screenshots.filter((image) => image !== targetUrl),
    }))
  }

  const handleSaveProfile = async () => {
    if (!user || !profile) {
      return
    }

    const mergedScreenshots = Array.from(new Set([...(profileDraft.screenshots || []), ...pendingScreenshotUploads]))
      .filter((image) => typeof image === 'string' && image.trim().length > 0)
      .slice(0, 12)
    const nextProfile: Profile = {
      ...profile,
      displayName: profileDraft.displayName.trim() || profile.displayName,
      bio: profileDraft.bio.trim() || 'No bio yet.',
      country: profileDraft.country.trim() || 'United States',
      city: profileDraft.city.trim(),
      avatarUrl: profileDraft.avatarUrl || '',
      coverUrl: profileDraft.coverUrl || '',
      screenshots: mergedScreenshots,
    }

    try {
      await updateDoc(doc(db, 'users', user.uid), {
          displayName: nextProfile.displayName,
          displayNameLower: nextProfile.displayName.toLowerCase(),
        bio: nextProfile.bio,
        country: nextProfile.country,
        city: nextProfile.city,
        avatarUrl: nextProfile.avatarUrl,
        coverUrl: nextProfile.coverUrl,
        screenshots: nextProfile.screenshots,
      })
      setProfile(nextProfile)
      setProfileDraft((current) => ({ ...current, screenshots: mergedScreenshots }))
      setPendingScreenshotUploads([])
      setShowEditProfile(false)
      showNotification('Profile updated successfully.')
    } catch {
      showNotification('Unable to update profile.')
    }
  }

  const visibleGames = useMemo(() => games.filter((game) => !game.hidden).slice(0, 8), [games])
  const libraryGames = useMemo(() => games.filter((game) => purchasedGameIds.includes(game.id) && !game.hidden), [games, purchasedGameIds])
  const storeGames = useMemo(() => games.filter((game) => !game.hidden), [games])
  const wishlistGames = useMemo(() => games.filter((game) => wishlistGameIds.includes(game.id) && !game.hidden), [games, wishlistGameIds])
  const cartGames = useMemo(() => games.filter((game) => cartGameIds.includes(game.id) && !game.hidden), [games, cartGameIds])
  const quickLaunchGames = useMemo(() => games.filter((game) => installedGameIds.includes(game.id) && !game.hidden), [games, installedGameIds])

  const [libraryFilters, setLibraryFilters] = useState({
    title: '',
    installedOnly: false,
    favoriteOnly: false,
    genre: 'All',
    platform: 'All',
  })

  const [storeFilters, setStoreFilters] = useState({
    title: '',
    installedOnly: false,
    favoriteOnly: false,
    genre: 'All',
    platform: 'All',
  })

  const availableGenres = useMemo(() => Array.from(new Set(games.map((game) => game.genre).filter(Boolean))), [games])
  const availablePlatforms = useMemo(() => Array.from(new Set(games.map((game) => game.platform).filter(Boolean))), [games])

  const filteredLibraryGames = useMemo(() => {
    const query = libraryFilters.title.trim().toLowerCase()

    return libraryGames.filter((game) => {
      if (query && !game.title.toLowerCase().includes(query)) {
        return false
      }

      if (libraryFilters.installedOnly && !installedGameIds.includes(game.id)) {
        return false
      }

      if (libraryFilters.favoriteOnly && !favoriteGameIds.includes(game.id)) {
        return false
      }

      if (libraryFilters.genre !== 'All' && game.genre !== libraryFilters.genre) {
        return false
      }

      if (libraryFilters.platform !== 'All' && game.platform !== libraryFilters.platform) {
        return false
      }

      return true
    })
  }, [libraryGames, installedGameIds, favoriteGameIds, libraryFilters])

  const filteredStoreGames = useMemo(() => {
    const query = storeFilters.title.trim().toLowerCase()

    return storeGames.filter((game) => {
      if (query && !game.title.toLowerCase().includes(query)) {
        return false
      }

      if (storeFilters.genre !== 'All' && game.genre !== storeFilters.genre) {
        return false
      }

      if (storeFilters.platform !== 'All' && game.platform !== storeFilters.platform) {
        return false
      }

      return true
    })
  }, [storeGames, storeFilters])

  const navLookup: Record<NavKey, PageKey> = {
    Home: 'home',
    Library: 'library',
    Store: 'store',
    Downloads: 'downloads',
    Profile: 'profile',
    Community: 'community',
    Settings: 'settings',
  }

  const renderGameDetailView = () => {
    if (!selectedGame) {
      return null
    }

    const screenshots = selectedGame.screenshots && selectedGame.screenshots.length > 0
      ? selectedGame.screenshots
      : [selectedGame.image]

    const trailerEmbed = selectedGame.trailerUrl
      ? selectedGame.trailerUrl.replace('watch?v=', 'embed/')
      : ''

    const detailStrings = launcherLanguage === 'ar'
      ? {
          back: 'رجوع',
          wishlist: 'قائمة الرغبات',
          installed: 'مثبت',
          owned: 'مملوك',
          get: 'احصل',
          overview: 'نظرة عامة',
          faq: 'الأسئلة الشائعة',
          achievements: 'الإنجازات',
          systemRequirements: 'متطلبات النظام',
          minimum: 'الحد الأدنى',
          recommended: 'الموصى به',
          notProvided: 'غير مذكور بعد.',
          baseGame: 'لعبة أساسية',
          genre: 'النوع',
          developer: 'المطور',
          publisher: 'الناشر',
          release: 'الإصدار',
          size: 'الحجم',
          platform: 'المنصة',
          addToCart: 'أضف إلى السلة',
          addedToCart: 'تمت الإضافة إلى السلة',
          buyNow: 'اشتري الآن',
          addFavorite: 'أضف إلى المفضلة',
          removeFavorite: 'إزالة من المفضلة',
          addWishlist: 'أضف إلى قائمة الرغبات',
          removeWishlist: 'إزالة من قائمة الرغبات',
        }
      : {
          back: 'Back',
          wishlist: 'Wishlist',
          installed: 'Installed',
          owned: 'Owned',
          get: 'Get',
          overview: 'Overview',
          faq: 'FAQ',
          achievements: 'Achievements',
          systemRequirements: 'System Requirements',
          minimum: 'Minimum',
          recommended: 'Recommended',
          notProvided: 'Not provided by admin yet.',
          baseGame: 'Base Game',
          genre: 'Genre',
          developer: 'Developer',
          publisher: 'Publisher',
          release: 'Release',
          size: 'Size',
          platform: 'Platform',
          addToCart: 'Add to Cart',
          addedToCart: 'Added to Cart',
          buyNow: 'Buy Now',
          addFavorite: 'Add to Favorite',
          removeFavorite: 'Remove Favorite',
          addWishlist: 'Add to Wishlist',
          removeWishlist: 'Remove from Wishlist',
        }

    return (
      <div className="space-y-6">
        <button
          type="button"
          onClick={() => setSelectedGame(null)}
          className="mb-2 inline-flex items-center gap-2 rounded-full border border-[#2a3446] bg-[#101821] px-3 py-1.5 text-sm font-medium text-[#dfe6f5]"
        >
          ← {detailStrings.back}
        </button>

        <div className="mb-4 flex items-center justify-between gap-4">
          <div>
            <h2 className="text-[42px] font-black tracking-[-0.06em] text-white">{selectedGame.title}</h2>
            <div className="mt-3 flex flex-wrap items-center gap-3 text-sm text-[#bbc7d8]">
              <span className="text-[#ffb3b3]">★★★★★</span>
              <span>4.6</span>
              <span>•</span>
              <span>{selectedGame.genre}</span>
              <span>•</span>
              <span>{selectedGame.platform}</span>
            </div>
          </div>
          <div className="hidden items-center gap-2 md:flex">
            <button type="button" className="rounded-full border border-[#2a3446] bg-[#101821] px-4 py-2 text-sm font-semibold text-white">{detailStrings.wishlist}</button>
            <button
              type="button"
              onClick={() => void handlePurchaseGame(selectedGame)}
              disabled={purchasedGameIds.includes(selectedGame.id) || installedGameIds.includes(selectedGame.id)}
              className={`rounded-xl px-5 py-3 text-sm font-bold ${installedGameIds.includes(selectedGame.id) ? 'bg-[#2a1717] text-[#ffd5d5]' : purchasedGameIds.includes(selectedGame.id) ? 'bg-[#201214] text-[#ffe0e0]' : 'bg-[#FB1818] text-[#140b0b]'}`}
            >
              {installedGameIds.includes(selectedGame.id) ? detailStrings.installed : purchasedGameIds.includes(selectedGame.id) ? detailStrings.owned : detailStrings.get}
            </button>
          </div>
        </div>

        <div className="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,1fr)_320px]">
          <div className="space-y-4">
            {trailerEmbed ? (
              <div className="overflow-hidden rounded-[22px] border border-[#2a3446] bg-[#0c1118] p-2">
                <div className="aspect-video overflow-hidden rounded-[18px]">
                  <iframe
                    src={trailerEmbed}
                    title={`${selectedGame.title} trailer`}
                    className="h-full w-full"
                    allow="autoplay; encrypted-media; picture-in-picture"
                    allowFullScreen
                  />
                </div>
              </div>
            ) : (
              <button
                type="button"
                onClick={() => setMediaViewer({ type: 'image', url: selectedGame.image, title: selectedGame.title })}
                className="block w-full overflow-hidden rounded-[22px] border border-[#2a3446] bg-[#0c1118] text-left"
              >
                <div className="aspect-[16/9] overflow-hidden">
                  <img src={selectedGame.image} alt={selectedGame.title} className="h-full w-full object-cover" />
                </div>
              </button>
            )}

            <div className="rounded-[22px] border border-[#2a3446] bg-[#0c1118] p-4">
              <div className="mb-3 flex items-center gap-3 text-xs uppercase tracking-[0.18em] text-[#8aa0be]">
                <span>{detailStrings.overview}</span>
                <span>{detailStrings.faq}</span>
                <span>{detailStrings.achievements}</span>
              </div>
              <div className="text-[16px] leading-7 text-[#dfe7f5]">{selectedGame.description}</div>
            </div>

            <div className="grid grid-cols-2 gap-3 md:grid-cols-4">
              {screenshots.map((screenshot, index) => (
                <button
                  key={`${selectedGame.id}-${index}`}
                  type="button"
                  onClick={() => setMediaViewer({ type: 'image', url: screenshot, title: `${selectedGame.title} screenshot ${index + 1}` })}
                  className="overflow-hidden rounded-[16px] border border-[#2a3446] bg-[#0c1118] text-left transition hover:border-[#FB1818]"
                >
                  <img src={screenshot} alt={`${selectedGame.title} screenshot ${index + 1}`} className="h-[150px] w-full object-cover" />
                </button>
              ))}
            </div>

            <div className="rounded-[22px] border border-[#2a3446] bg-[#0c1118] p-5">
              <h3 className="mb-5 text-[28px] font-black text-white">{detailStrings.systemRequirements}</h3>

              <div className="grid grid-cols-1 gap-8 md:grid-cols-2">
                <div>
                  <div className="mb-3 text-[20px] font-bold text-white">{detailStrings.minimum}</div>
                  <div className="whitespace-pre-line text-[15px] leading-7 text-[#dfe7f5]">
                    {selectedGame.requirements?.minimum || detailStrings.notProvided}
                  </div>
                </div>

                <div>
                  <div className="mb-3 text-[20px] font-bold text-white">{detailStrings.recommended}</div>
                  <div className="whitespace-pre-line text-[15px] leading-7 text-[#dfe7f5]">
                    {selectedGame.requirements?.recommended || detailStrings.notProvided}
                  </div>
                </div>
              </div>
            </div>
          </div>

          <aside className="rounded-[22px] border border-[#2a3446] bg-[#0c1118] p-4">
            <div className="mb-4 flex items-center justify-between gap-3">
              <button
                type="button"
                onClick={() => setMediaViewer({ type: 'image', url: selectedGame.image, title: selectedGame.title })}
                className="w-[110px] overflow-hidden rounded-[14px] border border-[#2a3446] bg-[#101826] text-left"
              >
                <img src={selectedGame.image} alt={selectedGame.title} className="h-[140px] w-full object-cover" />
              </button>
              <div className="text-left">
                <div className="text-[12px] uppercase tracking-[0.15em] text-[#98a8c4]">{detailStrings.baseGame}</div>
                <div className="mt-2 text-[28px] font-black text-white">{selectedGame.price}</div>
              </div>
            </div>

            <div className="space-y-3 text-sm text-[#dfe7f5]">
              <div className="flex items-center justify-between rounded-xl bg-[#151e2a] px-3 py-2">
                <span>{detailStrings.genre}</span>
                <span>{selectedGame.genre}</span>
              </div>
              <div className="flex items-center justify-between rounded-xl bg-[#151e2a] px-3 py-2">
                <span>{detailStrings.developer}</span>
                <span>{selectedGame.developer || 'Dreko Games'}</span>
              </div>
              <div className="flex items-center justify-between rounded-xl bg-[#151e2a] px-3 py-2">
                <span>{detailStrings.publisher}</span>
                <span>{selectedGame.publisher || 'Dreko Games'}</span>
              </div>
              <div className="flex items-center justify-between rounded-xl bg-[#151e2a] px-3 py-2">
                <span>{detailStrings.release}</span>
                <span>{selectedGame.releaseDate || 'N/A'}</span>
              </div>
              <div className="flex items-center justify-between rounded-xl bg-[#151e2a] px-3 py-2">
                <span>{detailStrings.size}</span>
                <span>{selectedGame.size}</span>
              </div>
              <div className="flex items-center justify-between rounded-xl bg-[#151e2a] px-3 py-2">
                <span>{detailStrings.platform}</span>
                <span>{selectedGame.platform}</span>
              </div>
            </div>

            <div className="mt-5 space-y-3">
              {selectedGame.price !== 'FREE' ? (
                <>
                  <button
                    type="button"
                    onClick={() => {
                      if (purchasedGameIds.includes(selectedGame.id) || installedGameIds.includes(selectedGame.id)) {
                        return
                      }
                      toggleCartGame(selectedGame.id)
                    }}
                    disabled={purchasedGameIds.includes(selectedGame.id) || installedGameIds.includes(selectedGame.id)}
                    className={`w-full rounded-xl px-4 py-3 text-base font-bold ${purchasedGameIds.includes(selectedGame.id) || installedGameIds.includes(selectedGame.id) ? 'cursor-not-allowed bg-[#201214] text-[#ffe0e0] opacity-75' : cartGameIds.includes(selectedGame.id) ? 'bg-[#2a1717] text-[#ffd5d5]' : 'bg-[#FB1818] text-[#140b0b]'}`}
                  >
                    {cartGameIds.includes(selectedGame.id) ? detailStrings.addedToCart : detailStrings.addToCart}
                  </button>
                  <button
                    type="button"
                    onClick={() => void handlePurchaseGame(selectedGame)}
                    disabled={purchasedGameIds.includes(selectedGame.id) || installedGameIds.includes(selectedGame.id)}
                    className={`w-full rounded-xl border px-4 py-3 text-base font-bold ${purchasedGameIds.includes(selectedGame.id) || installedGameIds.includes(selectedGame.id) ? 'border-[#2a1717] bg-[#201214] text-[#ffe0e0]' : 'border-[#ff8a8a] bg-[#1a0e12] text-[#ffd6d6]'}`}
                  >
                    {purchasedGameIds.includes(selectedGame.id) || installedGameIds.includes(selectedGame.id) ? detailStrings.owned : detailStrings.buyNow}
                  </button>
                </>
              ) : (
                <button
                  type="button"
                  onClick={() => void handlePurchaseGame(selectedGame)}
                  disabled={purchasedGameIds.includes(selectedGame.id)}
                  className={`w-full rounded-xl px-4 py-3 text-base font-bold ${purchasedGameIds.includes(selectedGame.id) ? 'bg-[#201214] text-[#ffe0e0]' : 'bg-[#FB1818] text-[#140b0b]'}`}
                >
                  {purchasedGameIds.includes(selectedGame.id) ? detailStrings.owned : detailStrings.get}
                </button>
              )}
              <button
                type="button"
                onClick={() => toggleFavoriteGame(selectedGame.id)}
                className={`w-full rounded-xl border px-4 py-3 text-base font-semibold ${favoriteGameIds.includes(selectedGame.id) ? 'border-[#FB1818] bg-[#301317] text-[#ffb3b3]' : 'border-[#2a3446] bg-[#101821] text-white'}`}
              >
                {favoriteGameIds.includes(selectedGame.id) ? detailStrings.removeFavorite : detailStrings.addFavorite}
              </button>
              <button
                type="button"
                onClick={() => toggleWishlistGame(selectedGame.id)}
                className={`w-full rounded-xl border px-4 py-3 text-base font-semibold ${wishlistGameIds.includes(selectedGame.id) ? 'border-[#FB1818] bg-[#1a0e12] text-[#ffb3b3]' : 'border-[#2a3446] bg-[#101821] text-white'}`}
              >
                {wishlistGameIds.includes(selectedGame.id) ? detailStrings.removeWishlist : detailStrings.addWishlist}
              </button>
            </div>
          </aside>
        </div>
      </div>
    )
  }

  useEffect(() => {
    setSelectedGame(null)
  }, [page])

  useEffect(() => {
    if (!Object.keys(installedGamePaths).length) {
      return
    }

    void syncInstalledState()
  }, [page])

  const renderMainView = () => {
    if (selectedGame) {
      return renderGameDetailView()
    }

    if (page === 'library') {
      return (
        <div className="space-y-6">
          <div className="flex items-center justify-between">
            <h2 className="text-[28px] font-black tracking-[-0.05em] text-white">{launcherLanguage === 'ar' ? 'المكتبة' : 'Library'}</h2>
            <div className="flex items-center gap-3">
              <button type="button" className="text-sm font-medium text-[#dfe6f5]">{launcherLanguage === 'ar' ? 'ترتيب: الكل' : 'Sort by: All'}</button>
              <button
                type="button"
                onClick={() => setShowFiltersPanel((value) => !value)}
                className="rounded-full border border-[#2a3446] bg-[#101821] px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.2em] text-[#dfe6f5]"
              >
                {launcherLanguage === 'ar' ? 'تصنيف' : 'Filters'}
              </button>
            </div>
          </div>

          <div className={`grid gap-6 ${showFiltersPanel ? 'grid-cols-[minmax(0,1fr)_280px]' : 'grid-cols-1'}`}>
            <div className="space-y-4">
              <div className="flex flex-wrap items-start gap-4">
                {filteredLibraryGames.length > 0 ? (
                  filteredLibraryGames.map((game) => (
                    <div key={game.id} className="h-[430px] w-[240px] overflow-hidden rounded-[20px] border border-[#171d2b] bg-[#070c13]">
                      <button
                        type="button"
                        onClick={() => {
                          if (isGameDownloadLocked(game.id)) {
                            showNotification('This game is already downloading.')
                            return
                          }
                          setInstallModalGame(game)
                        }}
                        className="block w-full text-left"
                      >
                        <div className="game-cover-wrap h-[320px]">
                          <img src={game.image} alt={game.title} className="game-cover" />
                        </div>
                      </button>
                      <div className="flex h-[110px] flex-col justify-between px-4 pb-4 pt-3">
                        <button
                          type="button"
                          onClick={() => {
                            if (isGameDownloadLocked(game.id)) {
                              showNotification('This game is already downloading.')
                              return
                            }
                            setInstallModalGame(game)
                          }}
                          className="w-full text-left"
                        >
                          <div className="truncate text-[13px] font-bold text-white">{game.title}</div>
                        </button>
                        <div className="mt-2 flex items-center justify-between gap-2 text-[12px] text-[#adb8c8]">
                          <span className="inline-flex items-center gap-2">
                            <span className="inline-block h-2 w-2 rounded-full bg-[#FB1818]" />
                            {game.status}
                          </span>
                          {installedGameIds.includes(game.id) ? (
                            <div className="flex items-center gap-2">
                              <span className="rounded-full border border-[#28563c] bg-[#102a1d] px-2 py-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-[#9ae6b4]">{launcherLanguage === 'ar' ? 'مثبت' : 'Installed'}</span>
                              <button type="button" onClick={() => void handleOpenGame(game.id)} className="rounded-md border border-[#2a3446] bg-[#1a202b] px-2 py-1 text-xs font-semibold text-white">{launcherLanguage === 'ar' ? 'تشغيل' : 'Play'}</button>
                              <button type="button" onClick={() => void handleUninstallGame(game.id)} className="rounded-md border border-red-500/40 bg-red-500/10 px-2 py-1 text-xs font-semibold text-red-200">{launcherLanguage === 'ar' ? 'إلغاء التثبيت' : 'Uninstall'}</button>
                            </div>
                          ) : (
                            <span className="font-bold text-[#FB1818]">{game.price === 'FREE' ? 'Free' : game.price}</span>
                          )}
                        </div>
                        <div className="mt-2 flex justify-end">
                          <button
                            type="button"
                            onClick={() => toggleFavoriteGame(game.id)}
                            className={`rounded-md border px-2 py-1 text-[10px] font-bold uppercase tracking-[0.12em] ${favoriteGameIds.includes(game.id) ? 'border-[#FB1818] bg-[#301317] text-[#ffb3b3]' : 'border-[#2a3446] bg-[#101821] text-[#dfe7f5]'}`}
                            aria-label={favoriteGameIds.includes(game.id) ? 'Remove from favorites' : 'Add to favorites'}
                          >
                            {favoriteGameIds.includes(game.id) ? (launcherLanguage === 'ar' ? '♥ مفضلة' : '♥ Favorite') : (launcherLanguage === 'ar' ? '♡ مفضلة' : '♡ Favorite')}
                          </button>
                        </div>
                      </div>
                    </div>
                  ))
                ) : (
                  <div className="col-span-full rounded-[20px] border border-dashed border-[#2a3345] bg-[#0b1018] p-10 text-center text-[#aab6c9]">
                    {launcherLanguage === 'ar' ? 'لا توجد ألعاب مضافة بعد.' : 'No games added yet.'}
                  </div>
                )}
              </div>
            </div>

            {showFiltersPanel ? (
              <aside className="rounded-[20px] border border-[#1c2432] bg-[#0a0f17] p-4">
                <div className="mb-4 flex items-center justify-between">
                  <div className="text-[14px] font-bold uppercase tracking-[0.2em] text-[#dfe6f5]">{launcherLanguage === 'ar' ? 'تصنيف' : 'Filters'}</div>
                  <button type="button" onClick={() => setShowFiltersPanel(false)} className="text-xl text-[#dfe6f5]">×</button>
                </div>
                <div className="space-y-3">
                  <input
                    value={libraryFilters.title}
                    onChange={(event) => setLibraryFilters((current) => ({ ...current, title: event.target.value }))}
                    className="w-full rounded-xl border border-[#2a3446] bg-[#111923] px-3 py-2.5 text-sm text-white placeholder:text-[#7f8aa1]"
                    placeholder={launcherLanguage === 'ar' ? 'العنوان' : 'Title'}
                  />

                  <label className="flex items-center justify-between rounded-xl border border-[#2a3446] bg-[#111923] px-3 py-2.5 text-sm text-[#dfe6f5]">
                    <span>{launcherLanguage === 'ar' ? 'مثبت' : 'Installed'}</span>
                    <input
                      type="checkbox"
                      checked={libraryFilters.installedOnly}
                      onChange={(event) => setLibraryFilters((current) => ({ ...current, installedOnly: event.target.checked }))}
                      className="h-4 w-4 accent-[#FB1818]"
                    />
                  </label>

                  <label className="flex items-center justify-between rounded-xl border border-[#2a3446] bg-[#111923] px-3 py-2.5 text-sm text-[#dfe6f5]">
                    <span>{launcherLanguage === 'ar' ? 'مفضلة' : 'Favorite'}</span>
                    <input
                      type="checkbox"
                      checked={libraryFilters.favoriteOnly}
                      onChange={(event) => setLibraryFilters((current) => ({ ...current, favoriteOnly: event.target.checked }))}
                      className="h-4 w-4 accent-[#FB1818]"
                    />
                  </label>

                  <select
                    value={libraryFilters.genre}
                    onChange={(event) => setLibraryFilters((current) => ({ ...current, genre: event.target.value }))}
                    className="w-full rounded-xl border border-[#2a3446] bg-[#111923] px-3 py-2.5 text-sm text-[#dfe6f5]"
                  >
                    <option value="All">{launcherLanguage === 'ar' ? 'النوع' : 'Genre'}</option>
                    {availableGenres.map((genre) => (
                      <option key={genre} value={genre}>{genre}</option>
                    ))}
                  </select>

                  <select
                    value={libraryFilters.platform}
                    onChange={(event) => setLibraryFilters((current) => ({ ...current, platform: event.target.value }))}
                    className="w-full rounded-xl border border-[#2a3446] bg-[#111923] px-3 py-2.5 text-sm text-[#dfe6f5]"
                  >
                    <option value="All">{launcherLanguage === 'ar' ? 'المنصة' : 'Platform'}</option>
                    {availablePlatforms.map((platform) => (
                      <option key={platform} value={platform}>{platform}</option>
                    ))}
                  </select>

                  <button
                    type="button"
                    onClick={() => setLibraryFilters({ title: '', installedOnly: false, favoriteOnly: false, genre: 'All', platform: 'All' })}
                    className="w-full rounded-xl border border-[#2a3446] bg-[#101821] px-3 py-2.5 text-sm font-semibold text-[#dfe6f5]"
                  >
                    {launcherLanguage === 'ar' ? 'مسح' : 'Clear'}
                  </button>
                </div>
              </aside>
            ) : null}
          </div>
        </div>
      )
    }

    if (page === 'store') {
      return (
        <div className="space-y-6">
          <div className="flex items-center justify-between">
            <h2 className="text-[28px] font-black tracking-[-0.05em] text-white">{launcherLanguage === 'ar' ? 'المتجر' : 'Store'}</h2>
            <button
              type="button"
              onClick={() => setShowStoreFiltersPanel((value) => !value)}
              className="rounded-full border border-[#2a3446] bg-[#101821] px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.2em] text-[#dfe6f5]"
            >
              {launcherLanguage === 'ar' ? 'تصنيف' : 'Filters'}
            </button>
          </div>

          <div className={`grid gap-6 ${showStoreFiltersPanel ? 'grid-cols-[minmax(0,1fr)_280px]' : 'grid-cols-1'}`}>
            <div className="space-y-4">
              <div className="flex flex-wrap items-start gap-4">
                {filteredStoreGames.length > 0 ? (
                  filteredStoreGames.map((game) => (
                    <div key={game.id} className="h-[430px] w-[240px] overflow-hidden rounded-[20px] border border-[#1d2330] bg-[#0b1018] p-0">
                      <div className="relative">
                        <button type="button" onClick={() => setSelectedGame(game)} className="block w-full text-left">
                          <div className="game-cover-wrap store-cover h-[320px]">
                            <img src={game.image} alt={game.title} className="game-cover" />
                          </div>
                        </button>
                        <button
                          type="button"
                          onClick={() => toggleWishlistGame(game.id)}
                          className={`absolute right-3 top-3 rounded-full border px-2.5 py-1.5 text-[10px] font-bold uppercase tracking-[0.12em] ${wishlistGameIds.includes(game.id) ? 'border-[#FB1818] bg-[#180d11] text-[#ffb3b3]' : 'border-[#2a3446] bg-[#101821]/90 text-[#f3f7ff]'}`}
                          aria-label={wishlistGameIds.includes(game.id) ? 'Remove from wishlist' : 'Add to wishlist'}
                        >
                          {wishlistGameIds.includes(game.id) ? (launcherLanguage === 'ar' ? 'مُرغَب' : 'Wishlisted') : (launcherLanguage === 'ar' ? 'الرغبات' : 'Wishlist')}
                        </button>
                      </div>
                      <div className="flex h-[110px] flex-col justify-between px-4 pb-4 pt-3">
                        <div className="flex items-center justify-between gap-2">
                          <button type="button" onClick={() => setSelectedGame(game)} className="text-left">
                            <h3 className="text-lg font-bold text-white">{game.title}</h3>
                          </button>
                        </div>
                        <div className="mt-3 flex items-center justify-between text-[11px] text-[#a3afc3]">
                          <span>{game.version}</span>
                          {purchasedGameIds.includes(game.id) && (
                            <span className="rounded-full border border-[#542d2d] bg-[#201214] px-2 py-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-[#ffc1c1]">{launcherLanguage === 'ar' ? 'مملوك' : 'Owned'}</span>
                          )}
                        </div>
                        <div className="mt-2 text-sm font-bold text-[#FB1818]">{game.price === 'FREE' ? (launcherLanguage === 'ar' ? 'مجاني' : 'Free') : game.price}</div>
                      </div>
                    </div>
                  ))
                ) : (
                  <div className="col-span-full rounded-[20px] border border-dashed border-[#2a3345] bg-[#0b1018] p-10 text-center text-[#aab6c9]">
                    {launcherLanguage === 'ar' ? 'لايوجد لعبه بي هدا الاسم في المتجر' : 'There is no game with this name in the store'}
                  </div>
                )}
              </div>
            </div>

            {showStoreFiltersPanel ? (
              <aside className="rounded-[20px] border border-[#1c2432] bg-[#0a0f17] p-4">
                <div className="mb-4 flex items-center justify-between">
                  <div className="text-[14px] font-bold uppercase tracking-[0.2em] text-[#dfe6f5]">{launcherLanguage === 'ar' ? 'تصنيف' : 'Filters'}</div>
                  <button type="button" onClick={() => setShowStoreFiltersPanel(false)} className="text-xl text-[#dfe6f5]">×</button>
                </div>
                <div className="space-y-3">
                  <input
                    value={storeFilters.title}
                    onChange={(event) => setStoreFilters((current) => ({ ...current, title: event.target.value }))}
                    className="w-full rounded-xl border border-[#2a3446] bg-[#111923] px-3 py-2.5 text-sm text-white placeholder:text-[#7f8aa1]"
                    placeholder={launcherLanguage === 'ar' ? 'العنوان' : 'Title'}
                  />

                  <select
                    value={storeFilters.genre}
                    onChange={(event) => setStoreFilters((current) => ({ ...current, genre: event.target.value }))}
                    className="w-full rounded-xl border border-[#2a3446] bg-[#111923] px-3 py-2.5 text-sm text-[#dfe6f5]"
                  >
                    <option value="All">{launcherLanguage === 'ar' ? 'النوع' : 'Genre'}</option>
                    {availableGenres.map((genre) => (
                      <option key={genre} value={genre}>{genre}</option>
                    ))}
                  </select>

                  <select
                    value={storeFilters.platform}
                    onChange={(event) => setStoreFilters((current) => ({ ...current, platform: event.target.value }))}
                    className="w-full rounded-xl border border-[#2a3446] bg-[#111923] px-3 py-2.5 text-sm text-[#dfe6f5]"
                  >
                    <option value="All">{launcherLanguage === 'ar' ? 'المنصة' : 'Platform'}</option>
                    {availablePlatforms.map((platform) => (
                      <option key={platform} value={platform}>{platform}</option>
                    ))}
                  </select>

                  <button
                    type="button"
                    onClick={() => setStoreFilters({ title: '', installedOnly: false, favoriteOnly: false, genre: 'All', platform: 'All' })}
                    className="w-full rounded-xl border border-[#2a3446] bg-[#101821] px-3 py-2.5 text-sm font-semibold text-[#dfe6f5]"
                  >
                    {launcherLanguage === 'ar' ? 'مسح' : 'Clear'}
                  </button>
                </div>
              </aside>
            ) : null}
          </div>
        </div>
      )
    }

    if (page === 'downloads') {
      return (
        <div className="space-y-6">
          <div className="flex items-center justify-between gap-3">
            <h2 className="text-[28px] font-bold text-white">{launcherLanguage === 'ar' ? 'التنزيلات' : 'Downloads'}</h2>
            <div className="flex items-center gap-3">
              <button
                type="button"
                onClick={() => void triggerSpeedTest()}
                className="rounded-xl border border-[#FB1818] bg-[#160d0d] px-4 py-2 text-xs font-bold uppercase tracking-[0.12em] text-[#ffb4b4]"
              >
                {launcherLanguage === 'ar' ? 'اختبار السرعة' : 'Test Speed'}
              </button>
              {!isElectron && (
                <div className="rounded-md border border-yellow-600 bg-yellow-800/10 px-3 py-2 text-sm text-yellow-300">{launcherLanguage === 'ar' ? 'هذه الواجهة لا تعمل داخل غلاف Electron المكتبي. التنزيلات المكتبية معطلة.' : 'This UI is not running inside the Electron desktop shell. Desktop downloads are disabled.'}</div>
              )}
            </div>
          </div>

          {networkSpeed && (
            <div className="rounded-[18px] border border-[#1f3244] bg-[#0c1520] p-4">
              <div className="flex items-start justify-between gap-3">
                <div>
                  <div className="text-[11px] uppercase tracking-[0.18em] text-[#FB1818]">{launcherLanguage === 'ar' ? 'سرعة الشبكة الحالية' : 'Current network speed'}</div>
                  <div className="mt-2 text-[24px] font-black text-white">{networkSpeed.label}</div>
                </div>
                <button
                  type="button"
                  onClick={() => setNetworkSpeed(null)}
                  aria-label="Close network speed panel"
                  className="flex h-8 w-8 items-center justify-center rounded-full border border-[#2a3446] bg-[#101821] text-lg font-bold text-[#dfe7f5] hover:text-red-200"
                >
                  ×
                </button>
              </div>
            </div>
          )}

          {downloadHistory.length === 0 ? (
            <div className="rounded-[22px] border border-dashed border-[#2a3345] bg-[#0b1018] p-10 text-center text-[#aab6c9]">
              {launcherLanguage === 'ar' ? 'لا توجد تنزيلات بعد.' : 'No downloads yet.'}
            </div>
          ) : (
            <div className="space-y-3">
              {downloadHistory.map((item) => (
                <div key={item.id} className="rounded-[20px] border border-[#1d2330] bg-[#0b1018] p-4">
                  <div className="flex items-start justify-between gap-3">
                    <div>
                      <div className="text-[18px] font-bold text-white">{item.title}</div>
                      <div className="mt-1 text-xs uppercase tracking-[0.18em] text-[#9aa9bf]">{item.fileName}</div>
                    </div>
                    <div className="flex items-center gap-2">
                      <span className={`rounded-full px-2 py-1 text-[10px] font-bold uppercase tracking-[0.14em] ${
                        item.status === 'completed' ? 'bg-[#133828] text-[#8ee6b3]' :
                        item.status === 'downloading' ? 'bg-[#1d2d48] text-[#8bbafc]' :
                        item.status === 'cancelled' ? 'bg-[#3a2d28] text-[#f3b48a]' :
                        item.status === 'failed' ? 'bg-[#361b1d] text-[#f29aa1]' : 'bg-[#1f2836] text-[#cfe0ff]'
                      }`}>
                        {getDownloadStatusLabel(item.status, launcherLanguage) }
                      </span>
                      <button
                        type="button"
                        onClick={() => removeDownloadFromList(item.id)}
                        aria-label={`Remove ${item.title} from downloads`}
                        className="flex h-8 w-8 items-center justify-center rounded-full border border-[#2a3446] bg-[#101821] text-lg font-bold text-[#dfe7f5] transition hover:border-red-500/50 hover:text-red-200"
                      >
                        ×
                      </button>
                    </div>
                  </div>

                  <div className="mt-4 space-y-2">
                    <div className="flex justify-between text-[12px] text-[#dfe7f5]">
                      <span>
                        {item.status === 'completed' && item.total > 0
                          ? `${formatBytes(item.downloaded)} / ${formatBytes(item.total)}`
                          : item.status === 'downloading' && item.total > 0
                            ? `${formatBytes(item.downloaded)} / ${formatBytes(item.total)}`
                            : item.status === 'queued'
                              ? (launcherLanguage === 'ar' ? 'بانتظار البدء' : 'Waiting to start')
                              : item.status === 'cancelled'
                                ? (launcherLanguage === 'ar' ? 'تم الإلغاء قبل الاكتمال' : 'Cancelled before completion')
                                : item.status === 'failed'
                                  ? (launcherLanguage === 'ar' ? 'فشل التنزيل' : 'Download failed')
                                  : (launcherLanguage === 'ar' ? 'بانتظار حجم الملف' : 'Waiting for file size')}
                      </span>
                      <span>
                        {item.status === 'completed'
                          ? '100%'
                          : item.status === 'downloading' || item.status === 'queued'
                            ? `${Math.round(item.progress || 0)}%`
                            : '0%'}
                      </span>
                    </div>
                    <div className="h-2 overflow-hidden rounded-full bg-[#101922]">
                      <div
                        className="h-full rounded-full bg-gradient-to-r from-[#FB1818] to-[#ff7a7a] transition-[width] duration-200"
                        style={{ width: `${item.status === 'completed' ? 100 : Math.min(100, Math.max(0, item.progress || 0))}%` }}
                      />
                    </div>
                    <div className="flex justify-between text-[11px] text-[#9aa9bf]">
                      <span>{item.status === 'downloading' ? (item.speed > 0 ? `${formatBytes(item.speed)}/s` : (launcherLanguage === 'ar' ? 'جارٍ فحص السرعة...' : 'Checking speed...')) : item.status === 'completed' ? (launcherLanguage === 'ar' ? 'تم التحقق' : 'Verified') : item.status === 'queued' ? (launcherLanguage === 'ar' ? 'في قائمة الانتظار' : 'Queued') : item.status === 'cancelled' ? (launcherLanguage === 'ar' ? 'ملغي' : 'Cancelled') : item.status === 'failed' ? (launcherLanguage === 'ar' ? 'فشل' : 'Failed') : (launcherLanguage === 'ar' ? 'بانتظار...' : 'Waiting...')}</span>
                      <span>{item.status === 'completed' ? (launcherLanguage === 'ar' ? 'مكتمل' : 'Completed') : item.status === 'cancelled' ? (launcherLanguage === 'ar' ? 'ملغي' : 'Cancelled') : item.status === 'failed' ? (launcherLanguage === 'ar' ? 'فشل' : 'Failed') : item.status === 'downloading' ? formatDuration(item.eta) : (launcherLanguage === 'ar' ? 'في قائمة الانتظار' : 'Queued')}</span>
                    </div>
                  </div>

                  {(item.status === 'downloading' || item.status === 'queued' || item.status === 'paused') && (
                    <div className="mt-3 flex items-center justify-between gap-3 rounded-xl border border-red-500/20 bg-red-500/5 px-3 py-2">
                      <span className="text-[11px] font-semibold uppercase tracking-[0.14em] text-red-200">{launcherLanguage === 'ar' ? 'عناصر التحكم في التنزيل' : 'Download controls'}</span>
                      <div className="flex items-center gap-2">
                        {item.status === 'downloading' && (
                          <button type="button" onClick={() => void handlePauseDownload(item.id)} className="rounded-lg border border-yellow-400/30 bg-yellow-600/10 px-3 py-2 text-[11px] font-bold uppercase tracking-[0.12em] text-yellow-200">{launcherLanguage === 'ar' ? 'إيقاف مؤقت' : 'Pause'}</button>
                        )}
                        {item.status === 'paused' && (
                          <button type="button" onClick={() => void handleResumeDownload(item.id)} className="rounded-lg border border-emerald-400/30 bg-emerald-600/10 px-3 py-2 text-[11px] font-bold uppercase tracking-[0.12em] text-emerald-200">{launcherLanguage === 'ar' ? 'استمرار' : 'Resume'}</button>
                        )}
                        <button type="button" onClick={() => void handleCancelDownload(item.id)} className="rounded-lg border border-red-500/40 bg-red-500/10 px-3 py-2 text-[11px] font-bold uppercase tracking-[0.12em] text-red-200">{launcherLanguage === 'ar' ? 'إلغاء' : 'Cancel'}</button>
                      </div>
                    </div>
                  )}
                  {item.status === 'completed' && installedGamePaths[item.id] && (
                    <div className="mt-3 flex justify-end">
                      <button type="button" onClick={() => void handleOpenGame(item.id)} className="rounded-md border border-[#2a3446] bg-[#1a202b] px-3 py-2 text-[12px] font-bold text-white">{launcherLanguage === 'ar' ? 'فتح المجلد' : 'Open Folder'}</button>
                    </div>
                  )}
                </div>
              ))}
            </div>
          )}
        </div>
      )
    }

    if (page === 'profile') {
      // If viewing another user's profile in full page, prefer viewProfileData/friends
      const viewingOther = !!fullProfileUid
      const activeProfile = viewingOther ? viewProfileData : profile
      const activeFriends = viewingOther ? viewProfileFriends : friends
      const activeProfileOwnedIds = viewingOther
        ? (Array.isArray(viewProfileData?.ownedGames) ? viewProfileData.ownedGames : [])
        : [...new Set([...purchasedGameIds, ...installedGameIds])]
      const activeProfileInventoryGames = games.filter((game) => activeProfileOwnedIds.includes(game.id) && !game.hidden)
      const recentActivityGames = activeProfileInventoryGames.slice(0, 3)
      const previewedProfile = !viewingOther
        ? {
            ...(activeProfile ?? {}),
            ...profileDraft,
            displayName: profileDraft.displayName || activeProfile?.displayName || 'Dreko User',
            avatarUrl: pendingProfileImageEdits?.avatarUrl ?? profileDraft.avatarUrl ?? activeProfile?.avatarUrl ?? '',
            coverUrl: pendingProfileImageEdits?.coverUrl ?? profileDraft.coverUrl ?? activeProfile?.coverUrl ?? '',
            screenshots: Array.isArray(profileDraft.screenshots) && profileDraft.screenshots.length > 0
              ? profileDraft.screenshots.filter((image) => typeof image === 'string' && image.trim().length > 0)
              : Array.isArray(activeProfile?.screenshots)
                ? activeProfile.screenshots.filter((image: unknown) => typeof image === 'string' && image.trim().length > 0)
                : [],
          }
        : activeProfile
      const activeProfileUid = activeProfile?.uid
      const currentUserFriendIds = new Set((friends || []).map((friend) => friend.id))
      const isCurrentProfileBlocked = Boolean(user && activeProfileUid && isUserBlocked(activeProfileUid))
      const isCurrentProfileFriend = Boolean(user && activeProfileUid && currentUserFriendIds.has(activeProfileUid))
      const outgoingFriendRequestForProfile = user && activeProfileUid
        ? pendingRequests.find((request) => request.from === user.uid && request.to === activeProfileUid)
        : undefined
      const incomingFriendRequestForProfile = user && activeProfileUid
        ? pendingRequests.find((request) => request.to === user.uid && request.from === activeProfileUid)
        : undefined
      const canAddCurrentProfile = Boolean(
        user &&
        activeProfileUid &&
        activeProfileUid !== user.uid &&
        !isCurrentProfileFriend &&
        !isCurrentProfileBlocked &&
        !outgoingFriendRequestForProfile &&
        !incomingFriendRequestForProfile,
      )
      const ownedCount = activeProfileOwnedIds.length
      const friendsCount = activeFriends.length
      const gamesCount = activeProfileInventoryGames.length
      const profileName = previewedProfile?.displayName || 'Dreko User'
      const profileBio = previewedProfile?.bio || (launcherLanguage === 'ar' ? 'لا توجد سيرة بعد.' : 'No bio yet.')
      const profileCity = previewedProfile?.city || ''
      const profileCountry = previewedProfile?.country || (launcherLanguage === 'ar' ? 'الولايات المتحدة' : 'United States')
      const profileAvatar = previewedProfile?.avatarUrl || ''
      const profileCover = previewedProfile?.coverUrl || ''
      const profileScreenshots = Array.from(new Set([
        ...(Array.isArray(previewedProfile?.screenshots) ? previewedProfile.screenshots.filter((image: unknown) => typeof image === 'string' && image.trim().length > 0) : []),
        ...(!viewingOther ? pendingScreenshotUploads : []),
      ])).slice(0, 12)
      const visibleProfileFriends: Array<{ id: string; name: string; avatarUrl: string; status: string; color: string }> = activeFriends.map((friend) => ({
        id: friend.id,
        name: String(friend.name || 'Player'),
        avatarUrl: 'avatarUrl' in friend ? String(friend.avatarUrl || '') : '',
        status: 'status' in friend ? String(friend.status || 'Offline') : 'Offline',
        color: 'color' in friend ? String(friend.color || 'bg-[#9aa5b5]') : 'bg-[#9aa5b5]',
      }))
      const tabs = [
        { key: 'profile', label: launcherLanguage === 'ar' ? 'البروفايل' : 'Profile' },
        { key: 'inventory', label: launcherLanguage === 'ar' ? 'المخزون' : 'Inventory' },
        { key: 'screenshots', label: launcherLanguage === 'ar' ? 'الصور' : 'Screenshots' },
      ] as const

      return (
        <div className="space-y-6">
          <div className="overflow-hidden rounded-[28px] border border-[#1d2330] bg-[#0b1018] shadow-[0_0_35px_rgba(0,0,0,0.25)]">
            <div className="relative h-[220px] overflow-hidden bg-[radial-gradient(circle_at_50%_20%,rgba(251,24,24,0.45),transparent_24%),linear-gradient(180deg,#090d13_0%,#101821_100%)]">
              <div className="group absolute inset-0">
                {profileCover ? <img src={profileCover} alt="Profile cover" className="h-full w-full object-cover opacity-80" /> : <div className="h-full w-full bg-[linear-gradient(90deg,rgba(0,0,0,0.48),transparent_30%,transparent_70%,rgba(0,0,0,0.5))]" />}
                <div className="absolute inset-0 bg-[linear-gradient(90deg,rgba(0,0,0,0.48),transparent_30%,transparent_70%,rgba(0,0,0,0.5))]" />
                {!viewingOther && (
                  <>
                    <button
                      type="button"
                      onClick={() => profileCoverInputRef.current?.click()}
                      className="absolute left-4 top-4 flex h-10 w-10 items-center justify-center rounded-full bg-[#1b2330]/90 text-lg text-white opacity-0 shadow-lg transition group-hover:opacity-100 hover:bg-[#2a3446]"
                      aria-label="Change cover photo"
                    >
                      ✎
                    </button>
                    <input ref={profileCoverInputRef} type="file" accept="image/*" className="hidden" onChange={(event) => {
                      const file = event.target.files?.[0]
                      if (file) {
                        void handleProfileFileUpload(event, 'cover')
                      }
                    }} />
                  </>
                )}
              </div>
              <div className="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-[#0b1018] to-transparent" />

              {viewingOther && (
                <div className="absolute right-6 top-6 z-10">
                  <button
                    type="button"
                    onClick={() => {
                      if (pendingProfileImageEdits && page === 'profile') {
                        setToastMessage('Please save or reset your profile image changes before leaving this page.')
                        return
                      }
                      setFullProfileUid(null)
                      setViewProfileUid(null)
                      setViewProfileData(null)
                      setViewProfileFriends([])
                      setPage('home')
                    }}
                    className="rounded-lg border border-[#2a3446] bg-[#101821] px-3 py-2 text-[11px] font-bold uppercase tracking-[0.12em] text-[#dfe6f5]"
                  >
                    {launcherLanguage === 'ar' ? 'رجوع' : 'Back'}
                  </button>
                </div>
              )}

              {!viewingOther && (
                <div className="absolute right-6 top-6 z-10">
                  <button type="button" onClick={() => setShowEditProfile(true)} className="rounded-lg border border-[#2a3446] bg-[#101821] px-3 py-2 text-[11px] font-bold uppercase tracking-[0.12em] text-[#dfe6f5]">{launcherLanguage === 'ar' ? 'تعديل الملف الشخصي' : 'Edit Profile'}</button>
                </div>
              )}

              <div className="absolute bottom-4 left-6 flex items-center gap-4">
                {!viewingOther ? (
                  <div className="group relative flex h-24 w-24 items-center justify-center overflow-hidden rounded-full border-4 border-[#0d1118] bg-gradient-to-br from-[#ffb1b1] to-[#7a2d2d] text-[26px] font-black text-[#090b11] shadow-[0_0_30px_rgba(251,24,24,0.35)]">
                    {profileAvatar ? <img src={profileAvatar} alt="Profile avatar" className="h-full w-full object-cover" /> : profileName.slice(0, 2).toUpperCase()}
                    <button
                      type="button"
                      onClick={() => profileAvatarInputRef.current?.click()}
                    className="absolute inset-0 flex items-center justify-center rounded-full bg-black/35 text-lg text-white opacity-0 shadow-lg transition group-hover:opacity-100 hover:scale-105"
                      aria-label="Change profile photo"
                    >
                    <span className="flex h-9 w-9 items-center justify-center rounded-full bg-[#FB1818]">✎</span>
                    </button>
                    <input ref={profileAvatarInputRef} type="file" accept="image/*" className="hidden" onChange={(event) => {
                      const file = event.target.files?.[0]
                      if (file) {
                      void handleProfileFileUpload(event, 'avatar')
                      }
                  }} />
                  </div>
                ) : (
                  <div className="flex h-24 w-24 items-center justify-center overflow-hidden rounded-full border-4 border-[#0d1118] bg-gradient-to-br from-[#ffb1b1] to-[#7a2d2d] text-[26px] font-black text-[#090b11] shadow-[0_0_30px_rgba(251,24,24,0.35)]">
                    {profileAvatar ? <img src={profileAvatar} alt="Profile avatar" className="h-full w-full object-cover" /> : profileName.slice(0, 2).toUpperCase()}
                  </div>
                )}
                <div className="self-center">
                  <div className="text-[28px] font-black tracking-[-0.04em] text-white">{profileName}</div>
                  {viewingOther && (
                    <div className="mt-2 flex flex-wrap items-center gap-2">
                      {outgoingFriendRequestForProfile ? (
                        <button
                          type="button"
                          onClick={() => void cancelPendingFriendRequest(activeProfileUid || '')}
                          className="rounded-md border border-[#ffd166] bg-[#2a2418] px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.14em] text-[#f8d27a]"
                        >
                        {launcherLanguage === 'ar' ? 'طلب معلّق' : 'Pending Request'}
                        </button>

                      ) : canAddCurrentProfile ? (                        <button
                          type="button"
                          onClick={() => {
                            if (!user || !activeProfileUid || activeProfileUid === user.uid) {
                              setToastMessage('Choose a friend to add.')
                              return
                            }
                            void handleSendFriendRequest(activeProfileUid)
                          }}
                          className="rounded-md bg-[#32d583] px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.14em] text-[#0b1b12]"
                        >
                          {launcherLanguage === 'ar' ? 'إضافة صديق' : 'Add Friend'}
                        </button>
                      ) : incomingFriendRequestForProfile ? (
                        <>
                          <button
                            type="button"
                            onClick={() => void handleAcceptRequest(incomingFriendRequestForProfile.id)}
                            className="rounded-md bg-[#32d583] px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.14em] text-[#0b1b12]"
                          >
                            {launcherLanguage === 'ar' ? 'قبول' : 'Accept'}
                          </button>
                          <button
                            type="button"
                            onClick={() => void handleRejectRequest(incomingFriendRequestForProfile.id)}
                            className="rounded-md border border-[#2a3446] bg-[#101821] px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.14em] text-white"
                          >
                            {launcherLanguage === 'ar' ? 'رفض' : 'Reject'}
                          </button>
                        </>
                      ) : null}
                      {!user || !activeProfileUid || activeProfileUid === user.uid ? null : (
                        <>
                          {isCurrentProfileFriend && (
                            <button
                              type="button"
                              onClick={() => void handleUnfriendUser(activeProfileUid)}
                              className="rounded-md border border-[#ff8f6b] bg-[#1f1714] px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.14em] text-[#ffd7c9]"
                            >
                              {launcherLanguage === 'ar' ? 'إلغاء صداقة' : 'Unfriend'}
                            </button>
                          )}
                          <button
                            type="button"
                            onClick={() => void handleToggleBlockUser(activeProfileUid)}
                            className="rounded-md border border-[#FB1818] bg-[#1d1216] px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.14em] text-[#ffb3b3]"
                          >
                              {isCurrentProfileBlocked ? (launcherLanguage === 'ar' ? 'إلغاء الحظر' : 'Unblock') : (launcherLanguage === 'ar' ? 'حظر' : 'Block')}
                          </button>
                        </>
                      )}
                    </div>
                  )}
                </div>
              </div>
            </div>

            <div className="border-b border-[#1d2330] bg-[#0b1018] px-6 py-3">
              <div className="flex items-center gap-3">
                {tabs.map((tab) => (
                  <button
                    key={tab.key}
                    type="button"
                    onClick={() => setActiveProfileTab(tab.key)}
                    className={`rounded-md px-3 py-2 text-[11px] font-bold uppercase tracking-[0.18em] ${activeProfileTab === tab.key ? 'bg-[#1d2430] text-white' : 'text-[#9aa9c2]'}`}
                  >
                    {tab.label}
                  </button>
                ))}
              </div>
            </div>

            <div className="grid gap-6 p-6 xl:grid-cols-[minmax(0,1.5fr)_320px]">
              {activeProfileTab === 'profile' && (
                <>
                  <div className="space-y-5">
                    <div className="rounded-[20px] border border-[#1d2330] bg-[#0d141d] p-4">
                      <div className="mb-4 flex items-center justify-between">
                        <div className="text-[12px] font-bold uppercase tracking-[0.2em] text-[#8ea0bb]">{launcherLanguage === 'ar' ? 'النشاط الأخير' : 'Recent Activity'}</div>
                        <div className="rounded-full border border-[#28563c] bg-[#102a1d] px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-[#a7edc4]">{launcherLanguage === 'ar' ? 'متصل' : 'Online'}</div>
                      </div>

                      <div className="space-y-3 text-sm text-[#dfe7f5]">
                        {recentActivityGames.length > 0 ? recentActivityGames.map((game, index) => (
                          <div key={game.id} className="flex items-center justify-between rounded-xl border border-[#1d2330] bg-[#111925] px-3 py-2.5">
                            <div className="flex items-center gap-3">
                              <div className="h-10 w-10 overflow-hidden rounded-lg border border-[#2a3446] bg-[#0b1018]">
                                <img src={game.image} alt={game.title} className="h-full w-full object-cover" />
                              </div>
                              <div>
                                <div className="font-semibold text-white">{game.title}</div>
                                <div className="text-[11px] text-[#9aa9c2]">{index === 0 ? 'Recently opened' : 'Available in library'}</div>
                              </div>
                            </div>
                            <div className="text-right text-[11px] text-[#ffc1c1]">
                              <div>{game.price === 'FREE' ? 'Free' : game.price}</div>
                              <div>{game.version}</div>
                            </div>
                          </div>
                        )) : (
                          <div className="rounded-xl border border-dashed border-[#2a3345] bg-[#101821] p-5 text-center text-sm text-[#aab6c9]">{launcherLanguage === 'ar' ? 'لا توجد نشاطات حديثة لهذا الملف الشخصي بعد.' : 'No recent activity for this profile yet.'}</div>
                        )}
                      </div>
                    </div>

                    <div className="rounded-[20px] border border-[#1d2330] bg-[#0d141d] p-4">
                      <div className="mb-4 flex items-center justify-between">
                        <div className="text-[12px] font-bold uppercase tracking-[0.2em] text-[#8ea0bb]">{launcherLanguage === 'ar' ? 'عني' : 'About Me'}</div>
                      </div>

                      <p className="text-[15px] leading-7 text-[#dfe7f5]">
                        {profileBio}
                      </p>
                    </div>
                  </div>

                  <aside className="space-y-5">
                    <div className="rounded-[20px] border border-[#1d2330] bg-[#0d141d] p-4">
                      <div className="text-[12px] font-bold uppercase tracking-[0.2em] text-[#8ea0bb]">{launcherLanguage === 'ar' ? 'ملخص الملف الشخصي' : 'Profile Overview'}</div>
                      <div className="mt-4 space-y-3 text-sm text-[#dfe7f5]">
                        <div className="flex items-center justify-between rounded-xl bg-[#101821] px-3 py-2">
                          <span>{launcherLanguage === 'ar' ? 'الألعاب' : 'Games'}</span>
                          <span className="font-bold text-white">{gamesCount}</span>
                        </div>
                        <div className="flex items-center justify-between rounded-xl bg-[#101821] px-3 py-2">
                          <span>{launcherLanguage === 'ar' ? 'مملوك' : 'Owned'}</span>
                          <span className="font-bold text-white">{ownedCount}</span>
                        </div>
                        <div className="flex items-center justify-between rounded-xl bg-[#101821] px-3 py-2">
                          <span>{launcherLanguage === 'ar' ? 'الأصدقاء' : 'Friends'}</span>
                          <span className="font-bold text-white">{friendsCount}</span>
                        </div>
                      </div>
                    </div>

                    <div className="rounded-[20px] border border-[#1d2330] bg-[#0d141d] p-4">
                      <div className="mb-3 text-[12px] font-bold uppercase tracking-[0.2em] text-[#8ea0bb]">{launcherLanguage === 'ar' ? 'الموقع' : 'Location'}</div>
                      <div className="space-y-2 text-sm text-[#dfe7f5]">
                        <div className="rounded-xl bg-[#101821] px-3 py-2"><span className="text-[#9aa9c2]">{launcherLanguage === 'ar' ? 'الدولة:' : 'Country:'}</span> {profileCountry}</div>
                        <div className="rounded-xl bg-[#101821] px-3 py-2"><span className="text-[#9aa9c2]">{launcherLanguage === 'ar' ? 'المدينة:' : 'City:'}</span> {profileCity}</div>
                      </div>
                    </div>

                    <div className="rounded-[20px] border border-[#1d2330] bg-[#0d141d] p-4">
                      <div className="mb-3 text-[12px] font-bold uppercase tracking-[0.2em] text-[#8ea0bb]">{launcherLanguage === 'ar' ? 'الأصدقاء' : 'Friends'}</div>
                      <div className="space-y-2">
                        {visibleProfileFriends.slice(0, 4).map((friend) => {
                          const friendName = String(friend.name || 'Player')
                          const friendStatus = String(friend.status || 'Offline')
                          const friendColor = String(friend.color || 'bg-[#9aa5b5]')

                          return (
                            <button
                              key={friend.id}
                              type="button"
                              onClick={() => void handleViewProfile(friend.id)}
                              className="flex w-full items-center justify-between rounded-xl bg-[#101821] px-3 py-2 text-left transition hover:bg-[#121f2d]"
                            >
                              <div className="flex items-center gap-3">
                                <div className="flex h-8 w-8 items-center justify-center overflow-hidden rounded-full bg-gradient-to-br from-[#ffb1b1] to-[#8d3232] text-[11px] font-bold text-[#0c0c10]">
                                  {friend.avatarUrl ? <img src={friend.avatarUrl} alt={friendName} className="h-full w-full object-cover" /> : friendName.slice(0, 1).toUpperCase()}
                                </div>
                                <div>
                                  <div className="text-sm font-semibold text-white">{friendName}</div>
                                  <div className="text-[10px] text-[#9aa9c2]">{friendStatus}</div>
                                </div>
                              </div>
                              <span className={`h-2.5 w-2.5 rounded-full ${friendColor}`} />
                            </button>
                          )
                        })}
                      </div>
                    </div>
                  </aside>
                </>
              )}

              {activeProfileTab === 'inventory' && (
                <div className="col-span-full rounded-[20px] border border-[#1d2330] bg-[#0d141d] p-4">
                  <div className="mb-4 text-[12px] font-bold uppercase tracking-[0.2em] text-[#8ea0bb]">{launcherLanguage === 'ar' ? 'المخزون' : 'Inventory'}</div>
                  {activeProfileInventoryGames.length > 0 ? (
                    <div className="flex flex-wrap gap-4">
                      {activeProfileInventoryGames.slice(0, 6).map((game) => (
                        <div key={game.id} className="w-[180px] overflow-hidden rounded-[18px] border border-[#1d2330] bg-[#0b1018]">
                          <img src={game.image} alt={game.title} className="h-[210px] w-full object-cover" />
                          <div className="px-3 py-3">
                            <div className="truncate text-sm font-bold text-white">{game.title}</div>
                            <div className="mt-2 text-[11px] text-[#9aa9c2]">{game.price === 'FREE' ? 'Free' : game.price}</div>
                          </div>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div className="rounded-xl border border-dashed border-[#2a3345] bg-[#101821] p-6 text-center text-[#aab6c9]">{launcherLanguage === 'ar' ? 'لا توجد عناصر في المخزون بعد.' : 'No items in inventory yet.'}</div>
                  )}
                </div>
              )}

              {activeProfileTab === 'screenshots' && (
                <div className="col-span-full rounded-[20px] border border-[#1d2330] bg-[#0d141d] p-4">
                  <div className="mb-4 flex items-center justify-between gap-3">
                    <div className="text-[12px] font-bold uppercase tracking-[0.2em] text-[#8ea0bb]">{launcherLanguage === 'ar' ? 'الصور' : 'Screenshots'}</div>
                    {!viewingOther && (
                      <div className="flex items-center gap-2">
                        <button
                          type="button"
                          onClick={() => document.getElementById('profile-screenshot-upload-input')?.click()}
                          className="rounded-lg bg-[#FB1818] px-3 py-2 text-[10px] font-bold uppercase tracking-[0.18em] text-white"
                        >
                          {launcherLanguage === 'ar' ? 'إضافة صور' : 'Add Screenshots'}
                        </button>
                        {pendingScreenshotUploads.length > 0 && (
                          <>
                            <button
                              type="button"
                              onClick={() => void publishPendingProfileScreenshots()}
                              className="rounded-lg border border-[#2dd582] bg-[#102a1d] px-3 py-2 text-[10px] font-bold uppercase tracking-[0.18em] text-[#9ae6b4]"
                            >
                              {launcherLanguage === 'ar' ? 'نشر' : 'Publish'}
                            </button>
                            <button
                              type="button"
                              onClick={discardPendingProfileScreenshots}
                              className="rounded-lg border border-[#ff7a7a] bg-[#2a1717] px-3 py-2 text-[10px] font-bold uppercase tracking-[0.18em] text-[#ffb3b3]"
                            >
                              {launcherLanguage === 'ar' ? 'إلغاء' : 'Cancel'}
                            </button>
                          </>
                        )}
                      </div>
                    )}
                  </div>
                    {!viewingOther && (
                      <input
                        id="profile-screenshot-upload-input"
                        type="file"
                        accept="image/*"
                        multiple
                        className="hidden"
                        onChange={(event) => void handleProfileScreenshotUpload(event)}
                      />
                    )}
                    {profileScreenshots.length > 0 ? (
                    <div className="grid grid-cols-2 gap-4 md:grid-cols-3">
                      {profileScreenshots.map((image: any, index: number) => (
                        <div key={`${image}-${index}`} className="relative overflow-hidden rounded-[18px] border border-[#1d2330] bg-[#0b1018]">
                          <button
                            type="button"
                            onClick={() => setMediaViewer({ type: 'image', url: String(image), title: `Profile screenshot ${index + 1}` })}
                            className="block w-full text-left"
                          >
                            <img src={image} alt="Profile upload" className="h-[180px] w-full object-cover" />
                          </button>
                          {!viewingOther && (
                            <div className="absolute right-2 top-2">
                              <button
                                type="button"
                                onClick={() => removeProfileScreenshot(String(image))}
                                className="rounded-md border border-red-500/50 bg-[#2d1416] px-2 py-1 text-[9px] font-bold uppercase tracking-[0.14em] text-red-200"
                              >
                                {launcherLanguage === 'ar' ? 'حذف' : 'Delete'}
                              </button>
                            </div>
                          )}
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div className="rounded-xl border border-dashed border-[#2a3345] bg-[#101821] p-6 text-center text-[#aab6c9]">{launcherLanguage === 'ar' ? 'لا توجد صور مرفوعة بعد.' : 'No screenshots uploaded yet.'}</div>
                  )}
                </div>
              )}
            </div>
          </div>
        </div>
      )
    }

    if (page === 'community') {
      const activeCommunityUser = viewProfileData ?? {
        uid: user?.uid || 'me',
        displayName: profile?.displayName || 'Dreko8u',
        email: profile?.email || '',
        bio: profile?.bio || 'No bio yet.',
        country: profile?.country || 'United States',
        city: profile?.city || '',
        avatarUrl: resolveAvatarUrl(profile?.avatarUrl),
        coverUrl: profile?.coverUrl || '',
        screenshots: profile?.screenshots || [],
      }

      const friendCode = profile?.friendCode || '0000000000'
      const communityFriends = friends.length > 0 ? friends : []
      const blockedList = blockedUsers.length > 0 ? blockedUsers : []
      const normalizedFriendSearch = friendsSearchQuery.trim().toLowerCase()
      const filteredFriends = communityFriends.filter((friend) => {
        const haystack = `${friend.name || ''}`.toLowerCase()
        return !normalizedFriendSearch || haystack.includes(normalizedFriendSearch)
      })
      const isCurrentProfileBlocked = Boolean(user && activeCommunityUser.uid && isUserBlocked(activeCommunityUser.uid))
      const isCurrentProfileFriend = Boolean(user && activeCommunityUser.uid && friends.some((friend) => friend.id === activeCommunityUser.uid))
      const outgoingFriendRequestForProfile = user && activeCommunityUser.uid
        ? pendingRequests.find((request) => request.from === user.uid && request.to === activeCommunityUser.uid)
        : undefined
      const incomingFriendRequestForProfile = user && activeCommunityUser.uid
        ? pendingRequests.find((request) => request.to === user.uid && request.from === activeCommunityUser.uid)
        : undefined
      const canAddCurrentProfile = Boolean(
        user &&
        activeCommunityUser.uid &&
        activeCommunityUser.uid !== user.uid &&
        !isCurrentProfileFriend &&
        !isCurrentProfileBlocked &&
        !outgoingFriendRequestForProfile &&
        !incomingFriendRequestForProfile,
      )

      const openCommunityProfile = async (uid: string, name: string) => {
        try {
          const profileData = await getUserProfile(uid)
          setViewProfileUid(uid)
          setViewProfileData(profileData ?? {
            uid,
            displayName: name,
            email: '',
            bio: 'No bio yet.',
            country: 'United States',
            city: '',
            avatarUrl: '',
            coverUrl: '',
            screenshots: [],
          })
          setViewProfileFriends((await getFriendsOnce(uid)) || [])
        } catch {
          setViewProfileUid(uid)
          setViewProfileData({
            uid,
            displayName: name,
            email: '',
            bio: 'No bio yet.',
            country: 'United States',
            city: '',
            avatarUrl: '',
            coverUrl: '',
            screenshots: [],
          })
          setViewProfileFriends([])
        }
      }

      const sidebarItems = [
        { key: 'friends' as const, label: launcherLanguage === 'ar' ? 'أصدقاؤك' : 'Your Friends', count: communityFriends.length },
        { key: 'add' as const, label: launcherLanguage === 'ar' ? 'إضافة صديق' : 'Add a Friend', count: 0 },
        { key: 'pending' as const, label: launcherLanguage === 'ar' ? 'الأصدقاء المعلقة' : 'Pending Friends', count: pendingRequests.length },
        { key: 'blocked' as const, label: launcherLanguage === 'ar' ? 'المحظورون' : 'Blocked', count: blockedList.length },
      ]
      const showProfileSidebar = Boolean(viewProfileUid && viewProfileData) || searchQuery.trim().length > 0 || searchResults.length > 0

      return (
        <div className="space-y-6 overflow-y-auto pr-1" style={{ maxHeight: 'calc(100vh - 140px)' }}>
          <div className="overflow-hidden rounded-[28px] border border-[#1d2330] bg-[#08131b] shadow-[0_0_30px_rgba(0,0,0,0.25)]">
            <div className="flex items-center gap-4 border-b border-[#1d2330] bg-[#0b141d] px-6 py-5">
              <div className="flex h-14 w-14 items-center justify-center overflow-hidden rounded-2xl bg-gradient-to-br from-[#ffb1b1] to-[#7a2d2d] text-xl font-black text-[#0b0d11] shadow-[0_0_14px_rgba(251,24,24,0.25)]">
                {activeCommunityUser.avatarUrl ? <img src={activeCommunityUser.avatarUrl} alt="avatar" className="h-full w-full object-cover" /> : (activeCommunityUser.displayName || 'D').slice(0, 1).toUpperCase()}
              </div>
              <div>
                <div className="text-[12px] font-bold uppercase tracking-[0.2em] text-[#8ea0bb]">{launcherLanguage === 'ar' ? 'المجتمع' : 'Community'}</div>
              </div>
            </div>

            <div className="grid min-h-[760px] lg:grid-cols-[260px_minmax(0,1fr)_360px]">
              <aside className="border-r border-[#1d2330] bg-[#0a1118] p-4">
                <div className="space-y-5">
                  <div>
                    <div className="mb-3 text-[11px] font-bold uppercase tracking-[0.22em] text-[#7e90ac]">{launcherLanguage === 'ar' ? 'الأصدقاء' : 'Friends'}</div>
                    <div className="space-y-2">
                      {sidebarItems.map((item) => (
                        <button
                          key={item.key}
                          type="button"
                          onClick={() => setCommunityTab(item.key)}
                          className={`flex w-full items-center justify-between rounded-xl px-3 py-2.5 text-left text-sm transition ${communityTab === item.key ? 'bg-[#132331] text-white' : 'text-[#d9e3f6] hover:bg-[#111d2a]'}`}
                        >
                          <span>{item.label}</span>
                          {item.count > 0 && <span className="min-w-[26px] rounded-full bg-[#24334a] px-2 py-0.5 text-center text-[10px] font-bold text-[#dfeafc]">{item.count}</span>}
                        </button>
                      ))}
                    </div>
                  </div>

                </div>
              </aside>

              <main className="bg-[#09141d] p-5">
                {communityTab === 'friends' && (
                  <div className="space-y-5">
                    <div className="flex items-center justify-between gap-4 rounded-2xl border border-[#1d2330] bg-[#0d1a24] p-3">
                      <div className="flex items-center gap-3 text-lg font-black tracking-[-0.04em] text-white">
                        <span>{launcherLanguage === 'ar' ? 'أصدقاؤك' : 'YOUR FRIENDS'}</span>
                        <span className="rounded-full bg-[#1f3040] px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.18em] text-[#dfeafc]">{communityFriends.length}</span>
                      </div>
                      <button type="button" onClick={() => setCommunityTab('add')} className="rounded-xl bg-[#a3e635] px-3 py-2 text-[11px] font-bold uppercase tracking-[0.18em] text-[#0c1608]">{launcherLanguage === 'ar' ? 'إضافة صديق' : 'Add a Friend'}</button>
                    </div>

                    <div className="rounded-2xl border border-[#1d2330] bg-[#0d1a24] p-3">
                      <input
                        value={friendsSearchQuery}
                        onChange={(e) => setFriendsSearchQuery(e.target.value)}
                        placeholder={launcherLanguage === 'ar' ? 'ابحث في أصدقائك' : 'Search your friends'}
                        className="w-full rounded-xl border border-[#243241] bg-[#0a1118] px-4 py-3 text-sm text-white placeholder:text-[#7b8aa0] outline-none"
                      />
                    </div>

                    <div className="space-y-4">
                      <div className="text-[11px] font-bold uppercase tracking-[0.2em] text-[#7f93b3]">{launcherLanguage === 'ar' ? 'متصل الأن' : 'Online'}</div>
                      {filteredFriends.length === 0 ? (
                        <div className="rounded-[18px] border border-dashed border-[#2a3345] bg-[#0b1018] p-8 text-center text-[#aab6c9]">{communityFriends.length === 0 ? (launcherLanguage === 'ar' ? 'لا يوجد أصدقاء بعد. أضف صديقًا من لوحة المجتمع.' : 'No friends yet. Add a friend from the community panel.') : (launcherLanguage === 'ar' ? 'لا يوجد أصدقاء مطابقون.' : 'No matching friends found.')}</div>
                      ) : (
                        <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                          {filteredFriends.map((friend) => (
                            <div key={friend.id} className="rounded-2xl border border-[#1c2732] bg-[#0c141b] p-3 transition hover:border-[#2d8cff] hover:bg-[#101b26]">
                              <div className="flex items-center gap-3">
                                <button
                                  type="button"
                                  onClick={() => void openCommunityProfile(friend.id, friend.name || 'Player')}
                                  className="group flex min-w-0 flex-1 items-center gap-3 text-left"
                                >
                                  <div className="relative flex h-12 w-12 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-[#ffb29c] to-[#8c5a5a] text-sm font-black text-[#0b0d11]">
                                    {friend.avatarUrl ? <img src={friend.avatarUrl} alt={friend.name || 'User'} className="h-full w-full object-cover" /> : (friend.name || 'P').slice(0, 1).toUpperCase()}
                                    <span className={`absolute -right-1 -bottom-1 h-3 w-3 rounded-full border-2 border-[#0c141b] ${friend.color}`} />
                                  </div>
                                  <div className="min-w-0 flex-1">
                                    <div className="truncate text-base font-bold text-white">{friend.name || 'Player'}</div>
                                    <div className="text-xs text-[#99a9c0]">{friend.status}</div>
                                  </div>
                                </button>
                              </div>
                            </div>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                )}

                {communityTab === 'add' && (
                  <div className="space-y-5 rounded-[22px] border border-[#1d2330] bg-[#0d1a24] p-5">
                    <div className="mb-3 border-b border-[#1d2330] pb-3 text-[12px] font-bold uppercase tracking-[0.22em] text-[#8ea0bb]">{launcherLanguage === 'ar' ? 'إضافة صديق' : 'Add a Friend'}</div>

                    <div className="space-y-4">
                      <div>
                        <div className="mb-2 text-[13px] font-bold uppercase tracking-[0.18em] text-[#dfeafc]">{launcherLanguage === 'ar' ? 'رمز الأضافة الخاص بك' : 'Your Add Code'}</div>
                        <div className="flex items-center gap-3 rounded-xl border border-[#243241] bg-[#0a1118] p-3">
                          <div className="flex-1 text-[22px] font-black tracking-[0.12em] text-white">{friendCode}</div>
                          <button type="button" onClick={() => navigator.clipboard?.writeText(friendCode)} className="rounded-xl bg-[#3b82f6] px-3 py-2 text-[11px] font-bold uppercase tracking-[0.16em] text-white">{launcherLanguage === 'ar' ? 'نسخ' : 'Copy'}</button>
                        </div>
                      </div>

                      <div>
                        <div className="mb-2 text-[13px] font-bold uppercase tracking-[0.18em] text-[#dfeafc]">{launcherLanguage === 'ar' ? 'أدخل رمز صديقك' : 'Enter your friend\'s code'}</div>
                        <div className="flex gap-3">
                          <input value={friendTarget} onChange={(e) => setFriendTarget(e.target.value)} placeholder={launcherLanguage === 'ar' ? 'أدخل رمز صديق' : 'Enter a Friend Code'} className="flex-1 rounded-xl border border-[#243241] bg-[#0a1118] px-4 py-3 text-white placeholder:text-[#7b8aa0] outline-none" />
                          <button type="button" onClick={() => { if (friendTarget.trim()) { void handleSendFriendRequest(friendTarget.trim()); setFriendTarget('') } }} className="rounded-xl bg-[#3b82f6] px-4 py-3 text-[11px] font-bold uppercase tracking-[0.16em] text-white">{launcherLanguage === 'ar' ? 'إرسال' : 'Send'}</button>
                        </div>
                      </div>

                      <div className="rounded-xl border border-[#1d2330] bg-[#0b1218] p-4">
                        <div className="mb-2 text-[13px] font-bold uppercase tracking-[0.18em] text-[#dfeafc]">{launcherLanguage === 'ar' ? 'أو ابحث عن صديقك' : 'Or try searching for your friend'}</div>
                        <div className="flex items-center gap-3 rounded-xl border border-[#243241] bg-[#0a1118] px-3 py-3">
                          <input
                            value={searchQuery}
                            onChange={(e) => handleSearchUsers(e.target.value)}
                            onKeyDown={(e) => {
                              if (e.key === 'Enter') {
                                void handleSearchUsers(searchQuery)
                              }
                            }}
                            placeholder={launcherLanguage === 'ar' ? 'أدخل اسم ملف صديقك' : 'Enter your friend\'s profile name'}
                            className="flex-1 bg-transparent text-white placeholder:text-[#7b8aa0] outline-none"
                          />
                          <button
                            type="button"
                            onClick={() => void handleSearchUsers(searchQuery)}
                            className="flex h-10 w-10 items-center justify-center rounded-lg border border-[#2a3446] bg-[#101821] text-xl text-[#dfeafc] transition hover:border-[#4d7dff] hover:text-white"
                            aria-label={launcherLanguage === 'ar' ? 'بحث عن صديق' : 'Search for a friend'}
                          >
                            ⌕
                          </button>
                        </div>
                        {searchResults.length > 0 && (
                          <div className="mt-3 space-y-2">
                            {searchResults.slice(0, 4).map((result) => (
                              <div key={result.uid} className="flex items-center justify-between rounded-xl bg-[#0f1a24] px-3 py-2">
                                <div className="flex items-center gap-3">
                                  <div className="flex h-10 w-10 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-[#ffb29c] to-[#8c5a5a] text-xs font-black text-[#0b0d11]">
                                    {result.avatarUrl ? <img src={result.avatarUrl} alt={result.displayName || 'User'} className="h-full w-full object-cover" /> : (result.displayName || 'P').slice(0, 1).toUpperCase()}
                                  </div>
                                  <div>
                                    <div className="font-semibold text-white">{result.displayName || result.uid}</div>
                                    <div className="text-xs text-[#9aa5b5]">{result.email || (launcherLanguage === 'ar' ? 'متصل الأن' : 'Online')}</div>
                                  </div>
                                </div>
                                <button type="button" onClick={() => void handleViewProfile(result.uid)} className="rounded-lg bg-[#3b82f6] px-2 py-1 text-[10px] font-bold uppercase tracking-[0.16em] text-white">{launcherLanguage === 'ar' ? 'عرض' : 'View'}</button>
                              </div>
                            ))}
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                )}

                {communityTab === 'pending' && (
                  <div className="space-y-5 rounded-[22px] border border-[#1d2330] bg-[#0d1a24] p-5">
                    <div className="mb-3 border-b border-[#1d2330] pb-3 text-[12px] font-bold uppercase tracking-[0.22em] text-[#8ea0bb]">{launcherLanguage === 'ar' ? 'الأصدقاء المعلقة' : 'Pending Friends'}</div>

                    <div className="space-y-5">
                      <div className="space-y-3">
                        <div className="text-[11px] font-bold uppercase tracking-[0.18em] text-[#8ea0bb]">{launcherLanguage === 'ar' ? 'الطلبات التي أرسلتها' : 'Requests I Sent'}</div>
                        {pendingRequests.filter((request) => request.from === user?.uid).length === 0 ? (
                          <div className="rounded-xl border border-dashed border-[#2a3345] bg-[#0b1018] p-5 text-center text-sm text-[#aab6c9]">{launcherLanguage === 'ar' ? 'لا توجد طلبات صداقة مرسلة.' : 'No outgoing requests.'}</div>
                        ) : (
                          pendingRequests.filter((request) => request.from === user?.uid).map((request) => (
                            <div key={request.id} className="flex items-center justify-between gap-3 rounded-xl border border-[#1d2330] bg-[#0b1218] px-3 py-3">
                              <div className="flex min-w-0 items-center gap-3">
                                <div className="flex h-10 w-10 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-[#f3d7d7] to-[#6b4d4d] text-sm font-black text-[#0b0d11]">
                                  {request.avatarUrl ? <img src={request.avatarUrl} alt={request.toName || 'User'} className="h-full w-full object-cover" /> : (request.toName || 'P').slice(0, 1).toUpperCase()}
                                </div>
                                <div className="min-w-0">
                                  <div className="truncate font-semibold text-white">{request.toName || 'Unknown User'}</div>
                                  <div className="text-[10px] text-[#9aa5b5]">{launcherLanguage === 'ar' ? 'بانتظار الرد' : 'Awaiting response'}</div>
                                </div>
                              </div>
                              <div className="flex shrink-0 gap-2">
                                <button type="button" onClick={() => void handleViewProfile(request.to)} className="rounded-md border border-[#2a3446] bg-[#101821] px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.14em] text-white">{launcherLanguage === 'ar' ? 'عرض' : 'View'}</button>
                                <button type="button" onClick={() => void handleRejectRequest(request.id)} className="rounded-md border border-[#2a3446] bg-[#101821] px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.14em] text-white">{launcherLanguage === 'ar' ? 'إلغاء' : 'Cancel'}</button>
                              </div>
                            </div>
                          ))
                        )}
                      </div>

                      <div className="space-y-3">
                        <div className="text-[11px] font-bold uppercase tracking-[0.18em] text-[#8ea0bb]">{launcherLanguage === 'ar' ? 'الطلبات المرسلة إلي' : 'Requests Sent To Me'}</div>
                        {pendingRequests.filter((request) => request.to === user?.uid).length === 0 ? (
                          <div className="rounded-xl border border-dashed border-[#2a3345] bg-[#0b1018] p-5 text-center text-sm text-[#aab6c9]">{launcherLanguage === 'ar' ? 'لا توجد طلبات واردة.' : 'No incoming requests.'}</div>
                        ) : (
                          pendingRequests.filter((request) => request.to === user?.uid).map((request) => (
                            <div key={request.id} className="flex items-center justify-between gap-3 rounded-xl border border-[#1d2330] bg-[#0b1218] px-3 py-3">
                              <div className="flex min-w-0 items-center gap-3">
                                <div className="flex h-10 w-10 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-[#f3d7d7] to-[#6b4d4d] text-sm font-black text-[#0b0d11]">
                                  {request.avatarUrl ? <img src={request.avatarUrl} alt={request.fromName || 'User'} className="h-full w-full object-cover" /> : (request.fromName || 'P').slice(0, 1).toUpperCase()}
                                </div>
                                <div className="min-w-0">
                                  <div className="truncate font-semibold text-white">{request.fromName || 'Unknown User'}</div>
                                  <div className="text-[10px] text-[#9aa5b5]">{launcherLanguage === 'ar' ? 'طلب وارد' : 'Incoming request'}</div>
                                </div>
                              </div>
                              <div className="flex shrink-0 gap-2">
                                <button type="button" onClick={() => void handleViewProfile(request.from)} className="rounded-md border border-[#2a3446] bg-[#101821] px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.14em] text-white">{launcherLanguage === 'ar' ? 'عرض' : 'View'}</button>
                                <button type="button" onClick={() => void handleAcceptRequest(request.id)} className="rounded-md bg-[#32d583] px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.14em] text-[#0b1b12]">{launcherLanguage === 'ar' ? 'قبول' : 'Accept'}</button>
                                <button type="button" onClick={() => void handleRejectRequest(request.id)} className="rounded-md border border-[#2a3446] bg-[#101821] px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.14em] text-white">{launcherLanguage === 'ar' ? 'رفض' : 'Reject'}</button>
                              </div>
                            </div>
                          ))
                        )}
                      </div>
                    </div>
                  </div>
                )}

                {communityTab === 'blocked' && (
                  <div className="space-y-5 rounded-[22px] border border-[#1d2330] bg-[#0d1a24] p-5">
                    <div className="mb-3 border-b border-[#1d2330] pb-3 text-[12px] font-bold uppercase tracking-[0.22em] text-[#8ea0bb]">{launcherLanguage === 'ar' ? 'المحظورون' : 'Blocked'}</div>
                    <div className="space-y-3">
                      {blockedList.length === 0 ? (
                        <div className="rounded-xl border border-dashed border-[#2a3345] bg-[#0b1018] p-8 text-center text-[#aab6c9]">{launcherLanguage === 'ar' ? 'لا توجد حسابات محظورة.' : 'No blocked accounts.'}</div>
                      ) : (
                        blockedList.map((person) => (
                          <div key={person.id} className="flex items-center justify-between rounded-xl border border-[#1d2330] bg-[#0b1218] px-3 py-3">
                            <div className="flex items-center gap-3">
                              <div className="flex h-11 w-11 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-[#f3d7d7] to-[#6b4d4d] text-sm font-black text-[#0b0d11]">
                                {person.avatarUrl ? <img src={person.avatarUrl} alt={person.name || 'User'} className="h-full w-full object-cover" /> : (person.name || 'P').slice(0, 1).toUpperCase()}
                              </div>
                              <div>
                                <div className="font-semibold text-white">{person.name}</div>
                                <div className="text-[11px] text-[#9aa5b5]">{launcherLanguage === 'ar' ? 'محظور' : 'Blocked'}</div>
                              </div>
                            </div>
                            <div className="flex gap-2">
                              <button type="button" onClick={() => void handleViewProfile(person.uid)} className="rounded-lg border border-[#2a3446] bg-[#101821] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.18em] text-white">{launcherLanguage === 'ar' ? 'عرض' : 'View'}</button>
                              <button
                                type="button"
                                onClick={async () => {
                                  if (!user || !person.uid) return
                                  const ok = await unblockUser(user.uid, person.uid)
                                  if (ok) {
                                    setBlockedUsers((current) => current.filter((entry) => entry.uid !== person.uid))
                                    setCommunityTab('blocked')
                                  }
                                }}
                                className="rounded-lg border border-[#2a3446] bg-[#101821] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.18em] text-white"
                              >
                                {launcherLanguage === 'ar' ? 'إلغاء الحظر' : 'Unblock'}
                              </button>
                            </div>
                          </div>
                        ))
                      )}
                    </div>
                  </div>
                )}
              </main>

              {showProfileSidebar && (
                <aside className="border-l border-[#1d2330] bg-[#0a1118] p-5">
                  <div className="overflow-hidden rounded-[22px] border border-[#1d2330] bg-[#0c151d]">
                    <div className="relative h-[150px] overflow-hidden bg-[radial-gradient(circle_at_50%_20%,rgba(251,24,24,0.40),transparent_20%),linear-gradient(120deg,#0a1520_0%,#102333_100%)]">
                      {activeCommunityUser.coverUrl ? <img src={activeCommunityUser.coverUrl} alt="cover" className="absolute inset-0 h-full w-full object-cover opacity-70" /> : <div className="absolute inset-0 bg-[linear-gradient(90deg,rgba(0,0,0,0.48),transparent_30%,transparent_70%,rgba(0,0,0,0.5))]" />}
                      <div className="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-[#0c151d] to-transparent" />
                      <div className="absolute bottom-4 left-4 flex items-end gap-3">
                        <div className="flex h-16 w-16 items-center justify-center overflow-hidden rounded-full border-4 border-[#0c151d] bg-gradient-to-br from-[#ffb1b1] to-[#7a2d2d] text-xl font-black text-[#090b11]">
                          {activeCommunityUser.avatarUrl ? <img src={activeCommunityUser.avatarUrl} alt="avatar" className="h-full w-full object-cover" /> : (activeCommunityUser.displayName || 'D').slice(0, 1).toUpperCase()}
                        </div>
                      </div>
                    </div>

                    <div className="space-y-4 p-4">
                      <div className="flex items-center justify-between gap-3">
                        <div className="text-[26px] font-black tracking-[-0.05em] text-white">{activeCommunityUser.displayName || 'Dreko8u'}</div>
                        <div className="flex flex-wrap justify-end gap-2">
                          {outgoingFriendRequestForProfile ? (
                            <button
                              type="button"
                              onClick={() => void cancelPendingFriendRequest(activeCommunityUser.uid)}
                              className="rounded-md border border-[#ffd166] bg-[#2a2418] px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.14em] text-[#f8d27a]"
                            >
                              {launcherLanguage === 'ar' ? 'طلب معلّق' : 'Pending Request'}
                            </button>
                          ) : canAddCurrentProfile ? (
                            <button
                              type="button"
                              onClick={() => {
                                if (!user || !activeCommunityUser.uid || activeCommunityUser.uid === user.uid) {
                                  setToastMessage(launcherLanguage === 'ar' ? 'اختر صديقًا لإضافته.' : 'Choose a friend to add.')
                                  return
                                }
                                void handleSendFriendRequest(activeCommunityUser.uid)
                              }}
                              className="rounded-md bg-[#32d583] px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.14em] text-[#0b1b12]"
                            >
                              {launcherLanguage === 'ar' ? 'إضافة' : 'Add'}
                            </button>
                          ) : null}
                          {!user || !activeCommunityUser.uid || activeCommunityUser.uid === user.uid ? null : (
                            <>
                              {friends.some((friend) => friend.id === activeCommunityUser.uid) && (
                                <button
                                  type="button"
                                  onClick={() => void handleUnfriendUser(activeCommunityUser.uid)}
                                  className="rounded-md border border-[#ff8f6b] bg-[#1f1714] px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.14em] text-[#ffd7c9]"
                                >
                                  {launcherLanguage === 'ar' ? 'إزالة صديق' : 'Unfriend'}
                                </button>
                              )}
                              <button
                                type="button"
                                onClick={() => void handleToggleBlockUser(activeCommunityUser.uid)}
                                className="rounded-md border border-[#FB1818] bg-[#1d1216] px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.14em] text-[#ffb3b3]"
                              >
                                {isCurrentProfileBlocked ? (launcherLanguage === 'ar' ? 'إلغاء الحظر' : 'Unblock') : (launcherLanguage === 'ar' ? 'حظر' : 'Block')}
                              </button>
                            </>
                          )}
                        </div>
                      </div>

                      <div className="rounded-xl border border-[#1d2330] bg-[#0d141d] p-3 text-sm text-[#dfeafc]">
                        <div className="mb-2 text-[11px] font-bold uppercase tracking-[0.2em] text-[#8ea0bb]">{launcherLanguage === 'ar' ? 'حول' : 'About'}</div>
                        <p>{activeCommunityUser.bio || (launcherLanguage === 'ar' ? 'لا توجد سيرة بعد.' : 'No bio yet.')}</p>
                      </div>

                      <div className="grid gap-2 text-sm text-[#dfeafc]">
                        <div className="flex items-center justify-between rounded-xl bg-[#0d141d] px-3 py-2"><span>{launcherLanguage === 'ar' ? 'الدولة' : 'Country'}</span><span>{activeCommunityUser.country || (launcherLanguage === 'ar' ? 'الولايات المتحدة' : 'United States')}</span></div>
                        <div className="flex items-center justify-between rounded-xl bg-[#0d141d] px-3 py-2"><span>{launcherLanguage === 'ar' ? 'المدينة' : 'City'}</span><span>{activeCommunityUser.city || (launcherLanguage === 'ar' ? 'غير متوفر' : 'N/A')}</span></div>
                        <div className="flex items-center justify-between rounded-xl bg-[#0d141d] px-3 py-2"><span>{launcherLanguage === 'ar' ? 'الأصدقاء' : 'Friends'}</span><span>{communityFriends.length}</span></div>
                      </div>

                      {activeCommunityUser.screenshots?.length ? (
                        <div className="space-y-2">
                          <div className="text-[11px] font-bold uppercase tracking-[0.2em] text-[#8ea0bb]">{launcherLanguage === 'ar' ? 'الصور' : 'Screenshots'}</div>
                          <div className="grid grid-cols-2 gap-2">
                            {activeCommunityUser.screenshots.slice(0, 4).map((image: string, index: number) => (
                              <div key={`${image}-${index}`} className="overflow-hidden rounded-xl border border-[#1d2330] bg-[#0b1218]">
                                <img src={image} alt="Screenshot" className="h-[90px] w-full object-cover" />
                              </div>
                            ))}
                          </div>
                        </div>
                      ) : null}
                    </div>
                  </div>
                </aside>
              )}
            </div>
          </div>
        </div>
      )
    }

    if (page === 'settings') {
      const strings = launcherLanguage === 'ar' ? {
        settings: 'الإعدادات',
        language: 'اللغة',
        languageLabel: 'لغة التطبيق',
        english: 'English',
        arabic: 'العربية',
        preferences: 'التفضيلات',
        minimizeTray: 'تقليل التطبيق إلى شريط النظام',
        runStartup: 'التشغيل عند بدء التشغيل',
        choose: 'اختيار',
      } : {
        settings: 'Settings',
        language: 'LANGUAGE',
        languageLabel: 'Language',
        english: 'English',
        arabic: 'Arabic - العربية',
        preferences: 'PREFERENCES',
        minimizeTray: 'Minimize To System Tray',
        runStartup: 'Run When My Computer Starts',
        choose: 'Choose',
      }

      return (
        <div className="space-y-6">
          <h2 className="text-[28px] font-bold text-white">{strings.settings}</h2>

          <div className="space-y-6 rounded-[22px] border border-[#1d2330] bg-[#0b1018] p-5">
            <div className="space-y-4 rounded-[20px] border border-[#1d2330] bg-[#0d141d] p-4">
              <div className="space-y-3">
                <div className="text-[18px] font-black uppercase tracking-[0.18em] text-[#edf3ff]">{strings.language}</div>
                <div className="overflow-hidden rounded-xl border border-[#2a3446] bg-[#c9ced6] shadow-inner">
                  <select
                    value={launcherLanguage}
                    onChange={(event) => setLauncherLanguage(event.target.value === 'ar' ? 'ar' : 'en')}
                    className="w-full appearance-none bg-[#c9ced6] px-4 py-4 text-[16px] font-semibold text-[#111827] outline-none"
                    aria-label={strings.languageLabel}
                  >
                    <option value="en">{strings.english}</option>
                    <option value="ar">{strings.arabic}</option>
                  </select>
                </div>
              </div>

              <div className="my-3 border-t border-[#2a3446]" />

              <div className="space-y-4">
                <div className="text-[18px] font-black uppercase tracking-[0.18em] text-[#edf3ff]">{strings.preferences}</div>

                <label className="flex cursor-pointer items-center gap-3 rounded-lg px-1 py-2 text-[16px] text-[#e9eef9]">
                  <input
                    type="checkbox"
                    checked={minimizeToTray}
                    onChange={(event) => setMinimizeToTray(event.target.checked)}
                    className="h-5 w-5 rounded border-[#3b465b] bg-[#111827] accent-[#3b82f6]"
                  />
                  <span>{strings.minimizeTray}</span>
                </label>

                <label className="flex cursor-pointer items-center gap-3 rounded-lg px-1 py-2 text-[16px] text-[#e9eef9]">
                  <input
                    type="checkbox"
                    checked={runOnStartup}
                    onChange={(event) => setRunOnStartup(event.target.checked)}
                    className="h-5 w-5 rounded border-[#3b465b] bg-[#111827] accent-[#3b82f6]"
                  />
                  <span>{strings.runStartup}</span>
                </label>
              </div>

              <div className="my-3 border-t border-[#2a3446]" />

              <div className="space-y-4 rounded-xl bg-[#111925] px-4 py-3">
                <div className="flex items-center justify-between gap-3">
                  <span className="text-white">{launcherLanguage === 'ar' ? 'مجلد التثبيت' : 'Install folder'}</span>
                  <button type="button" onClick={() => void handleChooseInstallFolder()} className="rounded-lg border border-[#FB1818] bg-[#120d15] px-2 py-1 text-xs font-semibold text-white">{strings.choose}</button>
                </div>
                <div className="mt-2 text-xs text-[#dfe5ef]">{installFolder || (launcherLanguage === 'ar' ? 'لم يتم اختيار مجلد' : 'No folder selected')}</div>
              </div>

              <div className="rounded-xl bg-[#111925] px-4 py-3">
                <div className="flex items-center justify-between gap-3">
                  <span className="text-white">{launcherLanguage === 'ar' ? 'اختصار سطح المكتب' : 'Desktop shortcut'}</span>
                  <button type="button" onClick={() => setCreateShortcut((value) => !value)} className={`rounded-lg px-2 py-1 text-xs font-semibold ${createShortcut ? 'bg-[#FB1818] text-white' : 'border border-[#2a3345] bg-[#0c1019] text-[#d5d9e3]'}`}>
                    {createShortcut ? (launcherLanguage === 'ar' ? 'تشغيل' : 'ON') : (launcherLanguage === 'ar' ? 'إيقاف' : 'OFF')}
                  </button>
                </div>
              </div>

            </div>
          </div>
        </div>
      )
    }

    if (page === 'admin') {
      return (
        <div className="space-y-6">
          <div className="flex items-center justify-between">
            <h2 className="text-[28px] font-bold text-white">{launcherLanguage === 'ar' ? 'لوحة الإدارة' : 'Admin Panel'}</h2>
            <button
              type="button"
              onClick={() => {
                resetGameForm()
                setAdminMode('add')
                setError('')
              }}
              className="rounded-xl bg-[#FB1818] px-4 py-2 text-sm font-bold uppercase tracking-[0.12em] text-white"
            >
              {launcherLanguage === 'ar' ? 'إضافة لعبة' : 'Add Game'}
            </button>
          </div>

          {adminMode === 'add' ? (
            <div className="grid gap-4 rounded-[22px] border border-[#1d2330] bg-[#0b1018] p-5 lg:grid-cols-2">
              <input value={newGame.title} onChange={(event) => setNewGame((current) => ({ ...current, title: event.target.value }))} placeholder={launcherLanguage === 'ar' ? 'عنوان اللعبة' : 'Game title'} className="rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-white placeholder:text-[#7a8397]" />
              <input value={newGame.genre} onChange={(event) => setNewGame((current) => ({ ...current, genre: event.target.value }))} placeholder={launcherLanguage === 'ar' ? 'النوع' : 'Genre'} className="rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-white placeholder:text-[#7a8397]" />
              <input value={newGame.price} onChange={(event) => setNewGame((current) => ({ ...current, price: event.target.value }))} placeholder={launcherLanguage === 'ar' ? 'السعر' : 'Price'} className="rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-white placeholder:text-[#7a8397]" />
              <select value={newGame.status} onChange={(event) => setNewGame((current) => ({ ...current, status: event.target.value as Game['status'] }))} className="rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-white">
                <option value="New">{launcherLanguage === 'ar' ? 'جديد' : 'New'}</option>
                <option value="Free">{launcherLanguage === 'ar' ? 'مجاني' : 'Free'}</option>
                <option value="Premium">{launcherLanguage === 'ar' ? 'مميز' : 'Premium'}</option>
              </select>
              <input value={newGame.version} onChange={(event) => setNewGame((current) => ({ ...current, version: event.target.value }))} placeholder={launcherLanguage === 'ar' ? 'الإصدار' : 'Version'} className="rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-white placeholder:text-[#7a8397]" />
              <input value={newGame.size} onChange={(event) => setNewGame((current) => ({ ...current, size: event.target.value }))} placeholder={launcherLanguage === 'ar' ? 'الحجم (مثال: 8.4 GB)' : 'Size (Example: 8.4 GB)'} className="rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-white placeholder:text-[#7a8397]" />
              <input value={newGame.platform} onChange={(event) => setNewGame((current) => ({ ...current, platform: event.target.value }))} placeholder={launcherLanguage === 'ar' ? 'المنصة (Windows / Mac / Linux)' : 'Platform (Windows / Mac / Linux)'} className="rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-white placeholder:text-[#7a8397]" />
              <input value={newGame.fileName} onChange={(event) => setNewGame((current) => ({ ...current, fileName: event.target.value }))} placeholder={launcherLanguage === 'ar' ? 'اسم الملف (game.zip)' : 'File name (game.zip)'} className="rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-white placeholder:text-[#7a8397]" />
              <input value={newGame.image} onChange={(event) => setNewGame((current) => ({ ...current, image: event.target.value }))} placeholder={launcherLanguage === 'ar' ? 'رابط صورة الغلاف' : 'Cover image URL'} className="rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-white placeholder:text-[#7a8397] lg:col-span-2" />
              <div className="lg:col-span-2 grid gap-3 md:grid-cols-2">
                <input value={newGame.screenshots1} onChange={(event) => setNewGame((current) => ({ ...current, screenshots1: event.target.value }))} placeholder={launcherLanguage === 'ar' ? 'رابط لقطة 1' : 'Screenshot 1 URL'} className="rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-white placeholder:text-[#7a8397]" />
                <input value={newGame.screenshots2} onChange={(event) => setNewGame((current) => ({ ...current, screenshots2: event.target.value }))} placeholder={launcherLanguage === 'ar' ? 'رابط لقطة 2' : 'Screenshot 2 URL'} className="rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-white placeholder:text-[#7a8397]" />
                <input value={newGame.screenshots3} onChange={(event) => setNewGame((current) => ({ ...current, screenshots3: event.target.value }))} placeholder={launcherLanguage === 'ar' ? 'رابط لقطة 3' : 'Screenshot 3 URL'} className="rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-white placeholder:text-[#7a8397]" />
                <input value={newGame.screenshots4} onChange={(event) => setNewGame((current) => ({ ...current, screenshots4: event.target.value }))} placeholder={launcherLanguage === 'ar' ? 'رابط لقطة 4' : 'Screenshot 4 URL'} className="rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-white placeholder:text-[#7a8397]" />
              </div>
              <input value={newGame.trailerUrl} onChange={(event) => setNewGame((current) => ({ ...current, trailerUrl: event.target.value }))} placeholder={launcherLanguage === 'ar' ? 'رابط الإعلان (YouTube embed أو رابط watch)' : 'Trailer URL (YouTube embed or watch link)'} className="rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-white placeholder:text-[#7a8397] lg:col-span-2" />
              <input value={newGame.developer} onChange={(event) => setNewGame((current) => ({ ...current, developer: event.target.value }))} placeholder={launcherLanguage === 'ar' ? 'المطور' : 'Developer'} className="rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-white placeholder:text-[#7a8397]" />
              <input value={newGame.publisher} onChange={(event) => setNewGame((current) => ({ ...current, publisher: event.target.value }))} placeholder={launcherLanguage === 'ar' ? 'الناشر' : 'Publisher'} className="rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-white placeholder:text-[#7a8397]" />
              <input value={newGame.releaseDate} onChange={(event) => setNewGame((current) => ({ ...current, releaseDate: event.target.value }))} placeholder={launcherLanguage === 'ar' ? 'تاريخ الإصدار (YYYY-MM-DD)' : 'Release Date (YYYY-MM-DD)'} className="rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-white placeholder:text-[#7a8397]" />
                      <div className="lg:col-span-2 flex gap-3">
                <input value={newGame.downloadUrl} onChange={(event) => setNewGame((current) => ({ ...current, downloadUrl: event.target.value }))} placeholder={launcherLanguage === 'ar' ? 'رابط التحميل (Google Drive / Firebase / رابط مباشر)' : 'Download URL (Google Drive / Firebase / direct link)'} className="flex-1 rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-white placeholder:text-[#7a8397]" />
                <button
                  type="button"
                  onClick={() => {
                    const url = newGame.downloadUrl.trim()
                    if (!url) {
                      setError('Please enter a download URL first.')
                      return
                    }

                    const directUrl = normalizeDownloadUrl(convertGoogleDriveShareUrl(url))
                    window.open(directUrl, '_blank', 'noopener,noreferrer')
                  }}
                  className="rounded-xl border border-[#2a3446] bg-[#101821] px-4 py-3 text-sm font-bold uppercase tracking-[0.12em] text-white"
                >
                  {launcherLanguage === 'ar' ? 'فتح الرابط' : 'Open Link'}
                </button>
                <button
                  type="button"
                  onClick={async () => {
                    const url = newGame.downloadUrl.trim()
                    if (!url) {
                      setError('Please enter a download URL first.')
                      return
                    }

                    try {
                      const result = await testDownloadUrl(url)
                      if (result.ok) {
                        setError('')
                        showNotification(result.message)
                        return
                      }

                      setError(result.message)
                    } catch {
                      setError('This download link is invalid or blocked by the server.')
                    }
                  }}
                  className="rounded-xl border border-[#FB1818] bg-[#120d15] px-4 py-3 text-sm font-bold uppercase tracking-[0.12em] text-white"
                >
                  {launcherLanguage === 'ar' ? 'اختبار الرابط' : 'Test Link'}
                </button>
              </div>
              <textarea value={newGame.description} onChange={(event) => setNewGame((current) => ({ ...current, description: event.target.value }))} placeholder={launcherLanguage === 'ar' ? 'الوصف' : 'Description'} className="min-h-[120px] rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-white placeholder:text-[#7a8397] lg:col-span-2" />
              <label className="lg:col-span-2 flex items-center gap-3 rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-sm text-[#dfe7f5]">
                <input
                  type="checkbox"
                  checked={newGame.sendNotify}
                  onChange={(event) => setNewGame((current) => ({ ...current, sendNotify: event.target.checked }))}
                  className="h-4 w-4 accent-[#FB1818]"
                />
                {launcherLanguage === 'ar' ? 'إرسال إشعار للمستخدمين' : 'Send notify to users'}
              </label>
              <textarea value={newGame.minimumRequirements} onChange={(event) => setNewGame((current) => ({ ...current, minimumRequirements: event.target.value }))} placeholder={launcherLanguage === 'ar' ? 'متطلبات الحد الأدنى' : 'Minimum requirements'} className="min-h-[120px] rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-white placeholder:text-[#7a8397] lg:col-span-1" />
              <textarea value={newGame.recommendedRequirements} onChange={(event) => setNewGame((current) => ({ ...current, recommendedRequirements: event.target.value }))} placeholder={launcherLanguage === 'ar' ? 'متطلبات الموصى بها' : 'Recommended requirements'} className="min-h-[120px] rounded-xl border border-[#212a38] bg-[#0d131b] px-4 py-3 text-white placeholder:text-[#7a8397] lg:col-span-1" />
              <div className="lg:col-span-2 flex gap-3">
                <button type="button" onClick={() => void handleAddGame()} className="flex-1 rounded-xl bg-[#FB1818] px-4 py-3 text-sm font-bold uppercase tracking-[0.12em] text-white">{editingGameId ? (launcherLanguage === 'ar' ? 'تحديث اللعبة' : 'Update Game') : (launcherLanguage === 'ar' ? 'حفظ اللعبة' : 'Save Game')}</button>
                <button type="button" onClick={() => {
                  resetGameForm()
                  setAdminMode('list')
                }} className="flex-1 rounded-xl border border-[#2a3446] bg-[#101821] px-4 py-3 text-sm font-bold uppercase tracking-[0.12em] text-white">{launcherLanguage === 'ar' ? 'إلغاء' : 'Cancel'}</button>
              </div>
            </div>
          ) : (
            <div className="space-y-4 rounded-[22px] border border-[#1d2330] bg-[#0b1018] p-5">
              {games.length === 0 ? (
                <div className="rounded-xl border border-dashed border-[#2a3345] bg-[#0b1018] p-8 text-center text-[#aab6c9]">
                  No games added yet.
                </div>
              ) : (
                games.map((game) => (
                  <div key={game.id} className="flex items-center justify-between gap-4 rounded-xl border border-[#1d2330] bg-[#111a23] p-3">
                    <div className="flex items-center gap-3">
                      <img src={game.image} alt={game.title} className="h-16 w-16 rounded-lg object-cover" />
                      <div>
                        <div className="text-lg font-bold text-white">{game.title}</div>
                        <div className="text-sm text-[#b0bfd5]">{game.genre}</div>
                      </div>
                    </div>
                    <div className="flex items-center gap-3">
                      <button
                        type="button"
                        onClick={async () => {
                          const nextValue = !game.hidden
                          try {
                            await updateDoc(doc(db, 'games', game.id), { hidden: nextValue })
                            setGames((current) => current.map((item) => item.id === game.id ? { ...item, hidden: nextValue } : item))
                          } catch {
                            setError('Could not update game visibility.')
                          }
                        }}
                        className={`rounded-lg px-3 py-2 text-xs font-bold uppercase tracking-[0.12em] ${game.hidden ? 'bg-[#353f4d] text-[#dfe7f5]' : 'bg-[#FB1818] text-white'}`}
                      >
                        {game.hidden ? (launcherLanguage === 'ar' ? 'مخفي' : 'Hidden') : (launcherLanguage === 'ar' ? 'مرئي' : 'Visible')}
                      </button>
                      <button
                        type="button"
                        onClick={() => {
                          setEditingGameId(game.id)
                          setNewGame({
                            title: game.title,
                            image: game.image,
                            genre: game.genre,
                            price: game.price,
                            description: game.description,
                            status: game.status,
                            downloadUrl: game.downloadUrl,
                            fileName: game.fileName,
                            size: game.size,
                            version: game.version,
                            platform: game.platform,
                            screenshots1: game.screenshots?.[0] ?? '',
                            screenshots2: game.screenshots?.[1] ?? '',
                            screenshots3: game.screenshots?.[2] ?? '',
                            screenshots4: game.screenshots?.[3] ?? '',
                            trailerUrl: game.trailerUrl ?? '',
                            developer: game.developer ?? 'Dreko Games',
                            publisher: game.publisher ?? 'Dreko Games',
                            releaseDate: game.releaseDate ?? '',
                            minimumRequirements: game.requirements?.minimum ?? '',
                            recommendedRequirements: game.requirements?.recommended ?? '',
                            sendNotify: true,
                          })
                          setAdminMode('add')
                          setError('')
                        }}
                        className="rounded-lg border border-[#2a3446] bg-[#101821] px-3 py-2 text-xs font-bold uppercase tracking-[0.12em] text-white"
                      >
                        {launcherLanguage === 'ar' ? 'تعديل' : 'Edit'}
                      </button>
                      <button
                        type="button"
                        onClick={async () => {
                          try {
                            await deleteDoc(doc(db, 'games', game.id))
                            setGames((current) => current.filter((item) => item.id !== game.id))
                          } catch {
                            setError('Could not delete game.')
                          }
                        }}
                        className="rounded-lg border border-red-500/40 bg-red-500/10 px-3 py-2 text-xs font-bold uppercase tracking-[0.12em] text-red-200"
                      >
                        {launcherLanguage === 'ar' ? 'حذف' : 'Delete'}
                      </button>
                    </div>
                  </div>
                ))
              )}
            </div>
          )}

          {error && <div className="rounded-lg border border-red-500/40 bg-red-500/10 px-3 py-2 text-sm text-red-200">{error}</div>}
        </div>
      )
    }

    return (
      <div className="space-y-6">
        <section className="featured-panel relative overflow-hidden rounded-[28px] border border-[#3d1717] bg-[#0d1015] p-5 shadow-[0_0_35px_rgba(251,24,24,0.1)]">
          <div className="absolute inset-0 opacity-90" style={{ background: 'radial-gradient(circle at 75% 50%, rgba(251,24,24,0.2), transparent 30%)' }} />
          <div className="absolute right-[-20px] top-[-20px] h-[390px] w-[430px] opacity-90">
            <div className="dragon-silhouette relative h-full w-full">
              <img src={drekoLogo} alt="dragon" className="h-full w-full object-contain opacity-85 drop-shadow-[0_0_20px_rgba(251,24,24,0.3)]" />
            </div>
          </div>

          <div className="relative z-10 max-w-[520px] pb-4 pt-3">
            <div className="mb-4 inline-flex rounded-md border border-[#FB1818] bg-[#1a0f11] px-3 py-1 text-[12px] font-black uppercase tracking-[0.24em] text-[#FB1818]">{launcherLanguage === 'ar' ? 'مميز' : 'Featured'}</div>
            <h1 className="wordmark text-[clamp(2.5rem,5vw,5.6rem)] font-black leading-[0.9] tracking-[-0.08em] text-[#f7f7f7]">
              DREKO
              <span className="text-[#FB1818]">GAMES</span>
            </h1>
            <div className="mt-3 text-[18px] font-semibold uppercase tracking-[0.55em] text-[#c8ced9] opacity-80">
              {launcherLanguage === 'ar' ? 'ألعابك • عالمك' : 'Your games • Your world'}
            </div>
            <button type="button" onClick={() => navigateWithProfileGuard('store')} className="mt-8 rounded-xl bg-[#FB1818] px-8 py-3 text-[18px] font-black uppercase tracking-[0.08em] text-white shadow-[0_0_26px_rgba(251,24,24,0.45)] transition hover:brightness-110">{launcherLanguage === 'ar' ? 'تصفح المتجر →' : 'Browse Store →'}</button>
          </div>
        </section>

        <section>
          <div className="mb-4 flex items-center justify-between">
            <h2 className="text-[28px] font-black tracking-[-0.05em] text-white">{launcherLanguage === 'ar' ? 'تم لعبها مؤخراً' : 'Recently Played'}</h2>
            <button type="button" onClick={() => navigateWithProfileGuard('library')} className="text-[13px] font-semibold uppercase tracking-[0.08em] text-[#FB1818]">{launcherLanguage === 'ar' ? 'عرض الكل →' : 'View All →'}</button>
          </div>
          <div className="flex flex-wrap items-start gap-4">
            {visibleGames.length > 0 ? (
              visibleGames.map((game) => (
                <article key={game.id} className="h-[430px] w-[240px] overflow-hidden rounded-[20px] border border-[#171d2b] bg-[#070c13]">
                  <div className="game-cover-wrap home-cover h-[320px]">
                    <img src={game.image} alt={game.title} className="game-cover" />
                  </div>
                  <div className="flex h-[110px] flex-col justify-between px-4 pb-4 pt-3">
                    <div className="truncate text-[13px] font-bold text-white">{game.title}</div>
                    <div className="mt-2 flex items-center gap-2 text-[12px] text-[#adb8c8]">
                      <span className="inline-block h-2 w-2 rounded-full bg-[#FB1818]" />
                      {game.status}
                    </div>
                  </div>
                </article>
              ))
            ) : (
              <div className="col-span-full rounded-[18px] border border-dashed border-[#2a3345] bg-[#0b1018] p-8 text-center text-[#aab6c9]">
                {launcherLanguage === 'ar' ? 'لا توجد ألعاب لعبتها بعد.' : 'No games you\'ve played yet.'}
              </div>
            )}
          </div>
        </section>
      </div>
    )
  }

  if (!user) {
    return (
      <div className="app-shell flex min-h-screen flex-col bg-[#020508] text-white" style={{ fontFamily: appFontFamily }}>
        {renderWindowBar()}
        <div className="flex flex-1 items-center justify-center p-6">
          <div className="w-full max-w-[460px] rounded-[28px] border border-[#FB1818] bg-[#080d15] p-7 shadow-[0_0_40px_rgba(251,24,24,0.2)]">
            <div className="mb-6 flex items-center justify-center">
              <img src={drekoLogo} alt="Dreko Games" className="h-20 w-20 object-contain" />
            </div>

            <div className="mb-6 text-center">
              <div className="text-3xl font-black tracking-tight text-[#f8f8f8]">DREKO</div>
              <div className="mt-2 text-sm uppercase tracking-[0.38em] text-[#FB1818]">GAMES</div>
            </div>

            <div className="mb-5 flex rounded-xl border border-[#1d2330] bg-[#0f141c] p-1">
              <button
                type="button"
                onClick={() => setAuthMode('login')}
                className={`flex-1 rounded-lg px-3 py-2 text-sm font-semibold ${authMode === 'login' ? 'bg-[#FB1818] text-white' : 'text-[#b9c1d0]'}`}
              >
                {launcherLanguage === 'ar' ? 'تسجيل الدخول' : 'Login'}
              </button>
              <button
                type="button"
                onClick={() => setAuthMode('register')}
                className={`flex-1 rounded-lg px-3 py-2 text-sm font-semibold ${authMode === 'register' ? 'bg-[#FB1818] text-white' : 'text-[#b9c1d0]'}`}
              >
                {launcherLanguage === 'ar' ? 'إنشاء حساب' : 'Create Account'}
              </button>
            </div>

            <div className="space-y-4">
              {authMode === 'register' && (
                <>
                  <input
                    value={displayName}
                    onChange={(event) => setDisplayName(event.target.value)}
                    placeholder={launcherLanguage === 'ar' ? 'اسم العرض' : 'Display name'}
                    className="w-full rounded-xl border border-[#212a38] bg-[#0b1119] px-4 py-3 text-white outline-none placeholder:text-[#7a8397]"
                  />

                  <select
                    value={authCountry}
                    onChange={(event) => setAuthCountry(event.target.value)}
                    className="w-full rounded-xl border border-[#212a38] bg-[#0b1119] px-4 py-3 text-white outline-none"
                  >
                    {countryOptions.map((country) => (
                      <option key={country} value={country}>{country}</option>
                    ))}
                  </select>
                </>
              )}

              <input
                type="email"
                value={authEmail}
                onChange={(event) => setAuthEmail(event.target.value)}
                placeholder={launcherLanguage === 'ar' ? 'البريد الإلكتروني' : 'Email address'}
                className="w-full rounded-xl border border-[#212a38] bg-[#0b1119] px-4 py-3 text-white outline-none placeholder:text-[#7a8397]"
              />

              <div className="relative">
                <input
                  type={showPassword ? 'text' : 'password'}
                  value={authPassword}
                  onChange={(event) => setAuthPassword(event.target.value)}
                  placeholder={launcherLanguage === 'ar' ? 'كلمة المرور' : 'Password'}
                  className="w-full rounded-xl border border-[#212a38] bg-[#0b1119] px-4 py-3 pr-12 text-white outline-none placeholder:text-[#7a8397]"
                />
                <button
                  type="button"
                  aria-label={showPassword ? (launcherLanguage === 'ar' ? 'إخفاء كلمة المرور' : 'Hide password') : (launcherLanguage === 'ar' ? 'إظهار كلمة المرور' : 'Show password')}
                  onClick={() => setShowPassword((value) => !value)}
                  className="absolute inset-y-0 right-3 flex items-center justify-center text-[#aab6c9] transition hover:text-white"
                >
                  <svg viewBox="0 0 24 24" className="h-5 w-5" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                    {showPassword ? (
                      <>
                        <path d="M3 3l18 18" />
                        <path d="M10.58 10.58A2 2 0 0013.42 13.42" />
                        <path d="M9.88 5.52A11.2 11.2 0 0112 5.25c4.5 0 8.4 2.7 10 6.75-.9 1.8-2.32 3.47-4.11 4.72" />
                        <path d="M6.17 6.17A11.83 11.83 0 002 12c1.6 4.05 5.5 6.75 10 6.75a11.64 11.64 0 005.16-1.12" />
                      </>
                    ) : (
                      <>
                        <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" />
                        <circle cx="12" cy="12" r="3" />
                      </>
                    )}
                  </svg>
                </button>
              </div>

              {error && <div className="rounded-lg border border-red-500/40 bg-red-500/10 px-3 py-2 text-sm text-red-200">{error}</div>}

              <button
                type="button"
                onClick={() => void handleAuth(authMode)}
                disabled={loading}
                className="w-full rounded-xl bg-[#FB1818] px-4 py-3 text-sm font-bold uppercase tracking-[0.12em] text-white shadow-[0_0_26px_rgba(251,24,24,0.4)] disabled:opacity-60"
              >
                {loading ? (launcherLanguage === 'ar' ? 'يرجى الانتظار...' : 'Please wait...') : authMode === 'login' ? (launcherLanguage === 'ar' ? 'تسجيل الدخول' : 'Login') : (launcherLanguage === 'ar' ? 'إنشاء حساب' : 'Create account')}
              </button>

              {showGoogleClientModal ? (
                <div className="space-y-3">
                  <input
                    value={googleClientIdInput}
                    onChange={(e) => setGoogleClientIdInput(e.target.value)}
                    placeholder="Client ID (xxxx.apps.googleusercontent.com)"
                    className="w-full rounded-xl border border-[#243241] bg-[#0b1119] px-3 py-2 text-white outline-none"
                  />
                  <input
                    value={googleClientSecretInput}
                    onChange={(e) => setGoogleClientSecretInput(e.target.value)}
                    placeholder="Client Secret (optional)"
                    className="w-full rounded-xl border border-[#243241] bg-[#0b1119] px-3 py-2 text-white outline-none"
                  />
                  <div className="flex justify-end gap-2">
                    <button type="button" onClick={() => setShowGoogleClientModal(false)} className="rounded-xl border border-[#2a3446] bg-[#101821] px-4 py-2 text-sm text-white">{launcherLanguage === 'ar' ? 'إلغاء' : 'Cancel'}</button>
                    <button type="button" onClick={() => void submitGoogleClientDetails(googleClientIdInput.trim(), googleClientSecretInput.trim(), true)} className="rounded-xl bg-[#FB1818] px-4 py-2 text-sm font-bold text-white">{launcherLanguage === 'ar' ? 'متابعة' : 'Continue'}</button>
                  </div>
                </div>
              ) : (
                <button
                  type="button"
                  onClick={() => void handleGoogleSignIn()}
                  disabled={loading}
                  className="flex w-full items-center justify-center gap-3 rounded-xl border border-[#2a3446] bg-[#0b1119] px-4 py-3 text-sm font-bold uppercase tracking-[0.12em] text-white transition hover:border-[#FB1818] disabled:opacity-60"
                >
                  <img src="/google-icon.svg" alt="Google" className="h-5 w-5 object-contain" />
                  {launcherLanguage === 'ar' ? 'تسجيل الدخول عبر جوجل' : 'Continue with Google'}
                </button>
              )}
            </div>
          </div>
        </div>
      </div>

    )
  }

  return (
      <div key={pageRefreshKey} className="flex h-screen flex-col overflow-hidden bg-[#020508] text-white" style={{ fontFamily: appFontFamily }}>
        {renderWindowBar()}
        <div className="flex min-h-0 flex-1 overflow-hidden">
          <aside className="relative w-[220px] min-w-[180px] border-r border-[#151c27] bg-[#0a0d11] px-3 py-5 xl:w-[240px] lg:w-[220px] md:w-[200px]">
          <div className="mb-8 flex flex-col items-center justify-center pt-2">
            <div className="flex h-[88px] w-[120px] items-center justify-center overflow-hidden rounded-[18px] bg-transparent">
              <img src={drekoLogo} alt="Dreko Games" className="h-full w-full object-contain" />
            </div>
            <div className="mt-3 text-center">
              <div className="text-[20px] font-black tracking-tight text-[#f6f6f6]">DREKO</div>
              <div className="mt-1 text-[10px] font-black uppercase tracking-[0.28em] text-[#FB1818]">GAMES</div>
            </div>
          </div>

          <nav className="space-y-2">
            {navItems.map((item) => {
              const mapped = navLookup[item.label]
              const isSelected = page === mapped
              return (
                <button
                  key={item.label}
                  type="button"
                  onClick={() => navigateWithProfileGuard(mapped)}
                  className={`flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-[15px] font-medium transition ${
                    isSelected ? 'bg-[#1d2430] text-white shadow-[inset_0_0_0_1px_rgba(255,255,255,0.06)]' : 'text-[#d5dce8] hover:bg-[#111827] hover:text-white'
                  }`}
                >
                  <img src={item.icon} alt={item.label} className="h-5 w-5 object-contain" />
                  <span>{localeText.nav[item.label as keyof typeof localeText.nav]}</span>
                </button>
              )
            })}

            {profile?.role === 'admin' && (
              <button
                type="button"
                onClick={() => {
                  if (page === 'admin') {
                    resetPageScopedState()
                    setPageRefreshKey((current) => current + 1)
                    setPage('admin')
                    return
                  }
                  setPage('admin')
                }}
                className={`mt-2 flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-[15px] font-medium transition ${page === 'admin' ? 'bg-[#1d2430] text-white shadow-[inset_0_0_0_1px_rgba(255,255,255,0.06)]' : 'text-[#d6d8de] hover:bg-[#111827] hover:text-white'}`}
              >
                <img src="/admin.svg" alt="Admin" className="h-5 w-5 object-contain" />
                <span>{localeText.adminLabel}</span>
              </button>
            )}
          </nav>
 
          <div className="mt-8">
            <div className="mb-3 text-[10px] font-semibold uppercase tracking-[0.35em] text-[#7c889c]">{localeText.quickLaunch}</div>
            <div className="space-y-3">
              {quickLaunchGames.length > 0 ? (
                quickLaunchGames.map((game) => (
                  <button
                    key={game.id}
                    type="button"
                    onClick={() => void handleOpenGame(game.id)}
                    className="flex w-full items-center gap-3 rounded-xl border border-[#1b2232] bg-[#101821] p-2 text-left text-[#edf2ff] transition hover:border-[#FB1818] hover:bg-[#141d2b]"
                  >
                    <img src={game.image} alt={game.title} className="h-8 w-8 rounded-md object-cover" />
                    <span className="truncate text-sm">{game.title}</span>
                  </button>
                ))
              ) : (
                <div className="rounded-xl border border-dashed border-[#2a3345] bg-[#0b1018] p-3 text-center text-[11px] text-[#8a98ac]">
                  {localeText.noDownloadedGames}
                </div>
              )}
            </div>
          </div>

          <div className="mt-auto pt-8" />
        </aside>

        <main className="flex-1 overflow-y-auto bg-[#070b10] p-5">
          {toastMessage && (
            <div className="mb-4 rounded-xl border border-[#1d2330] bg-[#121b29] px-4 py-3 text-sm text-[#e6edf9] shadow-[0_10px_24px_rgba(0,0,0,0.35)]">
              {toastMessage}
            </div>
          )}

          <header className="mb-5 flex items-center justify-between gap-4">
            <div className="flex-1" />

            <div className="flex items-center gap-4">
              <button
                type="button"
                onClick={() => setShowNotificationsPanel((value) => !value)}
                className="relative flex h-10 w-10 items-center justify-center rounded-full bg-[#111b27] p-2 text-lg text-[#d5d9e3]"
                aria-label="Open notifications"
              >
                <img src="/notifications.svg" alt="Notifications" className="h-5 w-5 object-contain" />
                {notifications.some((item) => !item.read) && (
                  <span className="absolute -right-1 -top-1 flex h-5 min-w-5 items-center justify-center rounded-full bg-[#FB1818] px-1 text-[10px] font-bold text-white">
                    {notifications.filter((item) => !item.read).length}
                  </span>
                )}
              </button>
              <button
                type="button"
                onClick={() => setShowCartPanel((value) => !value)}
                className="relative flex h-10 w-10 items-center justify-center rounded-full bg-[#111b27] p-2 text-lg text-[#d5d9e3]"
                aria-label="Open cart"
              >
                <img src="/cart.svg" alt="Cart" className="h-5 w-5 object-contain" />
                {cartGameIds.length > 0 && (
                  <span className="absolute -right-1 -top-1 flex h-5 min-w-5 items-center justify-center rounded-full bg-[#FB1818] px-1 text-[10px] font-bold text-white">
                    {cartGameIds.length}
                  </span>
                )}
              </button>
              <button
                type="button"
                onClick={() => setShowWishlistPanel((value) => !value)}
                className="flex h-10 w-10 items-center justify-center rounded-full border border-[#FB1818] bg-[#1a0e12] p-2 text-lg text-[#ffb3b3] shadow-[0_0_0_2px_rgba(251,24,24,0.2)]"
                aria-label="Open wishlist"
              >
                <img src="/wishlist.svg" alt="Wishlist" className="h-5 w-5 object-contain" />
              </button>
              <div className="relative">
                <button
                  type="button"
                  onClick={() => {
                    setShowCartPanel(false)
                    setShowWishlistPanel(false)
                    setShowNotificationsPanel(false)
                    setShowAccountMenu((value) => !value)
                  }}
                  className="flex items-center gap-3 rounded-full border border-[#1b2232] bg-[#0d1118] px-2 py-1 text-left transition hover:border-[#2d3d52]"
                >
                  <div className="flex h-8 w-8 items-center justify-center overflow-hidden rounded-full bg-gradient-to-br from-[#ffb1b1] to-[#8d3232] font-bold text-[#0c0c10]">
                    {profile?.avatarUrl ? <img src={profile.avatarUrl} alt={profile.displayName || 'Profile'} className="h-full w-full object-cover" /> : (profile?.displayName?.slice(0, 1).toUpperCase() || 'D')}
                  </div>
                  <span className="pr-2 text-[14px] font-semibold text-[#ebedf3]">{profile?.displayName || 'Dreko User'}</span>
                </button>

                {showAccountMenu && (
                  <div className="absolute right-0 top-[calc(100%+10px)] z-30 w-56 overflow-hidden rounded-[16px] border border-[#1d2330] bg-[#0b1018] p-2 shadow-[0_20px_40px_rgba(0,0,0,0.45)]">
                    <button
                      type="button"
                      onClick={() => {
                        setShowAccountMenu(false)
                        setViewProfileUid(null)
                        setViewProfileData(null)
                        setFullProfileUid(null)
                        setPage('profile')
                        setActiveProfileTab('profile')
                      }}
                      className="flex w-full items-center justify-between rounded-xl px-3 py-2 text-left text-sm font-medium text-[#edf3ff] transition hover:bg-[#121d2a]"
                    >
                      <span>{launcherLanguage === 'ar' ? 'إعدادات الحساب' : 'Account Settings'}</span>
                      <img src="/settings.svg" alt="Settings" className="h-4 w-4 object-contain" />
                    </button>
                    <button
                      type="button"
                      onClick={() => {
                        setShowAccountMenu(false)
                        void handleLogout()
                      }}
                      className="mt-2 flex w-full items-center justify-between rounded-xl bg-[#1b0f14] px-3 py-2 text-left text-sm font-medium text-[#ffb3b3] transition hover:bg-[#261519]"
                    >
                      <span>{launcherLanguage === 'ar' ? 'تسجيل الخروج' : 'Logout'}</span>
                      <img src="/logout.svg" alt="Logout" className="h-4 w-4 object-contain" />
                    </button>
                  </div>
                )}
              </div>
            </div>
          </header>

          <div className="mb-4 flex items-center justify-between rounded-xl border border-[#1b2332] bg-[#0a0f17] px-4 py-3 text-sm text-[#dfe4ef]">
            <span className="uppercase tracking-[0.2em] text-[#7ea2ff]">{pageTitles[page]}</span>
            <span className="text-[#a4afbf]">{profile?.role === 'admin' ? localeText.adminMode : localeText.playerMode}</span>
          </div>

          <div className="relative">
            {(showCartPanel || showWishlistPanel || showNotificationsPanel || showAccountMenu) && (
              <button
                type="button"
                aria-label="Close panels"
                onClick={() => {
                  setShowCartPanel(false)
                  setShowWishlistPanel(false)
                  setShowNotificationsPanel(false)
                  setShowAccountMenu(false)
                }}
                className="fixed inset-0 z-10 bg-transparent"
              />
            )}

            {showNotificationsPanel && (
              <div className="absolute right-0 top-0 z-20 w-[360px] rounded-[18px] border border-[#1d2330] bg-[#090d14] p-4 shadow-[0_25px_60px_rgba(0,0,0,0.45)]">
                <div className="mb-4 flex items-center justify-between">
                  <h3 className="text-[18px] font-semibold text-white">Notifications</h3>
                  <div className="flex items-center gap-2">
                    <button type="button" onClick={() => void clearNotifications()} className="text-[11px] font-bold uppercase tracking-[0.12em] text-[#FB1818]">Clear</button>
                    <button type="button" onClick={() => setShowNotificationsPanel(false)} className="text-2xl leading-none text-[#b8c2d3] hover:text-white">×</button>
                  </div>
                </div>

                <div className="max-h-[420px] space-y-3 overflow-auto">
                  {notifications.length === 0 ? (
                    <div className="rounded-xl border border-dashed border-[#2a3345] bg-[#0b1017] px-3 py-5 text-center text-sm text-[#aab6c9]">No notifications yet.</div>
                  ) : (
                    notifications.map((notification) => (
                      <button
                        key={notification.id}
                        type="button"
                        onClick={async () => {
                          await markNotificationRead(notification.id)
                          setShowNotificationsPanel(false)
                          if (notification.type === 'friend_request' && notification.friendUid) {
                            setPage('profile')
                            setCommunityTab('pending')
                            setViewProfileUid(notification.friendUid)
                            void handleViewProfile(notification.friendUid)
                          }
                        }}
                        className={`flex w-full items-start gap-3 rounded-xl border px-3 py-3 text-left transition ${notification.read ? 'border-[#1b2232] bg-[#0b1017]' : 'border-[#FB1818]/40 bg-[#15141d]'}`}
                      >
                        <div className="flex h-11 w-11 items-center justify-center overflow-hidden rounded-full border border-[#2a3446] bg-[#0d1118]">
                          {(notification.avatarUrl || notification.imageUrl) ? <img src={notification.avatarUrl || notification.imageUrl} alt={notification.friendName || notification.title} className="h-full w-full object-cover" /> : <span className="text-xs font-bold text-white">{(notification.friendName || notification.title || 'N').slice(0, 1).toUpperCase()}</span>}
                        </div>
                        <div className="min-w-0 flex-1">
                          <div className="mb-1 flex items-center justify-between gap-2">
                            <span className="truncate text-sm font-semibold text-white">{notification.title}</span>
                            {!notification.read && <span className="h-2.5 w-2.5 rounded-full bg-[#FB1818]" />}
                          </div>
                          <div className="text-xs text-[#dfe6f3]">{notification.message}</div>
                          {notification.imageUrl && (
                            <img src={notification.imageUrl} alt={notification.title} className="mt-2 h-16 w-full rounded-lg object-cover" />
                          )}
                        </div>
                      </button>
                    ))
                  )}
                </div>
              </div>
            )}

            {installModalGame && (
              <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/70 px-4">
                <div className="w-full max-w-[820px] rounded-[28px] border border-[#2a3446] bg-[#171d27] p-5 text-white shadow-[0_20px_60px_rgba(0,0,0,0.65)]">
                  <div className="mb-5 flex items-center justify-between">
                    <div className="text-[15px] font-semibold uppercase tracking-[0.12em] text-[#aeb7c6]">{launcherLanguage === 'ar' ? 'تثبيت' : 'Install'}</div>
                    <button type="button" onClick={() => setInstallModalGame(null)} className="text-2xl text-[#c8d0dd] hover:text-white">×</button>
                  </div>

                  {downloadingId === installModalGame!.id && (
                    <div className="mb-5 space-y-3 rounded-[18px] border border-[#2a3446] bg-[#1a2330] p-3">
                      <div className="flex items-center justify-between text-[11px] uppercase tracking-[0.18em] text-[#a8b7d1]">
                        <span>{launcherLanguage === 'ar' ? 'جارٍ التنزيل' : 'Downloading'}</span>
                        <span>{Math.round(downloadProgress.percent || 0)}%</span>
                      </div>
                      <div className="h-2 overflow-hidden rounded-full bg-[#111924]">
                        <div className="h-full rounded-full bg-gradient-to-r from-[#FB1818] to-[#ff8a8a] transition-[width] duration-200" style={{ width: `${Math.min(100, Math.max(0, downloadProgress.percent || 0))}%` }} />
                      </div>
                      <div className="flex items-center justify-between text-[12px] text-[#dfe7f4]">
                        <span>{formatBytes(downloadProgress.downloaded)} / {formatBytes(downloadProgress.total)}</span>
                        <span>{formatDuration(downloadProgress.eta)}</span>
                      </div>
                    </div>
                  )}

                  <div className="mb-5 flex items-center justify-between rounded-[18px] border border-[#2a3446] bg-[#202936] p-3">
                    <div className="flex items-center gap-4">
                      <img src={installModalGame!.image} alt={installModalGame!.title} className="h-20 w-20 rounded-lg object-cover object-center" />
                      <div>
                        <div className="text-[11px] uppercase tracking-[0.2em] text-[#8fa0b8]">{launcherLanguage === 'ar' ? 'حجم التنزيل' : 'Download size'}</div>
                        <div className="mt-1 text-[13px] text-[#eef3ff]">{installModalGame!.size}</div>
                      </div>
                    </div>
                    <div className="text-right text-xs uppercase tracking-[0.2em] text-[#9aa7bc]">
                      <div>{launcherLanguage === 'ar' ? 'مثبت' : 'Installed'}</div>
                      <div className="mt-1 text-sm font-semibold text-[#ecf2ff]">{installModalGame!.version}</div>
                    </div>
                  </div>

                  <div className="mb-4 text-[24px] font-black text-white">{launcherLanguage === 'ar' ? 'اختر مكان التثبيت' : 'Choose Install Location'}</div>

                  <div className="mb-4 flex items-center gap-3 rounded-xl border border-[#2a3446] bg-[#1a202b] p-3">
                    <span className="inline-flex h-10 w-10 items-center justify-center rounded-md bg-[#2b3344] text-lg">📁</span>
                    <div className="flex-1 text-sm text-[#cdd6ea]">{installFolder || 'C:\\Program Files\\Dreko Games'}</div>
                    <button type="button" onClick={() => void handleChooseInstallFolder()} className="rounded-md border border-[#3a465d] bg-[#1d2432] px-3 py-2 text-sm font-semibold text-white">{launcherLanguage === 'ar' ? 'استعراض' : 'Browse'}</button>
                  </div>

                  <div className="space-y-3">
                    <label className="flex items-center gap-3 text-sm text-[#edf3ff]">
                      <input type="checkbox" checked={createShortcut} onChange={() => setCreateShortcut((value) => !value)} className="h-4 w-4 accent-[#60a5fa]" />
                      {launcherLanguage === 'ar' ? 'إنشاء اختصار' : 'Create shortcut'}
                    </label>
                    <label className="flex items-center gap-3 text-sm text-[#edf3ff]">
                      <input type="checkbox" defaultChecked className="h-4 w-4 accent-[#60a5fa]" />
                      {launcherLanguage === 'ar' ? 'تحديث الألعاب تلقائيًا إلى هذا المجلد' : 'Auto-update games to this folder'}
                    </label>
                  </div>

                  <div className="mt-6 flex items-center justify-between gap-4">
                    <button type="button" onClick={() => {
                      if (downloadingId === installModalGame!.id) {
                        void handleCancelDownload(installModalGame!.id)
                        return
                      }
                      setInstallModalGame(null)
                    }} className="flex-1 rounded-xl border border-[#2a3446] bg-[#1a202b] px-4 py-3 text-base font-semibold text-white">
                      {downloadingId === installModalGame!.id ? (launcherLanguage === 'ar' ? 'إيقاف' : 'Stop') : (launcherLanguage === 'ar' ? 'إغلاق' : 'Close')}
                    </button>
                    {installedGameIds.includes(installModalGame!.id) ? (
                      <button type="button" onClick={() => void handleOpenGame(installModalGame!.id)} className="flex-1 rounded-xl bg-[#2ecc71] px-4 py-3 text-base font-bold text-[#08131b]">{launcherLanguage === 'ar' ? 'لعب' : 'Play'}</button>
                    ) : (
                      <button
                        type="button"
                        onClick={() => void handleDownloadGame(installModalGame!)}
                        disabled={isGameDownloadLocked(installModalGame!.id) || installedGameIds.includes(installModalGame!.id)}
                        className="flex-1 rounded-xl bg-[#FB1818] px-4 py-3 text-base font-bold text-[#140b0b] disabled:opacity-70"
                      >
                        {isGameDownloadLocked(installModalGame!.id) ? (launcherLanguage === 'ar' ? 'جارٍ التثبيت...' : 'Downloading...') : (launcherLanguage === 'ar' ? 'تثبيت' : 'Install')}
                      </button>
                    )}
                  </div>
                </div>
              </div>
            )}

            <div className="space-y-6">{renderMainView()}</div>

            {mediaViewer && (
              <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/80 p-4" onClick={() => setMediaViewer(null)}>
                <div className="relative w-full max-w-5xl overflow-hidden rounded-[22px] border border-[#2a3446] bg-[#0c1118] shadow-[0_20px_60px_rgba(0,0,0,0.7)]" onClick={(event) => event.stopPropagation()}>
                  <button
                    type="button"
                    onClick={() => setMediaViewer(null)}
                    className="absolute right-3 top-3 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-black/50 text-xl text-white transition hover:bg-black/70"
                  >
                    ×
                  </button>

                  {mediaViewer.type === 'trailer' ? (
                    <div className="aspect-video">
                      <iframe
                        src={mediaViewer.url}
                        title={mediaViewer.title}
                        className="h-full w-full"
                        allow="autoplay; encrypted-media; picture-in-picture"
                        allowFullScreen
                      />
                    </div>
                  ) : (
                    <img src={mediaViewer.url} alt={mediaViewer.title} className="max-h-[80vh] w-full object-contain" />
                  )}
                </div>
              </div>
            )}

            {!viewProfileUid && !fullProfileUid && pendingProfileImageEdits && (
              <div className="fixed bottom-5 right-5 z-50 flex items-center gap-3 rounded-2xl border border-[#2b313b] bg-[#111923] px-4 py-3 shadow-[0_20px_45px_rgba(0,0,0,0.45)]">
                <div className="text-sm text-[#dfe8f8]">{launcherLanguage === 'ar' ? 'لا تنسَ حفظ التغييرات!' : "Don't forget to save your changes!"}</div>
                <button type="button" onClick={handleResetProfileImageChanges} className="rounded-lg border border-[#3a465d] bg-[#161f2b] px-3 py-2 text-[10px] font-bold uppercase tracking-[0.18em] text-[#dfe8f8]">{launcherLanguage === 'ar' ? 'إعادة' : 'Reset'}</button>
                <button type="button" onClick={() => void handleSaveProfileImageChanges()} className="rounded-lg bg-[#FB1818] px-3 py-2 text-[10px] font-bold uppercase tracking-[0.18em] text-white">{launcherLanguage === 'ar' ? 'حفظ' : 'Save'}</button>
              </div>
            )}

            {showCartPanel && (
              <div className="absolute right-0 top-0 z-20 w-[320px] rounded-[18px] border border-[#1d2330] bg-[#090d14] p-4 shadow-[0_25px_60px_rgba(0,0,0,0.45)]">
                <div className="mb-4 flex items-center justify-between">
                  <h3 className="text-[18px] font-semibold text-white">{launcherLanguage === 'ar' ? 'السلة' : 'Cart'}</h3>
                  <button type="button" onClick={() => setShowCartPanel(false)} className="text-2xl leading-none text-[#b8c2d3] hover:text-white">×</button>
                </div>

                <div className="space-y-3">
                  {cartGames.length > 0 ? (
                    cartGames.map((game) => (
                      <div
                        key={game.id}
                        className="flex items-center gap-2 rounded-xl border border-[#1b2232] bg-[#0b1017] px-3 py-2"
                      >
                        <button
                          type="button"
                          onClick={() => {
                            setSelectedGame(game)
                            setShowCartPanel(false)
                          }}
                          className="flex flex-1 items-center justify-between gap-3 text-left"
                        >
                          <div className="flex items-center gap-3">
                            <img src={game.image} alt={game.title} className="h-10 w-10 rounded-md object-cover" />
                            <div>
                              <div className="text-sm font-medium text-[#edf4ff]">{game.title}</div>
                              <div className="text-[11px] text-[#9aa5b5]">{game.price}</div>
                            </div>
                          </div>
                          <span className="text-lg text-[#ffb3b3]">🛒</span>
                        </button>

                        <button
                          type="button"
                          aria-label={`Remove ${game.title} from cart`}
                          onClick={(event) => {
                            event.stopPropagation()
                            toggleCartGame(game.id)
                          }}
                          className="flex h-8 w-8 items-center justify-center rounded-full bg-[#FB1818] text-lg font-bold text-white transition hover:bg-[#ff5a5a]"
                        >
                          ×
                        </button>
                      </div>
                    ))
                  ) : (
                    <div className="rounded-xl border border-dashed border-[#2a3345] bg-[#0b1017] px-3 py-5 text-center text-sm text-[#aab6c9]">
                      {launcherLanguage === 'ar' ? 'السلة فارغة.' : 'Your cart is empty.'}
                    </div>
                  )}
                </div>
              </div>
            )}

            {showWishlistPanel && (
              <div className="absolute right-0 top-0 z-20 w-[320px] rounded-[18px] border border-[#2a1830] bg-[#090d14] p-4 shadow-[0_25px_60px_rgba(0,0,0,0.45)]">
                <div className="mb-4 flex items-center justify-between">
                  <h3 className="text-[18px] font-semibold text-white">{launcherLanguage === 'ar' ? 'قائمة الرغبات' : 'Wishlist'}</h3>
                  <button type="button" onClick={() => setShowWishlistPanel(false)} className="text-2xl leading-none text-[#b8c2d3] hover:text-white">×</button>
                </div>

                <div className="space-y-3">
                  {wishlistGames.length > 0 ? (
                    wishlistGames.map((game) => (
                      <button
                        key={game.id}
                        type="button"
                        onClick={() => {
                          setSelectedGame(game)
                          setShowWishlistPanel(false)
                        }}
                        className="flex w-full items-center justify-between gap-3 rounded-xl border border-[#1b2232] bg-[#0b1017] px-3 py-2 text-left"
                      >
                        <div className="flex items-center gap-3">
                          <img src={game.image} alt={game.title} className="h-10 w-10 rounded-md object-cover" />
                          <div>
                            <div className="text-sm font-medium text-[#edf4ff]">{game.title}</div>
                            <div className="text-[11px] text-[#9aa5b5]">{game.genre}</div>
                          </div>
                        </div>
                        <span className="text-lg text-[#ffb3b3]">♥</span>
                      </button>
                    ))
                  ) : (
                    <div className="rounded-xl border border-dashed border-[#2a3345] bg-[#0b1017] px-3 py-5 text-center text-sm text-[#aab6c9]">
                      {launcherLanguage === 'ar' ? 'لا توجد ألعاب في قائمة الرغبات بعد.' : 'No games in wishlist yet.'}
                    </div>
                  )}
                </div>
              </div>
            )}


            {activeChatId && (
              <div className="absolute right-0 top-40 z-30 w-[360px] rounded-[12px] border border-[#1b2232] bg-[#071018] p-3 shadow-[0_25px_60px_rgba(0,0,0,0.45)]">
                <div className="mb-2 flex items-center justify-between">
                  <h3 className="text-[16px] font-semibold text-white">{launcherLanguage === 'ar' ? 'الدردشة' : 'Chat'}</h3>
                  <button type="button" onClick={() => { try { chatUnsubRef.current && chatUnsubRef.current() } catch {} setActiveChatId(null); setChatMessages([]) }} className="text-sm text-[#b8c2d3]">{launcherLanguage === 'ar' ? 'إغلاق' : 'Close'}</button>
                </div>

                <div className="mb-2 max-h-[260px] overflow-auto space-y-2 px-1">
                  {chatMessages.length === 0 ? (
                    <div className="text-sm text-[#9aa5b5]">{launcherLanguage === 'ar' ? 'لا توجد رسائل بعد.' : 'No messages yet.'}</div>
                  ) : (
                    chatMessages.map((m) => (
                      <div key={m.id} className={`rounded-md px-3 py-2 ${m.from === user?.uid ? 'bg-[#14324a] text-white ml-auto' : 'bg-[#0b1017] text-[#d9e6f2] mr-auto'}`}>
                        <div className="text-xs text-[#9aa5b5]">{m.from === user?.uid ? (launcherLanguage === 'ar' ? 'أنت' : 'You') : m.from}</div>
                        <div className="text-sm">{m.text}</div>
                      </div>
                    ))
                  )}
                </div>

                <form onSubmit={(e) => { e.preventDefault(); if (!activeChatId) return; if (!chatInput.trim()) return; handleSendChatMessage(activeChatId, chatInput.trim()); setChatInput('') }} className="flex gap-2">
                  <input value={chatInput} onChange={(e) => setChatInput(e.target.value)} placeholder={launcherLanguage === 'ar' ? 'اكتب رسالة...' : 'Type a message...'} className="flex-1 rounded-md border border-[#1b2232] bg-[#061017] px-3 py-2 text-sm text-white" />
                  <button type="submit" className="rounded-md bg-[#1b6cff] px-3 py-2 text-sm text-white">{launcherLanguage === 'ar' ? 'إرسال' : 'Send'}</button>
                </form>
              </div>
            )}

            {showEditProfile && (
              <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/70 px-4">
                <div className="w-full max-w-[620px] rounded-[28px] border border-[#1d2330] bg-[#0b1018] p-6">
                  <div className="mb-5 flex items-center justify-between">
                    <div className="text-[20px] font-black tracking-[-0.04em] text-white">{launcherLanguage === 'ar' ? 'تعديل الملف الشخصي' : 'Edit Profile'}</div>
                    <button type="button" onClick={() => setShowEditProfile(false)} className="text-2xl text-[#dfe6f5]">×</button>
                  </div>

                  <div className="space-y-4 rounded-[20px] border border-[#1d2330] bg-[#0d141d] p-4">
                    <div>
                      <label className="mb-1 block text-[11px] font-bold uppercase tracking-[0.2em] text-[#8ea0bb]">{launcherLanguage === 'ar' ? 'اسم العرض' : 'Display Name'}</label>
                      <input value={profileDraft.displayName} onChange={(event) => setProfileDraft((current) => ({ ...current, displayName: event.target.value }))} className="w-full rounded-xl border border-[#2a3446] bg-[#101821] px-3 py-2.5 text-white" />
                    </div>

                    <div>
                      <label className="mb-1 block text-[11px] font-bold uppercase tracking-[0.2em] text-[#8ea0bb]">{launcherLanguage === 'ar' ? 'السيرة' : 'Bio'}</label>
                      <textarea value={profileDraft.bio} onChange={(event) => setProfileDraft((current) => ({ ...current, bio: event.target.value }))} rows={4} className="w-full rounded-xl border border-[#2a3446] bg-[#101821] px-3 py-2.5 text-white" />
                    </div>

                    <div className="grid gap-4 md:grid-cols-2">
                      <div>
                        <label className="mb-1 block text-[11px] font-bold uppercase tracking-[0.2em] text-[#8ea0bb]">{launcherLanguage === 'ar' ? 'الدولة' : 'Country'}</label>
                        <select value={profileDraft.country} onChange={(event) => setProfileDraft((current) => ({ ...current, country: event.target.value }))} className="w-full rounded-xl border border-[#2a3446] bg-[#101821] px-3 py-2.5 text-white">
                          {countryOptions.map((country) => (
                            <option key={country} value={country}>{country}</option>
                          ))}
                        </select>
                      </div>

                      <div>
                        <label className="mb-1 block text-[11px] font-bold uppercase tracking-[0.2em] text-[#8ea0bb]">{launcherLanguage === 'ar' ? 'المدينة' : 'City'}</label>
                        <input value={profileDraft.city} onChange={(event) => setProfileDraft((current) => ({ ...current, city: event.target.value }))} placeholder={launcherLanguage === 'ar' ? 'اكتب مدينتك' : 'Enter your city'} className="w-full rounded-xl border border-[#2a3446] bg-[#101821] px-3 py-2.5 text-white placeholder:text-[#7d8ca5]" />
                      </div>
                    </div>

                   <button type="button" onClick={() => void handleSaveProfile()} className="w-full rounded-xl bg-[#FB1818] px-4 py-3 text-sm font-bold uppercase tracking-[0.12em] text-white">{launcherLanguage === 'ar' ? 'حفظ تفاصيل الحساب' : 'Save Account Details'}</button>
                  </div>
                </div>
              </div>
            )}
          </div>
        </main>
        </div>
      </div>
    )
  }

export default App
