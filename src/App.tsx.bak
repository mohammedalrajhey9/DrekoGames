          onClick={() => void handleWindowAction('minimize')}
          className="m-0 box-border flex h-10 w-10 appearance-none items-center justify-center rounded-[2px] border border-transparent bg-transparent p-0 text-[13px] leading-none text-[#edf3ff] opacity-90 transition-all duration-100 ease-out hover:bg-[#2b3644] hover:opacity-100 focus:outline-none"
          style={{ transform: 'none', position: 'relative', top: 0 }}
        >
          −
        </button>
        <button
          type="button"
          aria-label="Maximize"
          onClick={() => void handleWindowAction('maximize')}
          className="m-0 box-border flex h-10 w-10 appearance-none items-center justify-center rounded-[2px] border border-transparent bg-transparent p-0 text-[12px] leading-none text-[#edf3ff] opacity-90 transition-all duration-100 ease-out hover:bg-[#2b3644] hover:opacity-100 focus:outline-none"
          style={{ transform: 'none', position: 'relative', top: 0 }}
        >
          □
        </button>
        <button
          type="button"
          aria-label="Close"
          onClick={() => void handleWindowAction('close')}
          className="m-0 box-border flex h-10 w-10 appearance-none items-center justify-center rounded-[2px] border border-transparent bg-transparent p-0 text-[15px] leading-none text-[#f7c9cc] opacity-90 transition-all duration-100 ease-out hover:bg-[#FB1818] hover:text-white hover:opacity-100 focus:outline-none"
          style={{ transform: 'none', position: 'relative', top: 0 }}
        >
          ×
        </button>
      </div>
    </div>
  )

