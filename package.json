{
  "name": "drekogames-launcher",
  "private": true,
  "version": "1.0.2",
  "description": "Dreko Games Launcher - desktop game hub and installer",
  "author": {
    "name": "Dreko Games",
    "email": "support@drekogames.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4316 --strictPort",
    "emulator:start": "npx firebase emulators:start --only firestore,database,auth --project dreko-games",
    "emulator:stop": "npx firebase emulators:stop || true",
    "reindex:users": "node scripts/reindexDisplayName.cjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0 --port 4317 --strictPort",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:4316 && electron . --disable-gpu --no-sandbox --dev\"",
    "electron:dev:emulators": "concurrently \"npm run dev\" \"npm run emulator:start\" \"wait-on http://localhost:4316 http://localhost:19099 && electron . --disable-gpu --no-sandbox --dev\"",
    "electron:build": "npm run build && electron .",
    "electron:package": "npm run build && electron-builder --win --publish never",
    "electron:release": "npm run build && electron-builder --win --publish always",
    "release:github": "npm run build && electron-builder --win --publish always",
    "installer:build": "npm run electron:package"
  },
  "build": {
    "appId": "com.drekogames.launcher",
    "productName": "Dreko Games Launcher",
    "copyright": "Copyright © 2026 Dreko Games",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "src/assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/assets/icon.ico",
      "artifactName": "Dreko Games Launcher Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "mohammedalrajhey9",
      "repo": "DrekoGames",
      "releaseType": "release",
      "private": false,
      "vPrefixedTagName": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "firebase": "^12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}
